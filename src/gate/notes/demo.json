{"version":1,"subject":{"id":"demo","title":"Pipeline demo","order":999,"icon":"binary","color":"syntax-function","description":"A one-lesson sample that exercises every notes block, the viz engine and the PYQ and practice embeds. Staff only.","hidden":true,"exam":["CSE"]},"chapters":[{"id":"01-number-systems","n":1,"title":"Number systems","summary":"How a string of digits turns into a value, in any base.","lessons":["place-value"]}],"lessons":{"place-value":{"id":"place-value","subject":"demo","chapter":"01-number-systems","title":"Place value and changing bases","order":1,"est_minutes":12,"difficulty":"basic","status":"published","updated":"2026-10-16","prerequisites":[],"pyq_topics":["dl/number"],"outline":[{"id":"the-big-idea","text":"The big idea","level":2},{"id":"reading-a-number-in-any-base","text":"Reading a number in any base","level":2},{"id":"why-every-number-has-one-spelling","text":"Why every number has one spelling","level":2},{"id":"practice","text":"Practice","level":2}],"blocks":[{"id":"intuition-1","name":"intuition","depth":"standard"},{"id":"place-value-def","name":"definition","depth":"standard"},{"id":"aside-1","name":"aside","depth":"standard"},{"id":"expansion","name":"derivation","depth":"standard"},{"id":"viz-1","name":"viz","depth":"standard"},{"id":"step-1","name":"step","depth":"standard"},{"id":"step-2","name":"step","depth":"standard"},{"id":"step-3","name":"step","depth":"standard"},{"id":"answer-1","name":"answer","depth":"standard"},{"id":"example-1","name":"example","depth":"standard"},{"id":"step-4","name":"step","depth":"standard"},{"id":"step-5","name":"step","depth":"standard"},{"id":"step-6","name":"step","depth":"standard"},{"id":"answer-2","name":"answer","depth":"standard"},{"id":"example-2","name":"example","depth":"standard"},{"id":"step-7","name":"step","depth":"standard"},{"id":"step-8","name":"step","depth":"standard"},{"id":"step-9","name":"step","depth":"standard"},{"id":"answer-3","name":"answer","depth":"standard"},{"id":"example-3","name":"example","depth":"standard"},{"id":"theorem-1","name":"theorem","depth":"standard"},{"id":"proof-1","name":"proof","depth":"standard"},{"id":"answer-4","name":"answer","depth":"standard"},{"id":"quick-check","name":"check","depth":"standard"},{"id":"trick-1","name":"trick","depth":"standard"},{"id":"trap-1","name":"trap","depth":"standard"},{"id":"table-1","name":"table","depth":"standard"},{"id":"pyq-cse-2023-cs-22","name":"pyq","depth":"standard"},{"id":"practice-nx-demo-01-01-q01","name":"practice","depth":"standard"},{"id":"viz-2","name":"viz","depth":"standard"},{"id":"note-1","name":"note","depth":"deep"},{"id":"summary-1","name":"summary","depth":"standard"}],"pyqs":["cse-2023-cs-22"],"practice":["nx-demo-01-01-q01"],"viz":["binary-place-values"],"body":[{"t":"p","c":["A digit's value depends on ",{"t":"strong","c":["where"]}," it sits. That one idea, ",{"t":"key","c":["place value"]},", is all you need to read a\nnumber written in any base."]},{"t":"h","d":2,"id":"the-big-idea","c":["The big idea"]},{"t":"block","name":"intuition","id":"intuition-1","depth":"standard","attrs":{"title":"Think in bundles"},"c":[{"t":"p","c":["Pay ₹347 with notes and coins: 3 hundred-rupee notes, 4 tens, 7 ones. The digit says ",{"t":"em","c":["how many"]},";\nthe position says ",{"t":"em","c":["of what size"]},". Base 2 works the same way, only the bundles are 1, 2, 4, 8, … instead\nof 1, 10, 100."]}],"line":22},{"t":"block","name":"definition","id":"place-value-def","depth":"standard","attrs":{"term":"Place value"},"c":[{"t":"p","c":["In base ",{"t":"im","v":"b"},", the digit in position ",{"t":"im","v":"i"}," (counting from ",{"t":"im","v":"0"}," on the right) is worth ",{"t":"im","v":"d_i \\cdot b^{\\,i}"},".\nEvery digit must satisfy ",{"t":"im","v":"0 \\le d_i < b"},"."]}],"line":28},{"t":"block","name":"aside","id":"aside-1","depth":"standard","attrs":{},"c":[{"t":"p","c":[{"t":"em","c":["Radix"]}," is another word for ",{"t":"em","c":["base"]},". GATE papers use both."]}],"line":33},{"t":"h","d":2,"id":"reading-a-number-in-any-base","c":["Reading a number in any base"]},{"t":"block","name":"derivation","id":"expansion","depth":"standard","attrs":{"of":"the value of a numeral"},"c":[{"t":"p","c":["Add up digit × place value over every position:"]},{"t":"math","v":"N = d_k b^k + \\dots + d_1 b + d_0 = \\sum_{i=0}^{k} d_i\\, b^{\\,i}"},{"t":"p","c":["Factor out ",{"t":"im","v":"b"}," again and again and the same sum becomes a chain of \"multiply, then add\":"]},{"t":"math","v":"N = \\big( \\dots ( d_k\\, b + d_{k-1} )\\, b + \\dots \\big)\\, b + d_0"}],"line":39},{"t":"block","name":"viz","id":"viz-1","depth":"standard","attrs":{"spec":"binary-place-values","mode":"animate"},"c":[],"line":53},{"t":"block","name":"example","id":"example-1","depth":"standard","attrs":{"level":"easy","title":"Binary to decimal"},"c":[{"t":"p","c":["Convert ",{"t":"im","v":"(1011)_2"}," to decimal."]},{"t":"block","name":"step","id":"step-1","depth":"standard","attrs":{"why":"Each position stands for a power of the base, starting from 2⁰ on the right."},"c":[{"t":"p","c":["Write the place value under each digit."]},{"t":"math","v":"\\begin{array}{cccc}\n1 & 0 & 1 & 1 \\\\\n2^3 & 2^2 & 2^1 & 2^0 \\\\\n8 & 4 & 2 & 1\n\\end{array}"}],"line":59},{"t":"block","name":"step","id":"step-2","depth":"standard","attrs":{"why":"A digit contributes digit × place value, so a 0 contributes nothing."},"c":[{"t":"p","c":["Multiply each digit by its place value."]},{"t":"math","v":"\\begin{aligned}\n1 \\cdot 8 &= 8 \\\\\n0 \\cdot 4 &= 0 \\\\\n1 \\cdot 2 &= 2 \\\\\n1 \\cdot 1 &= 1\n\\end{aligned}"}],"line":71},{"t":"block","name":"step","id":"step-3","depth":"standard","attrs":{"why":"The value of the numeral is the total of all contributions."},"c":[{"t":"p","c":["Add the contributions: ",{"t":"im","v":"8 + 0 + 2 + 1 = 11"},"."]}],"line":84},{"t":"block","name":"answer","id":"answer-1","depth":"standard","attrs":{},"c":[{"t":"p","c":[{"t":"im","v":"(1011)_2 = 11"}]}],"line":88}],"line":56},{"t":"block","name":"example","id":"example-2","depth":"standard","attrs":{"level":"medium","title":"Octal to decimal"},"c":[{"t":"p","c":["Convert ",{"t":"im","v":"(257)_8"}," to decimal."]},{"t":"block","name":"step","id":"step-4","depth":"standard","attrs":{"why":"In base 8 the places are 8⁰ = 1, 8¹ = 8 and 8² = 64."},"c":[{"t":"p","c":["List the place values from the right: ",{"t":"im","v":"1, 8, 64"},"."]}],"line":96},{"t":"block","name":"step","id":"step-5","depth":"standard","attrs":{"why":"Same rule as in base 2: digit × place value for each position."},"c":[{"t":"p","c":["Weight each digit."]},{"t":"math","v":"\\begin{aligned}\n2 \\cdot 64 &= 128 \\\\\n5 \\cdot 8 &= 40 \\\\\n7 \\cdot 1 &= 7\n\\end{aligned}"}],"line":100},{"t":"block","name":"step","id":"step-6","depth":"standard","attrs":{"why":"The value is the sum of the weighted digits."},"c":[{"t":"p","c":["Add: ",{"t":"im","v":"128 + 40 + 7 = 175"},"."]}],"line":112},{"t":"block","name":"answer","id":"answer-2","depth":"standard","attrs":{},"c":[{"t":"p","c":[{"t":"im","v":"(257)_8 = 175"}]}],"line":116}],"line":93},{"t":"block","name":"example","id":"example-3","depth":"standard","attrs":{"level":"gate","title":"Find the unknown base"},"c":[{"t":"p","c":["For which base ",{"t":"im","v":"b"}," is ",{"t":"im","v":"(31)_b = 16"},"?"]},{"t":"block","name":"step","id":"step-7","depth":"standard","attrs":{"why":"Expanding with place values turns the numeral into an equation in b."},"c":[{"t":"p","c":["Expand the left side: ",{"t":"im","v":"(31)_b = 3 \\cdot b + 1"},"."]}],"line":124},{"t":"block","name":"step","id":"step-8","depth":"standard","attrs":{"why":"Both sides name the same number, so they must be equal."},"c":[{"t":"p","c":["Solve ",{"t":"im","v":"3b + 1 = 16"},", which gives ",{"t":"im","v":"b = 5"},"."]}],"line":128},{"t":"block","name":"step","id":"step-9","depth":"standard","attrs":{"why":"A digit must be smaller than its base; otherwise the numeral is not valid in that base."},"c":[{"t":"p","c":["Check the digits: ",{"t":"im","v":"3 < 5"}," and ",{"t":"im","v":"1 < 5"},", so ",{"t":"im","v":"(31)_5"}," is a valid numeral."]}],"line":132},{"t":"block","name":"answer","id":"answer-3","depth":"standard","attrs":{},"c":[{"t":"p","c":[{"t":"im","v":"b = 5"}]}],"line":136}],"line":121},{"t":"h","d":2,"id":"why-every-number-has-one-spelling","c":["Why every number has one spelling"]},{"t":"block","name":"theorem","id":"theorem-1","depth":"standard","attrs":{"name":"Unique representation"},"c":[{"t":"p","c":["Every whole number ",{"t":"im","v":"N \\ge 0"}," has exactly one numeral in base ",{"t":"im","v":"b"}," without leading zeros."]}],"line":143},{"t":"block","name":"proof","id":"proof-1","depth":"standard","attrs":{"of":"Unique representation"},"c":[{"t":"p","c":["The last digit is forced: every other term is a multiple of ",{"t":"im","v":"b"},", so ",{"t":"im","v":"d_0"}," is the remainder of ",{"t":"im","v":"N \\div b"},".\nRemove it, divide by ",{"t":"im","v":"b"},", and the next digit is forced the same way. Repeat until nothing is left. Since\nno step had a choice, no two numerals can share a value."]}],"line":147},{"t":"block","name":"check","id":"quick-check","depth":"standard","attrs":{},"c":[{"t":"p","c":["What is ",{"t":"im","v":"(110)_2"}," in decimal?"]},{"t":"block","name":"answer","id":"answer-4","depth":"standard","attrs":{},"c":[{"t":"p","c":[{"t":"im","v":"1 \\cdot 4 + 1 \\cdot 2 + 0 \\cdot 1 = 6"},"."]}],"line":156}],"line":153},{"t":"block","name":"trick","id":"trick-1","depth":"standard","attrs":{"title":"Double and add"},"c":[{"t":"p","c":["Read binary left to right in your head: start at ",{"t":"im","v":"0"},"; for each bit, double the total and add the bit.\nFor ",{"t":"im","v":"1011"},": ",{"t":"im","v":"0 \\to 1 \\to 2 \\to 5 \\to 11"},". It is the chain form from the ",{"t":"a","href":"/gate/notes/demo/place-value#expansion","c":["derivation"]},"."]}],"line":161},{"t":"block","name":"trap","id":"trap-1","depth":"standard","attrs":{"title":"Digits must be smaller than the base"},"c":[{"t":"p","c":["\"",{"t":"im","v":"(19)_8"},"\" is not an octal numeral, because 9 is not an octal digit. In equations like ",{"t":"im","v":"(43)_x = (y3)_8"},"\nthis quietly adds the conditions ",{"t":"im","v":"x > 4"}," and ",{"t":"im","v":"y < 8"},", and missing them gives wrong counts."]}],"line":166},{"t":"block","name":"table","id":"table-1","depth":"standard","attrs":{"title":"The same value in four bases"},"c":[{"t":"table","align":["left","left","left"],"c":[{"t":"tr","c":[{"t":"td","c":["Base"]},{"t":"td","c":["Numeral"]},{"t":"td","c":["Expansion"]}]},{"t":"tr","c":[{"t":"td","c":["2"]},{"t":"td","c":[{"t":"im","v":"1011"}]},{"t":"td","c":[{"t":"im","v":"8 + 2 + 1"}]}]},{"t":"tr","c":[{"t":"td","c":["8"]},{"t":"td","c":[{"t":"im","v":"13"}]},{"t":"td","c":[{"t":"im","v":"8 + 3"}]}]},{"t":"tr","c":[{"t":"td","c":["10"]},{"t":"td","c":[{"t":"im","v":"11"}]},{"t":"td","c":[{"t":"im","v":"10 + 1"}]}]},{"t":"tr","c":[{"t":"td","c":["16"]},{"t":"td","c":[{"t":"im","v":"B"}]},{"t":"td","c":[{"t":"im","v":"11"}]}]}]}],"line":171},{"t":"h","d":2,"id":"practice","c":["Practice"]},{"t":"block","name":"pyq","id":"pyq-cse-2023-cs-22","depth":"standard","attrs":{"id":"cse-2023-cs-22"},"c":[],"line":182},{"t":"block","name":"practice","id":"practice-nx-demo-01-01-q01","depth":"standard","attrs":{"id":"nx-demo-01-01-q01"},"c":[],"line":185},{"t":"block","name":"viz","id":"viz-2","depth":"standard","attrs":{"spec":"binary-place-values","mode":"static"},"c":[],"line":188},{"t":"block","name":"note","id":"note-1","depth":"deep","attrs":{},"c":[{"t":"p","c":["Positions to the right of the point continue the pattern: ",{"t":"im","v":"b^{-1}"},", ",{"t":"im","v":"b^{-2}"},", … So ",{"t":"im","v":"(0.1)_2 = \\tfrac12"},"."]}],"line":191},{"t":"block","name":"summary","id":"summary-1","depth":"standard","attrs":{},"c":[{"t":"ul","tight":true,"c":[{"t":"li","c":[{"t":"p","c":["A digit is worth digit × ",{"t":"im","v":"b^{\\text{position}}"},", counting positions from ",{"t":"im","v":"0"}," on the right."]}]},{"t":"li","c":[{"t":"p","c":["Every digit must be smaller than the base."]}]},{"t":"li","c":[{"t":"p","c":["To read fast, use the chain: multiply by ",{"t":"im","v":"b"},", add the next digit."]}]}]}],"line":195}]}},"practice":{"nx-demo-01-01-q01":{"id":"nx-demo-01-01-q01","type":"NAT","marks":1,"text":[{"t":"p","c":["What is ",{"t":"im","v":"(1011.01)_2"}," in decimal?"]}],"answer":11.25,"solution":[[{"t":"p","c":["Integer part: ",{"t":"im","v":"1\\cdot 2^3 + 0\\cdot 2^2 + 1\\cdot 2^1 + 1\\cdot 2^0 = 8 + 2 + 1 = 11"},"."]}],[{"t":"p","c":["Fraction part: the digits after the point stand for ",{"t":"im","v":"2^{-1}"}," and ",{"t":"im","v":"2^{-2}"},", so ",{"t":"im","v":".01_2 = 0\\cdot\\tfrac12 + 1\\cdot\\tfrac14 = 0.25"},"."]}],[{"t":"p","c":["Together: ",{"t":"im","v":"11 + 0.25 = 11.25"},"."]}]],"concept":"Positions after the radix point carry negative powers of the base.","common_wrong":[{"answer":11.01,"why":[{"t":"p","c":["The digits after the point were copied across. In base 2 they stand for halves and quarters, not hundredths."]}]},{"answer":11.5,"why":[{"t":"p","c":["The 1 was read as the ",{"t":"im","v":"2^{-1}"}," digit. It is the second digit after the point, so it is worth ",{"t":"im","v":"2^{-2} = 0.25"},"."]}]}],"blocks":["place-value-def","expansion"],"source":"nexora"},"nx-demo-01-01-q02":{"id":"nx-demo-01-01-q02","type":"MCQ","marks":1,"text":[{"t":"p","c":["Which decimal number is ",{"t":"im","v":"(2D)_{16}"},"?"]}],"options":[{"l":"A","c":[{"t":"p","c":[{"t":"im","v":"29"}]}]},{"l":"B","c":[{"t":"p","c":[{"t":"im","v":"43"}]}]},{"l":"C","c":[{"t":"p","c":[{"t":"im","v":"45"}]}]},{"l":"D","c":[{"t":"p","c":[{"t":"im","v":"213"}]}]}],"answer":"C","solution":[[{"t":"p","c":["In base 16 the digit D stands for 13."]}],[{"t":"p","c":[{"t":"im","v":"(2D)_{16} = 2\\cdot 16 + 13 = 45"},"."]}]],"concept":"Each hexadecimal digit is worth digit × a power of 16.","common_wrong":[{"answer":"A","why":[{"t":"p","c":["This reads D as 13 but weights the 2 by 8, the octal place value."]}]},{"answer":"D","why":[{"t":"p","c":["The digits were written side by side (2 and 13) instead of being weighted by their places."]}]}],"blocks":["expansion"],"source":"nexora"}},"viz":{"binary-place-values":{"version":1,"title":"Reading 1011 in base 2","width":560,"height":230,"intro":"The bit string 1011, with the power of two each position stands for written above it.","elements":[{"id":"bits","type":"bits","x":152,"y":46,"bits":"1011","cell":64,"labels":["2³","2²","2¹","2⁰"],"below":["8","4","2","1"]},{"id":"a0","type":"arrow","from":[184,140],"to":"total","tone":"subject","hidden":true},{"id":"a1","type":"arrow","from":[248,140],"to":"total","tone":"muted","dashed":true,"hidden":true},{"id":"a2","type":"arrow","from":[312,140],"to":"total","tone":"subject","hidden":true},{"id":"a3","type":"arrow","from":[376,140],"to":"total","tone":"subject","hidden":true},{"id":"total","type":"box","x":190,"y":176,"w":180,"h":44,"label":"total = 0","mono":true}],"steps":[{"caption":"The leftmost 1 sits in the 2³ place, so it contributes 8. Total: 8.","patches":[{"id":"bits","set":{"highlight":[0]}},{"id":"a0","set":{"hidden":false}},{"id":"total","set":{"label":"total = 8"}}]},{"caption":"The 0 in the 2² place contributes nothing. Total stays 8.","patches":[{"id":"a1","set":{"hidden":false}}]},{"caption":"The 1 in the 2¹ place contributes 2. Total: 10.","patches":[{"id":"bits","set":{"highlight":[0,2]}},{"id":"a2","set":{"hidden":false}},{"id":"total","set":{"label":"total = 10"}}]},{"caption":"The 1 in the 2⁰ place contributes 1. Total: 11, so 1011 in base 2 is 11.","patches":[{"id":"bits","set":{"highlight":[0,2,3]}},{"id":"a3","set":{"hidden":false}},{"id":"total","set":{"label":"total = 11","tone":"success","fill":"success"}}]}]}}}
