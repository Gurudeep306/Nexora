# ──────────────────────────────────────────────────────────────
#  Nexora — Environment Configuration
#  Copy this file to .env and fill in real values.
#  NEVER commit the real .env file.
# ──────────────────────────────────────────────────────────────

# Server
NODE_ENV=production
PORT=3000

# The public URL of your deployment (used for OAuth callbacks)
APP_URL=https://your-domain.com

# Session — generate with: openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING

# Sites allowed to call the API with cookies (CORS + socket.io), comma-separated.
# Empty = any origin in dev; APP_URL + localhost:3000 in production.
# (ALLOWED_ORIGINS is still read as the old name.)
CLIENT_ORIGINS=

# ── Split deploy: website and API on different hosts (all optional) ──────
# See deploy/oracle/.env.example and docs/deploy/LAUNCH_RUNBOOK.md.
# API_URL       base for OAuth callbacks (default APP_URL)
# PUBLIC_URL    where OAuth logins return to (default: same host)
# COOKIE_DOMAIN e.g. .nexoraguru.in (default: host-only cookie)
# TRUST_PROXY   express trust proxy hops (default 1 in production)
API_URL=
PUBLIC_URL=
COOKIE_DOMAIN=
TRUST_PROXY=

# ── Code judge on a self-hosted Piston (JUDGE_MODE=piston) ─────────────
PISTON_URL=
PISTON_LANGUAGES=

# ── Error reporting (optional) — Sentry is only loaded when set ────────
SENTRY_DSN=

# ── OAuth — GitHub ──────────────────────────────────────────────
# Create at: https://github.com/settings/developers → New OAuth App
# Homepage URL     : https://your-domain.com
# Callback URL     : https://your-domain.com/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── OAuth — Google ─────────────────────────────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://your-domain.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── AI: Groq (the only AI provider) ───────────────────────────
# Every AI feature (assistant chat, tutor, coach, completion, fix, translation,
# problem finder, Studio, GATE debrief) goes through one
# server-side agent. Get a key at https://console.groq.com/keys
# Leave it empty to run the site without AI (AI endpoints answer 503).
GROQ_API_KEY=
# Optional model overrides (defaults shown).
# Main model: chat, tools, JSON tasks
GROQ_MODEL=openai/gpt-oss-120b
# Fast model: ghost completion, language detection
GROQ_FAST_MODEL=openai/gpt-oss-20b
# Used once when the main model is rate-limited or erroring
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# Per-user daily token budget (all AI features combined)
AI_DAILY_TOKENS=200000

STUDIO_PASSWORD=your-studio-password

# ── Cloud database (Turso) ────────────────────────────────────
# Used by the server only in production (NODE_ENV=production) or when
# USE_CLOUD_DB=1, so `npm start` on your Mac keeps using the local tracker.db.
# Fill these in locally for `npm run db:push-to-cloud` / `npm run db:backup`.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── Hosting safety switches (set on the server) ────────────────
# remote = never run submitted code on this machine; use Wandbox instead
# piston = self-hosted Piston at PISTON_URL first, Wandbox as fallback
JUDGE_MODE=
# 1 = skip the headless-Chrome scraper fallback (free hosts have no Chrome)
DISABLE_PUPPETEER=
# Max size (MB) of an uploaded file that gets saved into the database (default 50)
UPLOAD_PERSIST_MAX_MB=
