# ──────────────────────────────────────────────────────────────
#  Nexora — Environment Configuration
#  Copy this file to .env and fill in real values.
#  NEVER commit the real .env file.
# ──────────────────────────────────────────────────────────────

# Server
NODE_ENV=production
PORT=3000

# The public URL of your deployment (used for OAuth callbacks)
APP_URL=https://your-domain.com

# Session — generate with: openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING

# Allowed CORS origins in production (comma-separated)
ALLOWED_ORIGINS=https://your-domain.com

# ── OAuth — GitHub ──────────────────────────────────────────────
# Create at: https://github.com/settings/developers → New OAuth App
# Homepage URL     : https://your-domain.com
# Callback URL     : https://your-domain.com/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── OAuth — Google ─────────────────────────────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://your-domain.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── AI — Code Completion: Google Gemini (primary, recommended) ──
# Free tier: 1,500 req/day, 15 req/min. Get key at:
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── AI — Chat / Fix / Analysis: Groq (primary) ────────────────
# Get at: https://console.groq.com/keys
# Used for: AI chat, AI fix, AI analysis. Also used as completion fallback.
GROQ_API_KEY=

STUDIO_PASSWORD=your-studio-password

# ── Cloud database (Turso) ────────────────────────────────────
# Used by the server only in production (NODE_ENV=production) or when
# USE_CLOUD_DB=1, so `npm start` on your Mac keeps using the local tracker.db.
# Fill these in locally for `npm run db:push-to-cloud` / `npm run db:backup`.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── Hosting safety switches (set on the server) ────────────────
# remote = never run submitted code on this machine; use Wandbox instead
JUDGE_MODE=
# 1 = skip the headless-Chrome scraper fallback (free hosts have no Chrome)
DISABLE_PUPPETEER=
# Max size (MB) of an uploaded file that gets saved into the database (default 50)
UPLOAD_PERSIST_MAX_MB=
