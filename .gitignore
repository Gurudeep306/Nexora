# Dependencies
node_modules/

# Environment variables — NEVER commit real secrets
.env
.env.local
.env.*.local

# Database files
tracker.db
tracker.db-shm
tracker.db-wal
*.db
*.db-shm
*.db-wal

# Logs
*.log
logs/
npm-debug.log*

# OS / editor artifacts
.DS_Store
Thumbs.db
.vscode/settings.json

# Build outputs
dist/
build/

# Uploads (if user-generated)
public/uploads/*
!public/uploads/.gitkeep


# Database backups downloaded by `npm run db:backup`
backups/

# Temporary archives
*.tgz

# Python bytecode
__pycache__/
*.pyc

# Heavy neural network binary weights (>100MB exceed GitHub push limits)
ai-engine/models/*.gguf
ai-engine/models/*.bin
ai-engine/models/*.safetensors

# Python environments
.venv/
*/.venv/
venv/
*/venv/

.aider*
