# Caddy — HTTPS front door for the API on the Oracle VM.
# Installed to /etc/caddy/Caddyfile by deploy/oracle/setup.sh.
# Reload after editing:  sudo systemctl reload caddy
#
# Caddy gets and renews a Let's Encrypt certificate for api.nexoraguru.in by
# itself. That needs ports 80 and 443 open (setup.sh does it) and the DNS
# record pointing here. See docs/deploy/LAUNCH_RUNBOOK.md for the Cloudflare
# order of operations (grey cloud first, then orange).

{
	# Contact for Let's Encrypt expiry notices. Change to your address.
	email admin@nexoraguru.in

	servers {
		# Requests arriving through Cloudflare's proxy: believe the visitor IP
		# Cloudflare reports, but only from Cloudflare's own address ranges
		# (https://www.cloudflare.com/ips/ — refresh occasionally).
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

api.nexoraguru.in {
	encode zstd gzip

	# Biggest upload the app accepts is well under this.
	request_body {
		max_size 60MB
	}

	reverse_proxy 127.0.0.1:3000 {
		# Hand Node exactly one, trustworthy visitor IP (the app runs with
		# TRUST_PROXY=1, i.e. it trusts this one hop).
		header_up X-Forwarded-For {client_ip}
		header_up X-Real-IP {client_ip}

		# socket.io websockets: Caddy upgrades connections automatically; keep
		# them open through deploys for a few seconds and stream SSE (AI chat)
		# without buffering.
		flush_interval -1
		stream_close_delay 5s

		# pm2 reload keeps one process up, but if Node is briefly down retry
		# instead of returning 502 immediately.
		lb_try_duration 10s
		lb_try_interval 250ms
	}

	log {
		output file /var/log/caddy/api.log {
			roll_size 20MiB
			roll_keep 5
		}
	}
}
