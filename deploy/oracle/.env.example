# ─────────────────────────────────────────────────────────────────────────────
#  API server on the Oracle VM — copy to /opt/nexora/.env and fill in.
#    sudo -u deploy cp /opt/nexora/deploy/oracle/.env.example /opt/nexora/.env
#    sudo -u deploy nano /opt/nexora/.env
#  This file has NO secrets. Never commit the real .env (it's in .gitignore).
#  After editing:  sudo -u deploy pm2 reload nexora --update-env
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=production
# Caddy proxies https://api.nexoraguru.in → 127.0.0.1:3000. Keep it on 3000.
PORT=3000

# ── Where things live (split deploy) ────────────────────────────────────────
# This API's public address. OAuth callback URLs are built from it:
#   https://api.nexoraguru.in/auth/github/callback
#   https://api.nexoraguru.in/auth/google/callback
API_URL=https://api.nexoraguru.in
# The website (Cloudflare Pages). After a GitHub/Google login the browser is
# sent back here.
PUBLIC_URL=https://nexoraguru.in
# Also used for log lines and as an allowed origin. Same as API_URL here.
APP_URL=https://api.nexoraguru.in
# Sites allowed to call the API with cookies (CORS + socket.io), comma-separated.
# Add the Render/staging URL too if it should talk to this API.
CLIENT_ORIGINS=https://nexoraguru.in,https://www.nexoraguru.in
# Optional: share the login cookie across *.nexoraguru.in. Leave empty unless
# you need it — the default (cookie only on api.nexoraguru.in) already works
# because nexoraguru.in and api.nexoraguru.in are the same "site".
COOKIE_DOMAIN=
# Express "trust proxy". 1 = trust Caddy on the same box (Caddy passes on the
# real visitor IP from Cloudflare). Only change if you add another proxy layer.
TRUST_PROXY=1

# ── Secrets ──────────────────────────────────────────────────────────────────
# Signs login sessions. Generate:  openssl rand -hex 32   (64 characters)
SESSION_SECRET=
# Password for /studio (Creator Studio admin). Required in production.
STUDIO_PASSWORD=

# ── Database (Turso) ────────────────────────────────────────────────────────
# From https://app.turso.tech → your database. Same values as on Render.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Keep a local copy of each database on this VM's disk, synced by Turso.
# Pages then read from the disk instead of the network (much faster); writes
# still go to Turso first. Leave empty to read from Turso directly.
TURSO_REPLICA_DIR=/opt/nexora/data/replicas
# How often (seconds) the local copies pull changes made elsewhere.
TURSO_SYNC_SECONDS=15
# The data split (docs/ops/DATA_SPLIT.md). Leave empty until a store has been
# moved with scripts/ops/split-db.cjs; an empty one stays in the main database.
# A Turso GROUP token in TURSO_AUTH_TOKEN covers them all; else set
# TURSO_<STORE>_AUTH_TOKEN too.
TURSO_HIVE_URL=
TURSO_FILES_URL=
TURSO_CACHE_URL=
TURSO_LOGS_URL=

# ── Login with GitHub / Google (optional) ──────────────────────────────────
# See docs/deploy/LAUNCH_RUNBOOK.md step 12 for the exact callback URLs.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── AI (Groq) ───────────────────────────────────────────────────────────────
# https://console.groq.com/keys — empty = AI features answer 503.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
AI_DAILY_TOKENS=200000

# ── Code judge ───────────────────────────────────────────────────────────────
# piston = run code on the Piston container on this VM (installed by setup.sh),
#          falling back to Wandbox for languages Piston doesn't have.
# remote = public sandboxes only (Wandbox etc.) — use this if Piston is off.
# Never "local": that would run strangers' code directly on the server.
JUDGE_MODE=piston
PISTON_URL=http://127.0.0.1:2000
# Which app languages Piston answers for. setup.sh fills this with the ones
# that passed its smoke test. Empty = every language Piston knows.
PISTON_LANGUAGES=
# Per-run limits sent to Piston (must not exceed the container's own limits
# in deploy/oracle/piston-compose.yml).
PISTON_RUN_TIMEOUT_MS=10000
PISTON_COMPILE_TIMEOUT_MS=30000

# ── Hosting switches ────────────────────────────────────────────────────────
# No Chrome on the VM: skip the headless-browser scraper fallback.
DISABLE_PUPPETEER=1
PUPPETEER_SKIP_DOWNLOAD=1
# Max size (MB) of an uploaded file that is also saved into the database.
UPLOAD_PERSIST_MAX_MB=50

# ── Monitoring (optional) ───────────────────────────────────────────────────
# Sentry → Settings → Projects → (Node project) → Client Keys (DSN).
# Empty = Sentry is not loaded at all.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
