<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>Nexora Creator Studio</title>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#07070f;--s1:#0c0c1a;--s2:#111125;--s3:#181838;--s4:#20204a;
  --bdr:#252555;--bdr2:#353570;--bdr3:#454590;
  --acc:#6c5ce7;--acc2:#00cec9;--acc3:#a855f7;--acc4:#fd79a8;
  --glow:rgba(108,92,231,.25);--glow2:rgba(0,206,201,.15);
  --txt:#e2e8f0;--txt2:#94a3b8;--txt3:#475569;
  --ok:#10b981;--err:#ef4444;--warn:#f59e0b;--info:#3b82f6;
  --r:8px;--r2:12px;--r3:16px;
  --nav-w:54px;--sb-w:280px;--top-h:48px;
  --ease:.18s cubic-bezier(.4,0,.2,1);
  --font:'Segoe UI',system-ui,-apple-system,sans-serif;
  --mono:'Fira Code','Cascadia Code','JetBrains Mono',monospace;
}
html,body{height:100%;overflow:hidden;font-family:var(--font);background:var(--bg);color:var(--txt);font-size:14px;-webkit-font-smoothing:antialiased}
::-webkit-scrollbar{width:5px;height:5px}::-webkit-scrollbar-track{background:transparent}::-webkit-scrollbar-thumb{background:var(--bdr2);border-radius:3px}::-webkit-scrollbar-thumb:hover{background:var(--bdr3)}
a{color:var(--acc2);text-decoration:none}a:hover{text-decoration:underline}
input,select,textarea,button{font-family:var(--font)}

/* LOGIN GATE */
#gate{position:fixed;inset:0;z-index:9999;background:var(--bg);display:flex;align-items:center;justify-content:center;background-image:radial-gradient(ellipse at 20% 50%,rgba(108,92,231,.1) 0%,transparent 60%),radial-gradient(ellipse at 80% 20%,rgba(0,206,201,.07) 0%,transparent 50%)}
.gc{background:var(--s1);border:1px solid var(--bdr2);border-radius:24px;padding:52px 48px;width:400px;display:flex;flex-direction:column;gap:20px;align-items:center;box-shadow:0 0 80px rgba(108,92,231,.12),0 20px 60px rgba(0,0,0,.5);animation:gIn .5s cubic-bezier(.34,1.56,.64,1)}
@keyframes gIn{from{opacity:0;transform:scale(.92) translateY(16px)}to{opacity:1;transform:none}}
.gc-logo{width:68px;height:68px;border-radius:18px;background:linear-gradient(135deg,var(--acc),var(--acc3));display:flex;align-items:center;justify-content:center;box-shadow:0 8px 28px var(--glow)}
.gc-logo svg{width:32px;height:32px;fill:none;stroke:#fff;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.gc-t{font-size:28px;font-weight:800;background:linear-gradient(135deg,#fff 30%,var(--acc2));-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.gc-s{font-size:13px;color:var(--txt3);text-align:center;line-height:1.6}
.gc-i{width:100%;background:var(--s2);border:1.5px solid var(--bdr);border-radius:var(--r);padding:12px 16px;color:var(--txt);font-size:15px;outline:none;transition:border-color var(--ease),box-shadow var(--ease)}
.gc-i:focus{border-color:var(--acc);box-shadow:0 0 0 3px var(--glow)}
.gc-b{width:100%;background:linear-gradient(135deg,var(--acc),var(--acc3));color:#fff;border:none;border-radius:var(--r);padding:13px;font-size:15px;font-weight:700;cursor:pointer;transition:opacity var(--ease),transform var(--ease);box-shadow:0 4px 18px var(--glow)}
.gc-b:hover:not(:disabled){opacity:.88;transform:translateY(-1px)}.gc-b:disabled{opacity:.5;cursor:wait}
.gc-e{color:var(--err);font-size:12px;text-align:center;display:none;animation:shake .3s}
@keyframes shake{0%,100%{transform:none}25%{transform:translateX(-6px)}75%{transform:translateX(6px)}}

/* SHELL */
#shell{display:none;height:100vh;overflow:hidden}
#shell.on{display:flex}

/* NAV */
#nav{width:var(--nav-w);background:var(--s1);border-right:1px solid var(--bdr);display:flex;flex-direction:column;align-items:center;padding:10px 0;gap:2px;flex-shrink:0;z-index:30}
.nlogo{width:32px;height:32px;border-radius:9px;background:linear-gradient(135deg,var(--acc),var(--acc3));display:flex;align-items:center;justify-content:center;font-weight:900;font-size:14px;color:#fff;margin-bottom:6px;box-shadow:0 3px 10px var(--glow);cursor:pointer}
.ndiv{width:22px;height:1px;background:var(--bdr);margin:4px 0}
.nsp{flex:1}
.nb{width:38px;height:38px;border-radius:var(--r);cursor:pointer;display:flex;align-items:center;justify-content:center;color:var(--txt3);transition:all var(--ease);border:1.5px solid transparent;position:relative}
.nb:hover{color:var(--txt);background:var(--s3)}
.nb.on{color:var(--acc);background:var(--s3);border-color:var(--bdr2);box-shadow:0 0 10px var(--glow)}
.nb svg{width:17px;height:17px;flex-shrink:0}
.nb .tip{position:absolute;left:calc(100% + 10px);background:var(--s3);border:1px solid var(--bdr2);border-radius:6px;padding:4px 9px;font-size:11px;font-weight:600;color:var(--txt);white-space:nowrap;pointer-events:none;opacity:0;transition:opacity .12s;z-index:99}
.nb:hover .tip{opacity:1}

/* SIDEBAR */
#sb{width:var(--sb-w);background:var(--s1);border-right:1px solid var(--bdr);display:flex;flex-direction:column;overflow:hidden;flex-shrink:0}
.sb-hd{padding:0 12px;height:var(--top-h);border-bottom:1px solid var(--bdr);display:flex;align-items:center;gap:8px;flex-shrink:0}
.sb-t{font-size:12px;font-weight:700;color:var(--txt2);text-transform:uppercase;letter-spacing:.06em;flex:1}
.sb-btn{background:var(--acc);color:#fff;border:none;border-radius:6px;padding:4px 10px;font-size:11.5px;font-weight:700;cursor:pointer;transition:opacity var(--ease)}
.sb-btn:hover{opacity:.85}
.sb-s{padding:8px 10px;border-bottom:1px solid var(--bdr);flex-shrink:0}
.sb-s input{width:100%;background:var(--s2);border:1px solid var(--bdr);border-radius:6px;padding:7px 10px;color:var(--txt);font-size:12px;outline:none}
.sb-s input:focus{border-color:var(--acc)}
#slist{flex:1;overflow-y:auto;padding:4px}

/* TREE */
.th{display:flex;align-items:center;gap:6px;padding:6px 8px;border-radius:6px;cursor:pointer;transition:background var(--ease);user-select:none}
.th:hover{background:var(--s3)}.th.sel{background:var(--s3);color:var(--acc)}
.ta{font-size:9px;color:var(--txt3);transition:transform .15s;flex-shrink:0;width:10px;text-align:center}
.th.open>.ta{transform:rotate(90deg)}
.ti{font-size:14px;flex-shrink:0}.tl{flex:1;font-size:12.5px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tg{font-size:10px;padding:1px 5px;border-radius:3px;background:var(--s4);color:var(--txt3);flex-shrink:0}
.tp{width:6px;height:6px;border-radius:50%;flex-shrink:0}.tp.y{background:var(--ok)}.tp.n{background:var(--txt3)}
.tc{padding-left:12px;display:none}.tc.open{display:block}
.tleaf{display:flex;align-items:center;gap:6px;padding:5px 8px;border-radius:5px;cursor:pointer;font-size:12px;color:var(--txt2);transition:all var(--ease)}
.tleaf:hover{background:var(--s3);color:var(--txt)}.tleaf.sel{background:var(--s3);color:var(--acc);font-weight:600}
.td{width:4px;height:4px;border-radius:50%;background:currentColor;opacity:.5;flex-shrink:0}
.tadd{display:flex;align-items:center;gap:5px;padding:4px 8px;border-radius:5px;cursor:pointer;font-size:11px;color:var(--acc);opacity:.7;transition:opacity var(--ease)}
.tadd:hover{opacity:1}

/* MAIN */
#mn{flex:1;display:flex;flex-direction:column;overflow:hidden}
#topbar{height:var(--top-h);background:var(--s1);border-bottom:1px solid var(--bdr);display:flex;align-items:center;gap:10px;padding:0 16px;flex-shrink:0}
#tbt{font-size:13px;font-weight:600;color:var(--txt2);flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#tba{display:flex;gap:6px;flex-shrink:0}
#save-status{font-size:10px;color:var(--txt3);margin-right:8px}

/* BUTTONS */
.btn{display:inline-flex;align-items:center;gap:5px;background:var(--s3);border:1px solid var(--bdr2);color:var(--txt2);padding:6px 12px;border-radius:var(--r);font-size:12px;font-weight:500;cursor:pointer;transition:all var(--ease);white-space:nowrap}
.btn:hover{background:var(--s4);color:var(--txt);border-color:var(--bdr3)}
.btn.p{background:var(--acc);border-color:var(--acc);color:#fff;box-shadow:0 2px 8px var(--glow)}.btn.p:hover{opacity:.88}
.btn.d{border-color:var(--err);color:var(--err)}.btn.d:hover{background:rgba(239,68,68,.08)}
.btn.ok{border-color:var(--ok);color:var(--ok)}.btn.ok:hover{background:rgba(16,185,129,.08)}
.btn.sm{padding:4px 8px;font-size:11px}
.btn.ai{background:linear-gradient(135deg,#6c5ce7,#a855f7);border-color:transparent;color:#fff;box-shadow:0 2px 10px rgba(168,85,247,.25)}
.btn.ai:hover{opacity:.85}
.btn svg{width:13px;height:13px}

/* CANVAS */
#canvas{flex:1;overflow:hidden;display:flex;flex-direction:column;position:relative}
.sec{display:none;flex:1;overflow:hidden;flex-direction:column;animation:fadeUp .22s ease}
.sec.on{display:flex}
@keyframes fadeUp{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
.ebody{flex:1;overflow-y:auto;padding:20px 24px;display:flex;flex-direction:column;gap:16px}

/* WELCOME */
.welcome{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18px;padding:40px;text-align:center}
.wi{font-size:56px;filter:drop-shadow(0 6px 20px var(--glow));animation:float 4s ease-in-out infinite}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}
.welcome h2{font-size:24px;font-weight:800;background:linear-gradient(135deg,var(--txt),var(--acc2));-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.welcome p{font-size:13px;color:var(--txt3);max-width:460px;line-height:1.7}
.wg{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:10px;max-width:720px;margin-top:6px}
.wc{background:var(--s2);border:1px solid var(--bdr);border-radius:var(--r2);padding:18px 12px;cursor:pointer;transition:all var(--ease);text-align:center}
.wc:hover{border-color:var(--acc);background:var(--s3);transform:translateY(-2px);box-shadow:0 6px 20px var(--glow)}
.wc .wci{font-size:24px;margin-bottom:8px}.wc .wct{font-size:12px;font-weight:700}.wc .wcs{font-size:10px;color:var(--txt3);margin-top:3px}

/* FORMS */
.fd{display:flex;flex-direction:column;gap:5px}
.fd label{font-size:10.5px;font-weight:700;color:var(--txt3);text-transform:uppercase;letter-spacing:.06em}
.fd input,.fd select,.fd textarea{background:var(--s2);border:1.5px solid var(--bdr);border-radius:var(--r);padding:8px 12px;color:var(--txt);font-size:13px;outline:none;font-family:var(--font);width:100%;transition:border-color var(--ease),box-shadow var(--ease)}
.fd input:focus,.fd select:focus,.fd textarea:focus{border-color:var(--acc);box-shadow:0 0 0 3px var(--glow)}
.fd textarea{resize:vertical;min-height:70px;line-height:1.6}
.fd select option{background:var(--s2)}
.frow{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:12px}
.frow2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.stt{font-size:11px;font-weight:700;color:var(--txt3);text-transform:uppercase;letter-spacing:.06em;padding-bottom:7px;border-bottom:1px solid var(--bdr)}

/* TABS */
.tabs{display:flex;border-bottom:1px solid var(--bdr);flex-shrink:0;background:var(--s1);padding:0 4px}
.tab{padding:10px 14px;font-size:12px;cursor:pointer;color:var(--txt3);border-bottom:2.5px solid transparent;transition:all var(--ease);font-weight:500}
.tab:hover{color:var(--txt)}.tab.on{color:var(--acc);border-bottom-color:var(--acc);font-weight:700}

/* QUILL */
.ql-wrap{border:1.5px solid var(--bdr);border-radius:var(--r);overflow:hidden;transition:border-color var(--ease);display:flex;flex-direction:column}
.ql-wrap:focus-within{border-color:var(--acc)}
.ql-toolbar.ql-snow{background:var(--s2)!important;border:none!important;border-bottom:1px solid var(--bdr)!important;padding:6px 8px!important}
.ql-container.ql-snow{border:none!important;background:var(--s3);font-size:14px;line-height:1.75;flex:1}
.ql-editor{color:var(--txt);min-height:260px;padding:14px 18px}
.ql-editor.ql-blank::before{color:var(--txt3)!important;font-style:italic!important}
.ql-snow .ql-stroke{stroke:var(--txt2)!important}.ql-snow .ql-fill{fill:var(--txt2)!important}.ql-snow .ql-picker{color:var(--txt2)!important}
.ql-snow .ql-picker-options{background:var(--s2)!important;border-color:var(--bdr)!important}.ql-snow .ql-picker-item{color:var(--txt)!important}
.ql-toolbar button:hover .ql-stroke,.ql-toolbar button.ql-active .ql-stroke{stroke:var(--acc)!important}
.ql-toolbar button:hover .ql-fill,.ql-toolbar button.ql-active .ql-fill{fill:var(--acc)!important}
.ql-toolbar .ql-picker-label:hover,.ql-toolbar .ql-picker-label.ql-active{color:var(--acc)!important}
.ql-editor h1,.ql-editor h2,.ql-editor h3{color:var(--txt);margin:.7em 0 .3em}
.ql-editor pre.ql-syntax{background:#0a0a18;color:#c0caf5;font-family:var(--mono);font-size:13px;padding:12px;border-radius:6px;border-left:3px solid var(--acc)}
.ql-editor blockquote{border-left:3px solid var(--acc);padding-left:14px;color:var(--txt2);margin:1em 0}
.ql-editor img{max-width:100%;border-radius:8px;margin:.5em 0;display:block}
.ql-editor a{color:var(--acc2)}

/* MONACO */
.mwrap{border:1.5px solid var(--bdr);border-radius:var(--r);overflow:hidden;display:flex;flex-direction:column}
.mbar{background:var(--s2);padding:6px 10px;display:flex;align-items:center;gap:8px;border-bottom:1px solid var(--bdr)}
.mbar select{background:var(--s3);border:1px solid var(--bdr);color:var(--txt2);padding:2px 7px;border-radius:5px;font-size:11px;outline:none}
.mbar label{font-size:10px;color:var(--txt3);font-weight:600;text-transform:uppercase;letter-spacing:.04em}
.mbody{flex:1;min-height:220px}

/* PROB ROWS */
.pr{display:flex;align-items:center;gap:8px;padding:8px 10px;background:var(--s2);border:1px solid var(--bdr);border-radius:var(--r);cursor:pointer;transition:all var(--ease)}
.pr:hover{border-color:var(--bdr2);background:var(--s3)}.pr.sel{border-color:var(--acc);background:rgba(108,92,231,.06)}
.pr .pt{flex:1;font-size:12.5px;font-weight:500}.pr .pm{font-size:10.5px;color:var(--txt3)}
.pr .pd{font-size:11.5px;font-weight:700}
.de{color:var(--ok)}.dm{color:var(--warn)}.dh{color:var(--err)}.dx{color:var(--acc3)}

/* SAMPLES */
.sbox{display:flex;flex-direction:column;gap:8px}
.sc{background:var(--s2);border:1px solid var(--bdr);border-radius:var(--r);padding:10px;display:grid;grid-template-columns:1fr 1fr;gap:8px;position:relative}
.sc label{font-size:9px;font-weight:700;color:var(--txt3);text-transform:uppercase;letter-spacing:.04em;display:block;margin-bottom:2px}
.sc textarea{font-family:var(--mono);font-size:12px;background:var(--s3);border:1px solid var(--bdr);border-radius:5px;padding:7px;color:var(--txt);outline:none;resize:vertical;min-height:50px;width:100%}
.sc textarea:focus{border-color:var(--acc)}
.sdel{position:absolute;top:6px;right:6px;background:none;border:none;color:var(--txt3);cursor:pointer;font-size:14px;padding:2px;border-radius:4px}.sdel:hover{color:var(--err);background:rgba(239,68,68,.08)}

/* COLOR PICKER */
.cpick{display:flex;gap:7px;flex-wrap:wrap}
.csw{width:24px;height:24px;border-radius:50%;cursor:pointer;border:3px solid transparent;transition:all var(--ease)}
.csw.on{border-color:#fff;transform:scale(1.15)}

/* MEDIA */
.upz{border:2px dashed var(--bdr2);border-radius:var(--r2);padding:28px;text-align:center;cursor:pointer;color:var(--txt3);transition:all var(--ease)}
.upz:hover,.upz.drag{border-color:var(--acc);color:var(--acc);background:rgba(108,92,231,.03)}
.mgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:8px;margin-top:12px}
.mi{position:relative;border-radius:var(--r);overflow:hidden;border:1px solid var(--bdr);aspect-ratio:16/10;background:var(--s2);cursor:pointer;transition:border-color var(--ease)}
.mi:hover{border-color:var(--bdr2)}
.mi img,.mi video{width:100%;height:100%;object-fit:cover}
.mhov{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;background:rgba(7,7,15,.85);opacity:0;transition:opacity var(--ease);gap:6px;padding:8px}
.mi:hover .mhov{opacity:1}
.mfn{padding:3px 6px;font-size:9px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:var(--txt3);background:var(--s2)}
.mficon{display:flex;align-items:center;justify-content:center;font-size:30px;height:80%}

/* SPLIT */
.split{display:flex;flex:1;overflow:hidden}
.split-l{width:340px;border-right:1px solid var(--bdr);display:flex;flex-direction:column;overflow:hidden;flex-shrink:0}
.split-r{flex:1;overflow:hidden;display:flex;flex-direction:column}

/* PAGINATION */
.pgn{display:flex;align-items:center;gap:8px;padding:8px 10px;flex-shrink:0;border-top:1px solid var(--bdr)}
.pgn .pi{font-size:11px;color:var(--txt3);flex:1;text-align:center}

/* TOAST */
#toasts{position:fixed;bottom:18px;right:18px;display:flex;flex-direction:column;gap:6px;z-index:9000}
.toast{background:var(--s2);border:1px solid var(--bdr2);border-radius:var(--r);padding:9px 14px;font-size:12.5px;min-width:200px;max-width:340px;display:flex;align-items:center;gap:8px;animation:tIn .2s ease;box-shadow:0 4px 16px rgba(0,0,0,.4)}
.toast.ok{border-left:3px solid var(--ok)}.toast.err{border-left:3px solid var(--err)}.toast.info{border-left:3px solid var(--acc)}
@keyframes tIn{from{transform:translateX(50px);opacity:0}to{transform:none;opacity:1}}

/* TAG */
.tag{display:inline-block;padding:2px 6px;background:var(--s4);border-radius:4px;font-size:10px;color:var(--txt2);margin:1px}

/* PREVIEW */
.pv{flex:1;overflow-y:auto;padding:28px 36px;max-width:820px;margin:0 auto;width:100%;line-height:1.8}
.pv h1,.pv h2,.pv h3{margin:.8em 0 .3em;color:var(--txt)}.pv p{margin-bottom:.8em;color:var(--txt2)}
.pv pre{background:#0a0a18;border-radius:8px;padding:14px;margin:1em 0;overflow-x:auto;border-left:3px solid var(--acc)}
.pv pre code{font-family:var(--mono);font-size:13px;color:#c0caf5}
.pv img{max-width:100%;border-radius:8px;margin:1em 0;display:block}
.pv blockquote{border-left:3px solid var(--acc);padding-left:14px;color:var(--txt2);margin:1em 0}
.pv table{border-collapse:collapse;width:100%;margin:1em 0}.pv td,.pv th{border:1px solid var(--bdr2);padding:7px 10px}.pv th{background:var(--s2);font-weight:700}
.pv video,.pv iframe{max-width:100%;border-radius:8px;margin:1em 0;width:100%;aspect-ratio:16/9}

/* MODAL */
.modal-bg{position:fixed;inset:0;background:rgba(0,0,0,.7);z-index:5000;display:flex;align-items:center;justify-content:center;animation:fadeUp .15s}
.modal{background:var(--s1);border:1px solid var(--bdr2);border-radius:var(--r3);padding:28px;width:90%;max-width:560px;max-height:80vh;overflow-y:auto;box-shadow:0 20px 60px rgba(0,0,0,.5);display:flex;flex-direction:column;gap:14px}
.modal h3{font-size:16px;font-weight:700;color:var(--txt)}
.modal-actions{display:flex;gap:8px;justify-content:flex-end;margin-top:6px}

/* LOADING */
.spin{width:18px;height:18px;border:2.5px solid var(--bdr2);border-top-color:var(--acc);border-radius:50%;animation:sp .7s linear infinite}
@keyframes sp{to{transform:rotate(360deg)}}
.ldg{flex:1;display:flex;align-items:center;justify-content:center;gap:10px;color:var(--txt3);font-size:12px}
.hidden{display:none!important}

/* AI BADGE */
.ai-pulse{animation:aiPulse 2s ease-in-out infinite}
@keyframes aiPulse{0%,100%{box-shadow:0 0 4px rgba(168,85,247,.3)}50%{box-shadow:0 0 16px rgba(168,85,247,.5)}}

/* STATS */
.stats{display:flex;gap:14px;flex-wrap:wrap}
.stat{background:var(--s2);border:1px solid var(--bdr);border-radius:var(--r);padding:14px 18px;min-width:120px;flex:1}
.stat .sv{font-size:22px;font-weight:800;color:var(--acc)}.stat .sl{font-size:10px;color:var(--txt3);text-transform:uppercase;letter-spacing:.04em;margin-top:4px}

/* DIFF BADGE */
.dbadge{display:inline-block;padding:2px 8px;border-radius:4px;font-size:10.5px;font-weight:700;text-transform:uppercase}
.dbadge.easy{background:rgba(16,185,129,.12);color:var(--ok)}.dbadge.medium{background:rgba(245,158,11,.12);color:var(--warn)}
.dbadge.hard{background:rgba(239,68,68,.12);color:var(--err)}.dbadge.expert{background:rgba(168,85,247,.12);color:var(--acc3)}

/* ═══ BLOCK EDITOR ═══ */
.be-wrap{flex:1;overflow-y:auto;padding:20px 0}
.be-inner{max-width:780px;margin:0 auto;padding:0 32px}
.be-gen-bar{display:flex;gap:10px;align-items:center;padding:14px 0;border-bottom:1px solid var(--bdr);margin-bottom:18px}
.be-gen-bar input{flex:1;background:var(--s2);border:1px solid var(--bdr);border-radius:var(--r);padding:10px 14px;color:var(--txt);font-size:13px;outline:none}
.be-gen-bar input:focus{border-color:var(--acc)}

/* Block */
.blk{position:relative;padding:4px 0;margin:2px 0;border-radius:var(--r);transition:background .12s}
.blk:hover{background:rgba(108,92,231,.03)}
.blk:hover>.blk-handle{opacity:1}
.blk-handle{position:absolute;left:-32px;top:8px;width:20px;height:20px;cursor:grab;opacity:0;transition:opacity .12s;display:flex;align-items:center;justify-content:center;color:var(--txt3);font-size:11px;border-radius:4px}
.blk-handle:hover{background:var(--s3);color:var(--txt)}
.blk-handle:active{cursor:grabbing}
.blk.dragging{opacity:.4}
.blk.drag-over{border-top:2px solid var(--acc)}

/* Block content areas */
.blk [contenteditable]{outline:none;min-height:1.4em;line-height:1.7}
.blk [contenteditable]:empty::before{content:attr(data-ph);color:var(--txt3);pointer-events:none}
.blk-heading{font-weight:700;color:var(--txt)}
.blk-heading[data-level="1"]{font-size:28px;margin:8px 0}
.blk-heading[data-level="2"]{font-size:22px;margin:6px 0}
.blk-heading[data-level="3"]{font-size:17px;margin:4px 0}
.blk-para{color:var(--txt2);font-size:14px;line-height:1.8}
.blk-para a{color:var(--acc2)}

/* Code block */
.blk-code-wrap{background:#0a0a18;border:1px solid var(--bdr);border-radius:var(--r);overflow:hidden}
.blk-code-bar{display:flex;align-items:center;gap:8px;padding:5px 10px;background:var(--s2);border-bottom:1px solid var(--bdr);font-size:11px;color:var(--txt3)}
.blk-code-bar select{background:var(--s3);border:1px solid var(--bdr);color:var(--txt2);padding:2px 6px;border-radius:4px;font-size:10px;outline:none}
.blk-code-bar span{flex:1}
.blk-code-bar button{background:none;border:none;color:var(--txt3);cursor:pointer;font-size:10px;padding:2px 6px;border-radius:3px}
.blk-code-bar button:hover{background:var(--s3);color:var(--txt)}
.blk-code{font-family:var(--mono);font-size:13px;color:#c0caf5;padding:12px 14px;min-height:40px;white-space:pre;overflow-x:auto;tab-size:2;line-height:1.6}

/* Callout */
.blk-callout{border-radius:var(--r);padding:12px 16px;display:flex;gap:10px;align-items:flex-start;font-size:13px}
.blk-callout.tip{background:rgba(16,185,129,.06);border-left:3px solid var(--ok);color:var(--ok)}
.blk-callout.info{background:rgba(59,130,246,.06);border-left:3px solid var(--info);color:var(--info)}
.blk-callout.warning{background:rgba(245,158,11,.06);border-left:3px solid var(--warn);color:var(--warn)}
.blk-callout.danger{background:rgba(239,68,68,.06);border-left:3px solid var(--err);color:var(--err)}
.blk-callout-icon{font-size:16px;flex-shrink:0}
.blk-callout [contenteditable]{flex:1;color:var(--txt2)}

/* List block */
.blk-list{padding-left:20px;color:var(--txt2);font-size:14px;line-height:2}
.blk-list li{padding-left:4px}

/* Divider */
.blk-divider{height:1px;background:var(--bdr2);margin:16px 0}

/* Image block */
.blk-img{border-radius:var(--r);overflow:hidden;border:1px solid var(--bdr);background:var(--s2)}
.blk-img img{display:block;max-width:100%;margin:0 auto}
.blk-img-cap{padding:6px 10px;font-size:11px;color:var(--txt3);text-align:center}

/* Animation block */
.blk-anim{border:1px solid var(--bdr2);border-radius:var(--r2);overflow:hidden;background:var(--s1)}
.blk-anim-head{display:flex;align-items:center;gap:8px;padding:8px 12px;background:var(--s2);border-bottom:1px solid var(--bdr);font-size:12px}
.blk-anim-head .anim-tag{background:linear-gradient(135deg,var(--acc),var(--acc3));color:#fff;padding:2px 8px;border-radius:4px;font-size:10px;font-weight:700}
.blk-anim-head span{flex:1;color:var(--txt2)}
.blk-anim-body{min-height:120px;display:flex;align-items:center;justify-content:center;padding:20px;position:relative}
.blk-anim-body.loading{color:var(--txt3);font-size:12px}

/* Diagram block */
.blk-diagram{border:1px solid var(--bdr);border-radius:var(--r);overflow:hidden}
.blk-diagram-head{display:flex;align-items:center;gap:8px;padding:6px 10px;background:var(--s2);border-bottom:1px solid var(--bdr);font-size:11px;color:var(--txt3)}
.blk-diagram-body{padding:16px;background:var(--s1);min-height:80px;display:flex;align-items:center;justify-content:center}
.blk-diagram-body svg{max-width:100%}

/* Quiz block */
.blk-quiz{border:1px solid var(--bdr2);border-radius:var(--r2);padding:16px;background:var(--s2)}
.blk-quiz-q{font-size:14px;font-weight:600;margin-bottom:10px}
.blk-quiz-opts{display:flex;flex-direction:column;gap:6px}
.blk-quiz-opt{display:flex;align-items:center;gap:8px;padding:8px 12px;background:var(--s3);border:1px solid var(--bdr);border-radius:6px;cursor:pointer;font-size:13px;transition:all var(--ease)}
.blk-quiz-opt:hover{border-color:var(--bdr2);background:var(--s4)}
.blk-quiz-opt.correct{border-color:var(--ok);background:rgba(16,185,129,.08)}
.blk-quiz-opt.wrong{border-color:var(--err);background:rgba(239,68,68,.06)}
.blk-quiz-opt .qidx{width:22px;height:22px;border-radius:50%;background:var(--s4);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:var(--txt3);flex-shrink:0}
.blk-quiz-expl{margin-top:8px;padding:8px 10px;background:var(--s3);border-radius:6px;font-size:12px;color:var(--txt2);display:none}

/* Slash command palette */
.slash-pal{position:fixed;z-index:4000;background:var(--s1);border:1px solid var(--bdr2);border-radius:var(--r2);box-shadow:0 12px 40px rgba(0,0,0,.5);width:260px;max-height:320px;overflow-y:auto;padding:6px;animation:fadeUp .12s}
.slash-pal .sp-title{font-size:9px;font-weight:700;color:var(--txt3);text-transform:uppercase;letter-spacing:.06em;padding:6px 8px 3px}
.slash-item{display:flex;align-items:center;gap:10px;padding:7px 10px;border-radius:6px;cursor:pointer;transition:background .1s;font-size:12.5px;color:var(--txt2)}
.slash-item:hover,.slash-item.sel{background:var(--s3);color:var(--txt)}
.slash-item .si-icon{font-size:15px;width:22px;text-align:center;flex-shrink:0}
.slash-item .si-label{font-weight:500;flex:1}
.slash-item .si-desc{font-size:10px;color:var(--txt3)}

/* Block actions (on hover) */
.blk-actions{position:absolute;right:-8px;top:4px;display:flex;gap:2px;opacity:0;transition:opacity .12s}
.blk:hover>.blk-actions{opacity:1}
.blk-act{width:22px;height:22px;border-radius:4px;display:flex;align-items:center;justify-content:center;cursor:pointer;color:var(--txt3);font-size:11px;background:var(--s2);border:1px solid var(--bdr);transition:all .1s}
.blk-act:hover{color:var(--txt);background:var(--s3)}
.blk-act.del:hover{color:var(--err)}

/* Add block button */
.blk-add{display:flex;align-items:center;gap:8px;padding:8px;margin:4px 0;cursor:pointer;color:var(--txt3);font-size:12px;border-radius:6px;transition:all .12s;opacity:0}
.be-inner:hover .blk-add{opacity:.6}
.blk-add:hover{opacity:1!important;background:var(--s3);color:var(--acc)}
</style>
</head>
<body>

<!-- LOGIN -->
<div id="gate">
 <div class="gc">
  <div class="gc-logo"><svg viewBox="0 0 24 24"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg></div>
  <div class="gc-t">Creator Studio</div>
  <div class="gc-s">Nexora professional content workspace</div>
  <input class="gc-i" type="password" id="gp" placeholder="Studio password" autocomplete="current-password"/>
  <button class="gc-b" id="gb" onclick="S.login()">Enter Studio</button>
  <div class="gc-e" id="ge">Invalid password</div>
 </div>
</div>

<!-- APP SHELL -->
<div id="shell">
 <div id="nav">
  <div class="nlogo" onclick="S.sec('welcome')" title="Home">N</div>
  <div class="ndiv"></div>
  <div class="nb on" data-s="cms" onclick="S.sec('cms')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 016.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"/></svg><span class="tip">CMS Courses</span></div>
  <div class="nb" data-s="tutorials" onclick="S.sec('tutorials')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg><span class="tip">Tutorials</span></div>
  <div class="nb" data-s="ailab" onclick="S.sec('ailab')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.22 4.22l2.12 2.12M17.66 17.66l2.12 2.12M2 12h3M19 12h3M4.22 19.78l2.12-2.12M17.66 6.34l2.12-2.12"/></svg><span class="tip">AI Lab</span></div>
  <div class="nb" data-s="forge" onclick="S.sec('forge')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/></svg><span class="tip">Forge</span></div>
  <div class="ndiv"></div>
  <div class="nb" data-s="platform" onclick="S.sec('platform')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg><span class="tip">Platform Problems</span></div>
  <div class="nb" data-s="custom" onclick="S.sec('custom')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/></svg><span class="tip">Custom Problems</span></div>
  <div class="ndiv"></div>
  <div class="nb" data-s="media" onclick="S.sec('media')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg><span class="tip">Media Library</span></div>
  <div class="nsp"></div>
  <div class="nb" onclick="window.open('/','_blank')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg><span class="tip">Open Site</span></div>
 </div>

 <div id="sb">
  <div class="sb-hd"><span class="sb-t" id="stitle">CMS Courses</span><button class="sb-btn" id="sadd" onclick="S.addNew()">+ New</button></div>
  <div class="sb-s"><input id="ssearch" placeholder="Search…" oninput="S.filter(this.value)"/></div>
  <div id="slist"></div>
 </div>

 <div id="mn">
  <div id="topbar"><span id="save-status"></span><span id="tbt">Select an item</span><div id="tba"></div></div>
  <div id="canvas">
   <div class="sec on" id="v-welcome"><div class="welcome">
    <div class="wi">✍️</div>
    <h2>Nexora Creator Studio</h2>
    <p>Professional content management. Pick a section from the left nav, then create or select an item.</p>
    <div id="dash-stats" class="stats" style="margin-top:8px;max-width:600px"></div>
    <div class="wg">
     <div class="wc" onclick="S.sec('cms')"><div class="wci">📚</div><div class="wct">CMS</div><div class="wcs">Courses & lessons</div></div>
     <div class="wc" onclick="S.sec('tutorials')"><div class="wci">🎓</div><div class="wct">Tutorials</div><div class="wcs">Block editor</div></div>
     <div class="wc" onclick="S.sec('ailab')"><div class="wci">🤖</div><div class="wct">AI Lab</div><div class="wcs">AI challenges</div></div>
     <div class="wc" onclick="S.sec('forge')"><div class="wci">🔨</div><div class="wct">Forge</div><div class="wcs">Dev roadmap</div></div>
     <div class="wc" onclick="S.sec('platform')"><div class="wci">🌐</div><div class="wct">Platform</div><div class="wcs">Browse & edit</div></div>
     <div class="wc" onclick="S.sec('custom')"><div class="wci">✏️</div><div class="wct">Custom</div><div class="wcs">Create problems</div></div>
     <div class="wc" onclick="S.sec('media')"><div class="wci">🖼️</div><div class="wct">Media</div><div class="wcs">Files & assets</div></div>
    </div>
   </div></div>

   <div class="sec" id="v-course"><div class="ebody" id="course-body"></div></div>
   <div class="sec" id="v-lesson"><div class="tabs" id="ltabs"></div><div class="ebody" id="lesson-body"></div></div>
   <div class="sec" id="v-tutorial"><div class="tabs" id="ttabs"></div><div id="tut-body" style="flex:1;overflow:hidden;display:flex;flex-direction:column"></div></div>
   <div class="sec" id="v-ailab"><div class="ebody" id="ai-body"></div></div>
   <div class="sec" id="v-forge"><div class="ebody" id="fg-body"></div></div>
   <div class="sec" id="v-platform"><div class="split">
    <div class="split-l">
     <div style="padding:8px 10px;border-bottom:1px solid var(--bdr);display:flex;gap:6px;flex-shrink:0">
      <input id="plat-q" placeholder="Search problems…" style="flex:1;background:var(--s2);border:1px solid var(--bdr);border-radius:6px;padding:6px 10px;color:var(--txt);font-size:12px;outline:none" onkeydown="if(event.key==='Enter')S.platLoad()"/>
      <button class="btn sm" onclick="S.platLoad()">Go</button>
     </div>
     <div id="plat-list" style="flex:1;overflow-y:auto;padding:4px"></div>
     <div class="pgn"><button class="btn sm" onclick="S.platPage(-1)">‹</button><span class="pi" id="plat-info">—</span><button class="btn sm" onclick="S.platPage(1)">›</button></div>
    </div>
    <div class="split-r"><div class="ebody" id="plat-ed"><div style="color:var(--txt3);font-size:13px;margin:auto">Select a problem →</div></div></div>
   </div></div>
   <div class="sec" id="v-custom"><div class="ebody" id="cp-body"></div></div>
   <div class="sec" id="v-media"><div class="ebody" id="media-body"></div></div>
  </div>
 </div>
</div>

<div id="toasts"></div>
<div id="modal-root"></div>
<div id="slash-root"></div>

<script>
'use strict';
const $ = id => document.getElementById(id);
const $$ = (sel, ctx) => (ctx||document).querySelectorAll(sel);
const h = s => (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
let _bid = 0;
const bid = () => 'b'+(++_bid);

const S = {
  token: localStorage.getItem('nx_tk')||'',
  courses: [],
  cur: {sec:'cms',courseId:null,lessonId:null,lesson:null,tutId:null,aiId:null,fgTopic:null,cpId:null,platId:null},
  plat: {list:[],total:0,off:0,lim:50},
  quills: {},
  monacos: {},
  monacoReady: false,
  blocks: [],          // current tutorial blocks
  _autoTimer: null,
  _tutDirty: false,
  _qlTB: [[{header:[1,2,3,false]}],['bold','italic','underline','strike','blockquote','code-block'],[{color:[]},{background:[]}],[{list:'ordered'},{list:'bullet'}],[{indent:'-1'},{indent:'+1'}],['link','image','video'],[{align:[]}],['clean']],

  // ── API ──
  async api(path, opts={}) {
    try {
      const isForm = opts.body instanceof FormData;
      const r = await fetch(path, {
        method: opts.method||'GET',
        headers: isForm ? {'x-studio-token':this.token} : {'Content-Type':'application/json','x-studio-token':this.token},
        body: isForm ? opts.body : (opts.body ? JSON.stringify(opts.body) : undefined)
      });
      const d = await r.json();
      if (!d.ok && d.error) this.toast(d.error,'err');
      return d;
    } catch(e) { this.toast('Network error: '+e.message,'err'); return {ok:false,error:e.message}; }
  },

  toast(msg, type='info') {
    const icons = {ok:'✓',err:'✕',info:'ℹ'};
    const el = document.createElement('div');
    el.className = 'toast '+type;
    el.innerHTML = `<span>${icons[type]||'ℹ'}</span><span>${msg}</span>`;
    $('toasts').appendChild(el);
    setTimeout(()=>{el.style.opacity='0';setTimeout(()=>el.remove(),200)},3500);
  },

  modal(title, bodyHTML, actions=[]) {
    return new Promise(resolve => {
      const bg = document.createElement('div');
      bg.className = 'modal-bg';
      bg.innerHTML = `<div class="modal"><h3>${title}</h3><div class="modal-body">${bodyHTML}</div><div class="modal-actions"></div></div>`;
      const actsDiv = bg.querySelector('.modal-actions');
      actions.forEach(a => {
        const b = document.createElement('button');
        b.className = 'btn '+(a.cls||'');
        b.textContent = a.label;
        b.onclick = () => { bg.remove(); resolve(a.value); };
        actsDiv.appendChild(b);
      });
      bg.addEventListener('click', e => { if(e.target===bg){bg.remove();resolve(null);} });
      $('modal-root').appendChild(bg);
      const fi = bg.querySelector('input,select,textarea');
      if (fi) setTimeout(()=>fi.focus(),50);
    });
  },

  async prompt(title, fields) {
    const html = fields.map(f => {
      if (f.type==='select') return `<div class="fd"><label>${f.label}</label><select id="mp-${f.id}">${f.options.map(o=>`<option value="${o}" ${o===f.value?'selected':''}>${o}</option>`).join('')}</select></div>`;
      if (f.type==='textarea') return `<div class="fd"><label>${f.label}</label><textarea id="mp-${f.id}" placeholder="${f.placeholder||''}">${f.value||''}</textarea></div>`;
      return `<div class="fd"><label>${f.label}</label><input id="mp-${f.id}" type="${f.type||'text'}" value="${h(f.value||'')}" placeholder="${f.placeholder||''}"/></div>`;
    }).join('');
    return new Promise(resolve => {
      const bg = document.createElement('div');
      bg.className = 'modal-bg';
      bg.innerHTML = `<div class="modal"><h3>${title}</h3>${html}<div class="modal-actions"><button class="btn" id="mp-cancel">Cancel</button><button class="btn p" id="mp-ok">Confirm</button></div></div>`;
      bg.querySelector('#mp-cancel').onclick = ()=>{bg.remove();resolve(null)};
      bg.querySelector('#mp-ok').onclick = ()=>{
        const vals = {};
        fields.forEach(f=>{ vals[f.id] = bg.querySelector('#mp-'+f.id)?.value||''; });
        bg.remove();
        resolve(vals);
      };
      bg.addEventListener('click', e=>{if(e.target===bg){bg.remove();resolve(null)}});
      bg.addEventListener('keydown', e=>{if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();bg.querySelector('#mp-ok').click()}});
      $('modal-root').appendChild(bg);
      setTimeout(()=>bg.querySelector('input,select,textarea')?.focus(),50);
    });
  },

  // ── Auth ──
  _loginAttempts: 0,
  async login(auto) {
    const pass = $('gp').value.trim();
    if (!pass) return;
    const btn = $('gb');
    const err = $('ge');
    btn.disabled = true; btn.textContent = 'Connecting…';
    err.style.display = 'none';
    try {
      const controller = new AbortController();
      const timeout = setTimeout(()=>controller.abort(), 8000);
      const r = await fetch('/api/studio/courses',{headers:{'x-studio-token':pass},signal:controller.signal});
      clearTimeout(timeout);
      if (r.status===401) {
        localStorage.removeItem('nx_tk');
        err.textContent = 'Invalid password';
        err.style.display = 'block';
        btn.disabled = false; btn.textContent = 'Enter Studio';
        return;
      }
      if (!r.ok) throw new Error('Server returned HTTP '+r.status);
      const d = await r.json();
      if (!d.ok) throw new Error(d.error||'Server rejected');
      this.token = pass;
      this._loginAttempts = 0;
      localStorage.setItem('nx_tk', pass);
      this.courses = d.courses||[];
      $('gate').style.display = 'none';
      $('shell').classList.add('on');
      this._init();
    } catch(e) {
      console.error('Studio login failed:', e);
      const isNetwork = e.name==='AbortError'||e.name==='TypeError'||e.message.includes('fetch');
      if (isNetwork && auto && this._loginAttempts < 3) {
        this._loginAttempts++;
        btn.textContent = 'Retrying ('+this._loginAttempts+'/3)…';
        setTimeout(()=>this.login(true), 2000);
        return;
      }
      if (isNetwork) {
        err.textContent = 'Cannot reach server — is it running?';
      } else {
        err.textContent = 'Login failed: '+e.message;
        localStorage.removeItem('nx_tk');
      }
      err.style.display = 'block';
      btn.disabled = false; btn.textContent = 'Enter Studio';
    }
  },

  _init() {
    this._loadQuillCSS();
    this._loadQuillJS(()=>{});
    this._loadMonaco();
    this._loadMermaid();
    this.sec('cms');
    this._initDrop();
    this._loadDashboard();
  },

  _loadQuillCSS() {
    if (document.querySelector('link[href*="quill"]')) return;
    const lk = document.createElement('link');
    lk.rel = 'stylesheet'; lk.href = 'https://cdn.quilljs.com/1.3.7/quill.snow.css';
    document.head.appendChild(lk);
  },
  _loadQuillJS(cb) {
    if (window.Quill) { cb(); return; }
    const sc = document.createElement('script');
    sc.src = 'https://cdn.quilljs.com/1.3.7/quill.min.js';
    sc.onload = cb;
    sc.onerror = ()=>{ this.toast('Quill CDN failed','err'); cb(); };
    document.head.appendChild(sc);
  },
  _loadMonaco() {
    const sc = document.createElement('script');
    sc.src = 'https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.47.0/min/vs/loader.js';
    sc.onload = ()=>{
      window.require.config({paths:{vs:'https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.47.0/min/vs'}});
      window.require(['vs/editor/editor.main'],()=>{
        this.monacoReady = true;
        monaco.editor.defineTheme('nexora',{base:'vs-dark',inherit:true,rules:[{background:'07070f'}],colors:{'editor.background':'#0c0c1a','editor.lineHighlightBackground':'#111125','editorLineNumber.foreground':'#252555','editor.selectionBackground':'#353570'}});
        monaco.editor.setTheme('nexora');
      });
    };
    sc.onerror = ()=>this.toast('Monaco CDN failed','err');
    document.head.appendChild(sc);
  },
  _loadMermaid() {
    if (window.mermaid) return;
    const sc = document.createElement('script');
    sc.src = 'https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js';
    sc.onload = ()=>{ mermaid.initialize({startOnLoad:false,theme:'dark',themeVariables:{primaryColor:'#6c5ce7',primaryTextColor:'#e2e8f0',lineColor:'#454590',secondaryColor:'#111125'}}); };
    document.head.appendChild(sc);
  },
  _initDrop() { document.addEventListener('dragover', e=>e.preventDefault()); },

  async _loadDashboard() {
    const stats = $('dash-stats');
    if (!stats) return;
    const [tut,ai] = await Promise.all([this.api('/api/studio/tutorials'),this.api('/api/studio/ai-problems-list')]);
    stats.innerHTML = `<div class="stat"><div class="sv">${this.courses.length}</div><div class="sl">Courses</div></div><div class="stat"><div class="sv">${tut.total||0}</div><div class="sl">Tutorials</div></div><div class="stat"><div class="sv">${ai.total||0}</div><div class="sl">AI Problems</div></div>`;
  },

  mkQuill(el, placeholder) {
    if (!window.Quill) return null;
    if (typeof el === 'string') el = $(el);
    if (!el || el._q) return el?._q || null;
    const q = new Quill(el, {theme:'snow', placeholder:placeholder||'Write content…', modules:{toolbar:this._qlTB}});
    q.getModule('toolbar').addHandler('image', ()=>{
      const url = window.prompt('Image URL:');
      if (url) { const r=q.getSelection(true)||{index:0}; q.insertEmbed(r.index,'image',url); }
    });
    q.getModule('toolbar').addHandler('video', ()=>{
      const url = window.prompt('Video / YouTube URL:');
      if (url) { const yt = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([A-Za-z0-9_-]+)/); const emb = yt ? `https://www.youtube.com/embed/${yt[1]}` : url; const r=q.getSelection(true)||{index:0}; q.insertEmbed(r.index,'video',emb); }
    });
    el._q = q;
    return q;
  },

  mkMonaco(el, opts={}) {
    if (!this.monacoReady) return null;
    if (typeof el === 'string') el = $(el);
    if (!el) return null;
    return monaco.editor.create(el, {value:opts.value||'',language:opts.lang||'python',theme:'nexora',minimap:{enabled:false},fontSize:opts.fontSize||13,scrollBeyondLastLine:false,automaticLayout:true,lineNumbers:'on',roundedSelection:true,padding:{top:8},...opts});
  },

  async aiAssist(type, promptText) {
    this.toast('AI generating…','info');
    const d = await this.api('/api/studio/ai-assist',{method:'POST',body:{type,prompt:promptText}});
    if (d.ok) { this.toast('AI content generated!','ok'); return d.text; }
    return null;
  },

  // ── Section switching ──
  sec(name) {
    const titles = {cms:'CMS Courses',tutorials:'Tutorials',ailab:'AI Lab',forge:'The Forge',platform:'Platform Problems',custom:'Custom Problems',media:'Media Library',welcome:'Home'};
    const canAdd = ['cms','tutorials','ailab','custom'];
    this.cur.sec = name;
    $$('.nb[data-s]').forEach(n=>n.classList.toggle('on',n.dataset.s===name));
    $('stitle').textContent = titles[name]||name;
    $('sadd').style.display = canAdd.includes(name)?'':'none';
    $('ssearch').value = '';
    $('save-status').textContent = '';
    this.topbar('Select an item',[]);
    this._show('welcome');
    if (name==='cms') this.cmsLoad();
    else if (name==='tutorials') this.tutLoad();
    else if (name==='ailab') this.aiLoad();
    else if (name==='forge') this.forgeLoad();
    else if (name==='platform') { this._show('platform'); this.platLoad(); }
    else if (name==='custom') this.cpLoad();
    else if (name==='media') { this._show('media'); this.mediaLoad(); }
  },

  _show(v) { $$('.sec').forEach(s=>s.classList.toggle('on',s.id==='v-'+v)); },

  topbar(title, actions) {
    $('tbt').textContent = title;
    const bar = $('tba');
    bar.innerHTML = '';
    actions.forEach(a=>{
      const b = document.createElement('button');
      b.className = 'btn '+(a.cls||'');
      b.textContent = a.label;
      b.onclick = a.fn;
      bar.appendChild(b);
    });
  },

  addNew() {
    const s = this.cur.sec;
    if (s==='cms') this.cmsNewCourse();
    else if (s==='tutorials') this.tutNew();
    else if (s==='ailab') this.aiNew();
    else if (s==='custom') this.cpNew();
  },

  filter(q) {
    const lo = q.toLowerCase();
    $$('#slist .th, #slist .tleaf, #slist .pr').forEach(el=>{
      el.style.display = (!q||el.textContent.toLowerCase().includes(lo))?'':'none';
    });
  },

  // ═══ CMS ═══
  async cmsRefresh() {
    const d = await this.api('/api/studio/courses');
    if (d.ok) this.courses = d.courses||[];
    this.cmsRender();
  },
  cmsLoad() { this.cmsRender(); },
  cmsRender() {
    const list = $('slist');
    if (!this.courses.length) {
      list.innerHTML = '<div style="padding:16px;text-align:center;color:var(--txt3);font-size:12px">No courses yet.<br><br><button class="btn sm p" onclick="S.cmsNewCourse()">Create First Course</button></div>';
      return;
    }
    let html = '';
    this.courses.forEach(c => {
      const sel = this.cur.courseId===c.id;
      html += `<div class="th ${sel?'sel open':''}" onclick="S.cmsSelect(${c.id})"><span class="ta">▶</span><span class="ti">${c.icon||'📚'}</span><span class="tl">${h(c.title)}</span><span class="tp ${c.published?'y':'n'}"></span></div>`;
      html += `<div class="tc ${sel?'open':''}">`;
      (c.chapters||[]).forEach(ch => {
        html += `<div class="th" onclick="event.stopPropagation();this.classList.toggle('open');this.nextElementSibling.classList.toggle('open')"><span class="ta">▶</span><span class="tl" style="color:var(--txt2);font-size:12px">${h(ch.title)}</span><span class="tg">${(ch.lessons||[]).length}</span></div>`;
        html += '<div class="tc">';
        (ch.lessons||[]).forEach(l => {
          html += `<div class="tleaf ${this.cur.lessonId===l.id?'sel':''}" onclick="event.stopPropagation();S.lessonSelect(${l.id},${ch.id},${c.id})"><span class="td"></span><span style="flex:1">${h(l.title)}</span><span class="tp ${l.published?'y':'n'}"></span></div>`;
        });
        html += `<div class="tadd" onclick="event.stopPropagation();S.cmsNewLesson(${ch.id},${c.id})"><span>+</span> Add lesson</div></div>`;
      });
      html += `<div class="tadd" onclick="event.stopPropagation();S.cmsNewChapter(${c.id})"><span>+</span> Add chapter</div></div>`;
    });
    list.innerHTML = html;
  },

  async cmsNewCourse() {
    const r = await this.prompt('New Course',[{id:'title',label:'Course Title',placeholder:'e.g. Data Structures'},{id:'icon',label:'Icon Emoji',value:'📚'},{id:'section',label:'Section',type:'select',options:['learn','forge','ai'],value:'learn'}]);
    if (!r||!r.title?.trim()) return;
    const d = await this.api('/api/studio/courses',{method:'POST',body:{title:r.title.trim(),icon:r.icon||'📚',section:r.section}});
    if (d.ok) { this.toast('Course created!','ok'); await this.cmsRefresh(); this.cmsSelect(d.id); }
  },

  async cmsSelect(id) {
    this.cur.courseId = id; this.cur.lessonId = null;
    const c = this.courses.find(x=>x.id===id);
    if (!c) return;
    this.cmsRender(); this._show('course');
    this.topbar('📚 '+c.title,[{label:'💾 Save',cls:'p',fn:()=>S.cmsSave()},{label:'Delete',cls:'d',fn:()=>S.cmsDel()}]);
    const COLS = ['#6c5ce7','#00cec9','#a855f7','#10b981','#f59e0b','#ef4444','#3b82f6','#ec4899','#f97316','#06b6d4','#8b5cf6','#e11d48'];
    $('course-body').innerHTML = `
      <div class="stt">Course Settings</div>
      <div class="frow"><div class="fd"><label>Title</label><input id="cs-t" value="${h(c.title)}"/></div><div class="fd"><label>Icon</label><input id="cs-i" value="${h(c.icon||'📚')}" style="max-width:80px"/></div></div>
      <div class="fd"><label>Description</label><textarea id="cs-d">${h(c.description||'')}</textarea></div>
      <div class="frow"><div class="fd"><label>Section</label><select id="cs-sec"><option value="learn" ${c.section==='learn'?'selected':''}>Learn</option><option value="forge" ${c.section==='forge'?'selected':''}>Forge</option><option value="ai" ${c.section==='ai'?'selected':''}>AI Lab</option></select></div><div class="fd"><label>Order</label><input type="number" id="cs-o" value="${c.order_idx||0}" min="0"/></div><div class="fd"><label>Status</label><select id="cs-p"><option value="0" ${!c.published?'selected':''}>Draft</option><option value="1" ${c.published?'selected':''}>Published</option></select></div></div>
      <div class="fd"><label>Color</label><div class="cpick">${COLS.map(col=>`<div class="csw ${c.color===col?'on':''}" style="background:${col}" onclick="$$('.csw').forEach(s=>s.classList.remove('on'));this.classList.add('on');this.dataset.v='${col}'" data-v="${col}"></div>`).join('')}</div></div>
      <div class="stt">Chapters</div>
      <div id="cs-chs">${(c.chapters||[]).map(ch=>`<div style="display:flex;align-items:center;gap:8px;background:var(--s2);border:1px solid var(--bdr);border-radius:6px;padding:8px 10px;margin-bottom:6px"><span style="flex:1;font-size:12.5px;font-weight:500">${h(ch.title)}</span><span class="tg">${(ch.lessons||[]).length} lessons</span><button class="btn sm d" onclick="S.cmsDlCh(${ch.id})">Delete</button></div>`).join('')||'<div style="color:var(--txt3);font-size:12px">No chapters yet.</div>'}</div>
      <button class="btn sm" onclick="S.cmsNewChapter(${c.id})" style="align-self:flex-start">+ Add Chapter</button>`;
  },

  async cmsSave() {
    const c = this.courses.find(x=>x.id===this.cur.courseId); if (!c) return;
    const color = document.querySelector('.csw.on')?.dataset?.v || c.color;
    const d = await this.api(`/api/studio/courses/${c.id}`,{method:'PUT',body:{title:$('cs-t')?.value,description:$('cs-d')?.value,icon:$('cs-i')?.value||'📚',color,section:$('cs-sec')?.value,order_idx:+($('cs-o')?.value||0),published:+($('cs-p')?.value||0)}});
    if (d.ok) { this.toast('Course saved!','ok'); await this.cmsRefresh(); }
  },

  async cmsDel() {
    if (!this.cur.courseId) return;
    const r = await this.modal('Delete Course?','<p style="color:var(--txt2)">This will delete ALL chapters and lessons.</p>',[{label:'Cancel',value:false},{label:'Delete',cls:'d',value:true}]);
    if (!r) return;
    const d = await this.api(`/api/studio/courses/${this.cur.courseId}`,{method:'DELETE'});
    if (d.ok) { this.toast('Deleted','ok'); this.cur.courseId=null; await this.cmsRefresh(); this._show('welcome'); this.topbar('Select an item',[]); }
  },

  async cmsNewChapter(courseId) {
    const r = await this.prompt('New Chapter',[{id:'title',label:'Chapter Title',placeholder:'e.g. Linked Lists'}]);
    if (!r||!r.title?.trim()) return;
    const d = await this.api('/api/studio/chapters',{method:'POST',body:{course_id:courseId,title:r.title.trim()}});
    if (d.ok) { this.toast('Chapter created!','ok'); await this.cmsRefresh(); this.cmsSelect(courseId); }
  },

  async cmsDlCh(id) {
    const r = await this.modal('Delete Chapter?','<p style="color:var(--txt2)">Deletes chapter and all lessons.</p>',[{label:'Cancel',value:false},{label:'Delete',cls:'d',value:true}]);
    if (!r) return;
    const d = await this.api(`/api/studio/chapters/${id}`,{method:'DELETE'});
    if (d.ok) { this.toast('Deleted','ok'); await this.cmsRefresh(); this.cmsSelect(this.cur.courseId); }
  },

  async cmsNewLesson(chapterId, courseId) {
    const r = await this.prompt('New Lesson',[{id:'title',label:'Lesson Title',placeholder:'e.g. Introduction to Queues'}]);
    if (!r||!r.title?.trim()) return;
    const d = await this.api('/api/studio/lessons',{method:'POST',body:{chapter_id:chapterId,title:r.title.trim(),duration_min:15}});
    if (d.ok) { this.toast('Lesson created!','ok'); await this.cmsRefresh(); this.lessonSelect(d.id,chapterId,courseId); }
  },

  // ── Lesson ──
  async lessonSelect(id, chapterId, courseId) {
    this.cur.lessonId = id; this.cur.courseId = courseId; this.cmsRender();
    const d = await this.api(`/api/studio/lessons/${id}`);
    if (!d.ok) return;
    this.cur.lesson = d.lesson;
    this._show('lesson');
    this.topbar('📖 '+d.lesson.title,[{label:'💾 Save',cls:'p',fn:()=>S.lessonSave()},{label:d.lesson.published?'✓ Published':'Publish',cls:d.lesson.published?'ok':'',fn:()=>S.lessonTogglePub()},{label:'🤖 AI Write',cls:'ai',fn:()=>S.lessonAI()},{label:'Delete',cls:'d',fn:()=>S.lessonDel()}]);
    this.lessonTab('content');
  },

  lessonTab(tab) {
    const tabs = ['content','problems','settings','preview'];
    $('ltabs').innerHTML = tabs.map(t=>`<div class="tab ${t===tab?'on':''}" onclick="S.lessonTab('${t}')">${t[0].toUpperCase()+t.slice(1)}</div>`).join('');
    const body = $('lesson-body');
    const ls = this.cur.lesson; if (!ls) return;
    if (tab==='content') {
      body.innerHTML = `<div class="fd"><label>Lesson Title</label><input id="ls-t" value="${h(ls.title||'')}"/></div><div class="fd"><label>Content</label><div class="ql-wrap"><div id="ls-ql"></div></div></div>`;
      const q = this.mkQuill('ls-ql','Write lesson content…');
      if (q) { q.root.innerHTML = ls.content||''; this.quills._lesson = q; }
    } else if (tab==='problems') {
      body.innerHTML = `<div style="display:flex;align-items:center;gap:10px;margin-bottom:6px"><span class="stt" style="flex:1;border:none;padding:0">Linked Problems</span><button class="btn sm p" onclick="S.lessonLink()">+ Link Problem</button></div><div id="lk-probs">${(ls.linked_problems||[]).map(lp=>`<div class="pr" style="cursor:default;margin-bottom:4px"><span class="tag">${lp.platform||'custom'}</span><span class="pt">${h(lp.title||lp.cp_title||'—')}</span><span class="pd">${lp.rating||lp.cp_rating||'—'}</span><button class="btn sm d" onclick="S.lessonUnlink(${lp.id})">✕</button></div>`).join('')||'<div style="color:var(--txt3);font-size:12px">No linked problems.</div>'}</div>`;
    } else if (tab==='settings') {
      body.innerHTML = `<div class="frow"><div class="fd"><label>Title</label><input id="lss-t" value="${h(ls.title||'')}"/></div><div class="fd"><label>Duration (min)</label><input type="number" id="lss-d" value="${ls.duration_min||10}"/></div><div class="fd"><label>Order</label><input type="number" id="lss-o" value="${ls.order_idx||0}"/></div></div><div class="fd" style="max-width:180px"><label>Status</label><select id="lss-p"><option value="0" ${!ls.published?'selected':''}>Draft</option><option value="1" ${ls.published?'selected':''}>Published</option></select></div><button class="btn p" onclick="S.lessonSaveSettings()" style="align-self:flex-start">Save Settings</button>`;
    } else if (tab==='preview') {
      body.innerHTML = `<div class="pv">${this.quills._lesson?.root.innerHTML||ls.content||''}</div>`;
    }
  },

  async lessonSave() {
    if (!this.cur.lessonId) return;
    const title = $('ls-t')?.value||this.cur.lesson?.title;
    const content = this.quills._lesson?.root.innerHTML||'';
    const d = await this.api(`/api/studio/lessons/${this.cur.lessonId}`,{method:'PUT',body:{title,content}});
    if (d.ok) { this.toast('Saved!','ok'); if(this.cur.lesson){this.cur.lesson.title=title;this.cur.lesson.content=content;} await this.cmsRefresh(); }
  },
  async lessonSaveSettings() {
    if (!this.cur.lessonId) return;
    const body = {title:$('lss-t')?.value,duration_min:+($('lss-d')?.value),order_idx:+($('lss-o')?.value),published:+($('lss-p')?.value)};
    const d = await this.api(`/api/studio/lessons/${this.cur.lessonId}`,{method:'PUT',body});
    if (d.ok) { this.toast('Settings saved!','ok'); Object.assign(this.cur.lesson,body); await this.cmsRefresh(); }
  },
  async lessonTogglePub() {
    if (!this.cur.lessonId||!this.cur.lesson) return;
    const nv = this.cur.lesson.published?0:1;
    const d = await this.api(`/api/studio/lessons/${this.cur.lessonId}`,{method:'PUT',body:{published:nv}});
    if (d.ok) { this.cur.lesson.published=nv; this.toast(nv?'Published!':'Draft','ok'); await this.cmsRefresh();
      this.topbar('📖 '+this.cur.lesson.title,[{label:'💾 Save',cls:'p',fn:()=>S.lessonSave()},{label:nv?'✓ Published':'Publish',cls:nv?'ok':'',fn:()=>S.lessonTogglePub()},{label:'🤖 AI Write',cls:'ai',fn:()=>S.lessonAI()},{label:'Delete',cls:'d',fn:()=>S.lessonDel()}]);
    }
  },
  async lessonDel() {
    const r = await this.modal('Delete Lesson?','<p style="color:var(--txt2)">Cannot be undone.</p>',[{label:'Cancel',value:false},{label:'Delete',cls:'d',value:true}]);
    if (!r) return;
    const d = await this.api(`/api/studio/lessons/${this.cur.lessonId}`,{method:'DELETE'});
    if (d.ok) { this.toast('Deleted','ok'); this.cur.lessonId=null; await this.cmsRefresh(); this._show('welcome'); this.topbar('Select an item',[]); }
  },
  async lessonLink() {
    const r = await this.prompt('Link a Problem',[{id:'q',label:'Search by title',placeholder:'Type problem name…'}]);
    if (!r||!r.q) return;
    const d = await this.api(`/api/studio/search-problems?q=${encodeURIComponent(r.q)}`);
    if (!d.ok||!d.results?.length) { this.toast('No results','info'); return; }
    const pick = await this.modal('Select Problem',d.results.map((p,i)=>`<div class="pr" style="margin-bottom:4px" onclick="document.querySelectorAll('.modal .pr').forEach(x=>x.classList.remove('sel'));this.classList.add('sel');this.dataset.idx='${i}'"><span class="tag">${p.platform||'custom'}</span><span class="pt">${h(p.title)}</span><span class="pd">${p.rating||'—'}</span></div>`).join(''),[{label:'Cancel',value:null},{label:'Link',cls:'p',value:'link'}]);
    if (pick!=='link') return;
    const selEl = document.querySelector('.modal .pr.sel');
    const idx = selEl ? +selEl.dataset.idx : 0;
    const p = d.results[idx]; if (!p) return;
    const body = p.platform==='custom'?{custom_problem_id:p.id}:{problem_id:p.id};
    const res = await this.api(`/api/studio/lessons/${this.cur.lessonId}/problems`,{method:'POST',body});
    if (res.ok) { this.toast('Linked!','ok'); const ld=await this.api(`/api/studio/lessons/${this.cur.lessonId}`); if(ld.ok){this.cur.lesson=ld.lesson;this.lessonTab('problems');} }
  },
  async lessonUnlink(linkId) {
    const d = await this.api(`/api/studio/lessons/${this.cur.lessonId}/problems/${linkId}`,{method:'DELETE'});
    if (d.ok) { this.toast('Unlinked','ok'); const ld=await this.api(`/api/studio/lessons/${this.cur.lessonId}`); if(ld.ok){this.cur.lesson=ld.lesson;this.lessonTab('problems');} }
  },
  async lessonAI() {
    const r = await this.prompt('AI Generate Lesson',[{id:'prompt',label:'What should it teach?',type:'textarea',placeholder:'e.g. Explain binary search trees with Python examples…'}]);
    if (!r||!r.prompt) return;
    const text = await this.aiAssist('tutorial',r.prompt);
    if (text && this.quills._lesson) { this.quills._lesson.root.innerHTML = text; this.toast('Content inserted','ok'); }
  },

  // ═══════════════════════════════════════════════════
  // TUTORIALS — BLOCK EDITOR
  // ═══════════════════════════════════════════════════

  async tutLoad() {
    const list = $('slist');
    list.innerHTML = '<div class="ldg"><div class="spin"></div> Loading…</div>';
    const d = await this.api('/api/studio/tutorials');
    if (!d.ok) { list.innerHTML='<div style="color:var(--err);padding:12px">Failed</div>'; return; }
    const g = d.grouped||{};
    let html = '';
    for (const [cat, items] of Object.entries(g)) {
      html += `<div class="th" onclick="this.classList.toggle('open');this.nextElementSibling.classList.toggle('open')"><span class="ta">▶</span><span class="tl" style="font-weight:700">${h(cat)}</span><span class="tg">${items.length}</span></div><div class="tc">`;
      items.forEach(t=>{ html += `<div class="tleaf ${this.cur.tutId===t.id?'sel':''}" onclick="S.tutSelect(${t.id})">${h(t.title)}</div>`; });
      html += '</div>';
    }
    list.innerHTML = html||'<div style="color:var(--txt3);padding:16px;font-size:12px;text-align:center">No tutorials yet.</div>';
  },

  async tutSelect(id) {
    this.cur.tutId = id;
    const d = await this.api(`/api/studio/tutorials/${id}`);
    if (!d.ok) return;
    const t = d.tutorial;
    this._tutData = t;
    this._show('tutorial');
    this.topbar('🎓 '+t.title,[
      {label:'💾 Save',cls:'p',fn:()=>S.tutSave()},
      {label:'🤖 AI Full Tutorial',cls:'ai',fn:()=>S.tutAIGenerate()},
      {label:'Delete',cls:'d',fn:()=>S.tutDel()}
    ]);
    this.tutTab('edit', t);
  },

  tutTab(tab, tut) {
    if (tut) this._tutData = tut;
    const t = this._tutData; if (!t) return;
    $('ttabs').innerHTML = ['edit','settings','preview'].map(x=>`<div class="tab ${x===tab?'on':''}" onclick="S.tutTab('${x}')">${x[0].toUpperCase()+x.slice(1)}</div>`).join('');
    const body = $('tut-body');

    if (tab==='edit') {
      // Parse blocks from content
      let blocks = [];
      try {
        const parsed = JSON.parse(t.content||'[]');
        if (Array.isArray(parsed)) blocks = parsed;
      } catch(e) {
        // Legacy HTML content → wrap in single paragraph block
        if (t.content && t.content.trim()) {
          blocks = [{id:bid(),type:'paragraph',html:t.content}];
        }
      }
      this.blocks = blocks.map(b => ({...b, id: b.id||bid()}));
      body.innerHTML = `<div class="be-wrap"><div class="be-inner">
        <div class="be-gen-bar">
          <input id="be-gen-input" placeholder="Describe a topic and AI will generate a full tutorial with blocks…"/>
          <button class="btn ai" onclick="S.tutAIGenerate()">✨ Generate</button>
        </div>
        <div id="be-blocks"></div>
        <div class="blk-add" onclick="S.beAddBlock(null,'paragraph')">+ Add block &nbsp;·&nbsp; type <kbd style="background:var(--s4);padding:1px 5px;border-radius:3px;font-size:10px">/</kbd> for commands</div>
      </div></div>`;
      this.beRender();
    } else if (tab==='settings') {
      body.innerHTML = `<div class="ebody">
        <div class="frow"><div class="fd"><label>Title</label><input id="tt-t" value="${h(t.title||'')}"/></div><div class="fd"><label>Category</label><input id="tt-c" value="${h(t.category||'')}"/></div><div class="fd"><label>Topic Slug</label><input id="tt-tp" value="${h(t.topic||'')}"/></div></div>
        <div class="frow"><div class="fd"><label>Difficulty</label><select id="tt-d"><option ${t.difficulty==='Beginner'?'selected':''}>Beginner</option><option ${t.difficulty==='Intermediate'?'selected':''}>Intermediate</option><option ${t.difficulty==='Advanced'?'selected':''}>Advanced</option></select></div><div class="fd"><label>Est. Time (min)</label><input type="number" id="tt-tm" value="${t.estimated_time||20}"/></div><div class="fd"><label>Order</label><input type="number" id="tt-o" value="${t.order_index||0}"/></div></div>
        <div class="fd"><label>Description</label><textarea id="tt-ds">${h(t.description||'')}</textarea></div>
        <button class="btn p" onclick="S.tutSaveSettings()" style="align-self:flex-start;margin-top:8px">Save Settings</button>
      </div>`;
    } else if (tab==='preview') {
      body.innerHTML = `<div class="pv">${this.beToHTML()}</div>`;
      // Render mermaid diagrams in preview
      setTimeout(()=>{if(window.mermaid)mermaid.run({nodes:body.querySelectorAll('.mermaid')})},100);
    }
  },

  // ── Block Rendering ──
  beRender() {
    const container = $('be-blocks');
    if (!container) return;
    container.innerHTML = '';
    this.blocks.forEach((b,i) => {
      container.appendChild(this.beBlockEl(b,i));
    });
  },

  beBlockEl(block, idx) {
    const div = document.createElement('div');
    div.className = 'blk';
    div.dataset.id = block.id;
    div.draggable = true;
    div.addEventListener('dragstart', e => { e.dataTransfer.setData('text/plain',block.id); div.classList.add('dragging'); });
    div.addEventListener('dragend', () => div.classList.remove('dragging'));
    div.addEventListener('dragover', e => { e.preventDefault(); div.classList.add('drag-over'); });
    div.addEventListener('dragleave', () => div.classList.remove('drag-over'));
    div.addEventListener('drop', e => { e.preventDefault(); div.classList.remove('drag-over'); this.beMoveDrop(e.dataTransfer.getData('text/plain'),block.id); });

    // Handle + actions
    div.innerHTML = `<div class="blk-handle" title="Drag to reorder">⠿</div><div class="blk-actions"><div class="blk-act" onclick="S.beAddBlock('${block.id}','paragraph')" title="Add below">+</div><div class="blk-act del" onclick="S.beDelBlock('${block.id}')" title="Delete">✕</div></div>`;
    const content = document.createElement('div');

    switch(block.type) {
      case 'heading':
        const he = document.createElement('div');
        he.className = 'blk-heading';
        he.contentEditable = true;
        he.dataset.ph = 'Heading…';
        he.dataset.level = block.level||2;
        he.textContent = block.text||'';
        he.addEventListener('input', ()=>{ block.text=he.textContent; this.beDirty(); });
        he.addEventListener('keydown', e=>this.beKeyHandler(e,block));
        content.appendChild(he);
        break;

      case 'paragraph':
        const pe = document.createElement('div');
        pe.className = 'blk-para';
        pe.contentEditable = true;
        pe.dataset.ph = 'Type / for commands, or just start writing…';
        pe.innerHTML = block.html||'';
        pe.addEventListener('input', ()=>{ block.html=pe.innerHTML; this.beDirty(); });
        pe.addEventListener('keydown', e=>this.beKeyHandler(e,block));
        content.appendChild(pe);
        break;

      case 'code':
        const cw = document.createElement('div');
        cw.className = 'blk-code-wrap';
        cw.innerHTML = `<div class="blk-code-bar"><select onchange="S.beUpdBlock('${block.id}','language',this.value)">${['python','javascript','cpp','java','c','go','rust','typescript','html','css','sql','bash'].map(l=>`<option ${block.language===l?'selected':''}>${l}</option>`).join('')}</select><span>${block.caption||''}</span><button onclick="navigator.clipboard.writeText(this.closest('.blk-code-wrap').querySelector('.blk-code').textContent);S.toast('Copied!','ok')">Copy</button></div>`;
        const ce = document.createElement('div');
        ce.className = 'blk-code';
        ce.contentEditable = true;
        ce.spellcheck = false;
        ce.textContent = block.code||'';
        ce.addEventListener('input', ()=>{ block.code=ce.textContent; this.beDirty(); });
        ce.addEventListener('keydown', e=>{
          if(e.key==='Tab'){e.preventDefault();document.execCommand('insertText',false,'  ');}
        });
        cw.appendChild(ce);
        content.appendChild(cw);
        break;

      case 'callout':
        const variant = block.variant||'tip';
        const icons = {tip:'💡',info:'ℹ️',warning:'⚠️',danger:'🚨'};
        const co = document.createElement('div');
        co.className = 'blk-callout '+variant;
        co.innerHTML = `<span class="blk-callout-icon">${icons[variant]||'💡'}</span>`;
        const cte = document.createElement('div');
        cte.contentEditable = true;
        cte.dataset.ph = `${variant} callout…`;
        cte.textContent = block.text||'';
        cte.addEventListener('input', ()=>{ block.text=cte.textContent; this.beDirty(); });
        cte.addEventListener('keydown', e=>this.beKeyHandler(e,block));
        co.appendChild(cte);
        content.appendChild(co);
        break;

      case 'list':
        const tag = block.ordered?'ol':'ul';
        const le = document.createElement(tag);
        le.className = 'blk-list';
        le.contentEditable = true;
        (block.items||['Item 1']).forEach(it => {
          const li = document.createElement('li');
          li.textContent = it;
          le.appendChild(li);
        });
        le.addEventListener('input', ()=>{
          block.items = [...le.querySelectorAll('li')].map(li=>li.textContent);
          this.beDirty();
        });
        content.appendChild(le);
        break;

      case 'divider':
        content.innerHTML = '<div class="blk-divider"></div>';
        break;

      case 'image':
        const img = document.createElement('div');
        img.className = 'blk-img';
        img.innerHTML = `${block.url?`<img src="${h(block.url)}" alt="${h(block.alt||'')}"/>`:'<div style="padding:24px;text-align:center;color:var(--txt3);cursor:pointer" onclick="S.beImgPick(\''+block.id+'\')">Click to add image URL</div>'}<div class="blk-img-cap" contenteditable data-ph="Caption…">${h(block.caption||'')}</div>`;
        const capEl = img.querySelector('.blk-img-cap');
        if(capEl) capEl.addEventListener('input',()=>{block.caption=capEl.textContent;this.beDirty();});
        content.appendChild(img);
        break;

      case 'animation':
      case 'animation_prompt':
        const an = document.createElement('div');
        an.className = 'blk-anim';
        an.innerHTML = `<div class="blk-anim-head"><span class="anim-tag">✨ Animation</span><span>${h(block.title||block.prompt||'')}</span><button class="btn sm ai" onclick="S.beGenAnim('${block.id}')">Generate</button></div>`;
        const abody = document.createElement('div');
        abody.className = 'blk-anim-body';
        if (block.html && block.css) {
          const scope = 'anim-'+block.id;
          abody.innerHTML = `<style>${block.css.replace(/\.anim-\w+/g,'.'+scope)}</style><div class="${scope}">${block.html}</div>`;
        } else {
          abody.classList.add('loading');
          abody.innerHTML = `<span>Click "Generate" to create animation for: "${h(block.prompt||'')}"</span>`;
        }
        an.appendChild(abody);
        content.appendChild(an);
        break;

      case 'diagram':
      case 'diagram_prompt':
        const dg = document.createElement('div');
        dg.className = 'blk-diagram';
        dg.innerHTML = `<div class="blk-diagram-head"><span>📊 Diagram</span><span style="flex:1"></span><button class="btn sm ai" onclick="S.beGenDiagram('${block.id}')">Generate</button></div>`;
        const dbody = document.createElement('div');
        dbody.className = 'blk-diagram-body';
        if (block.mermaid) {
          dbody.innerHTML = `<pre class="mermaid">${h(block.mermaid)}</pre>`;
          setTimeout(()=>{if(window.mermaid)mermaid.run({nodes:dbody.querySelectorAll('.mermaid')})},50);
        } else {
          dbody.innerHTML = `<span style="color:var(--txt3);font-size:12px">Click "Generate" for: "${h(block.prompt||'')}"</span>`;
        }
        dg.appendChild(dbody);
        content.appendChild(dg);
        break;

      case 'quiz':
        const qz = document.createElement('div');
        qz.className = 'blk-quiz';
        qz.innerHTML = `<div class="blk-quiz-q">${h(block.question||'Question?')}</div><div class="blk-quiz-opts">${(block.options||[]).map((o,i)=>`<div class="blk-quiz-opt" onclick="S.beQuizAnswer(this,${i},${block.answer||0})"><span class="qidx">${String.fromCharCode(65+i)}</span><span>${h(o)}</span></div>`).join('')}</div><div class="blk-quiz-expl">${h(block.explanation||'')}</div>`;
        content.appendChild(qz);
        break;

      default:
        content.innerHTML = `<div style="color:var(--txt3);font-size:12px;padding:8px">Unknown block type: ${block.type}</div>`;
    }

    div.appendChild(content);
    return div;
  },

  beQuizAnswer(el, picked, correct) {
    const parent = el.closest('.blk-quiz');
    parent.querySelectorAll('.blk-quiz-opt').forEach((o,i) => {
      o.classList.remove('correct','wrong');
      if (i===correct) o.classList.add('correct');
      else if (i===picked && picked!==correct) o.classList.add('wrong');
    });
    parent.querySelector('.blk-quiz-expl').style.display = 'block';
  },

  beKeyHandler(e, block) {
    const el = e.target;
    // Slash commands
    if (e.key==='/' && (el.textContent==='' || el.textContent==='/')) {
      e.preventDefault();
      this.beShowSlash(el, block);
      return;
    }
    // Enter in heading -> new paragraph
    if (e.key==='Enter' && !e.shiftKey && block.type==='heading') {
      e.preventDefault();
      this.beAddBlock(block.id,'paragraph');
    }
    // Backspace on empty -> delete block
    if (e.key==='Backspace' && el.textContent==='' && this.blocks.length>1) {
      e.preventDefault();
      const idx = this.blocks.findIndex(b=>b.id===block.id);
      this.beDelBlock(block.id);
      // Focus previous block
      if (idx>0) {
        const prev = $('be-blocks')?.children[idx-1];
        const ed = prev?.querySelector('[contenteditable]');
        if (ed) { ed.focus(); const range=document.createRange();const sel=window.getSelection();range.selectNodeContents(ed);range.collapse(false);sel.removeAllRanges();sel.addRange(range); }
      }
    }
  },

  // ── Slash Command Palette ──
  beShowSlash(el, block) {
    this.beCloseSlash();
    const rect = el.getBoundingClientRect();
    const pal = document.createElement('div');
    pal.className = 'slash-pal';
    pal.id = 'slash-pal';
    pal.style.left = rect.left+'px';
    pal.style.top = (rect.bottom+4)+'px';

    const items = [
      {cat:'Basic',entries:[
        {icon:'📝',label:'Paragraph',desc:'Plain text',type:'paragraph'},
        {icon:'📌',label:'Heading 1',desc:'Large heading',type:'heading',data:{level:1}},
        {icon:'📌',label:'Heading 2',desc:'Medium heading',type:'heading',data:{level:2}},
        {icon:'📌',label:'Heading 3',desc:'Small heading',type:'heading',data:{level:3}},
        {icon:'📋',label:'Bulleted List',desc:'Unordered list',type:'list',data:{ordered:false}},
        {icon:'🔢',label:'Numbered List',desc:'Ordered list',type:'list',data:{ordered:true}},
        {icon:'➖',label:'Divider',desc:'Horizontal rule',type:'divider'},
      ]},
      {cat:'Rich',entries:[
        {icon:'💻',label:'Code Block',desc:'Syntax highlighted',type:'code',data:{language:'python'}},
        {icon:'💡',label:'Tip Callout',desc:'Helpful tip',type:'callout',data:{variant:'tip'}},
        {icon:'ℹ️',label:'Info Callout',desc:'Information note',type:'callout',data:{variant:'info'}},
        {icon:'⚠️',label:'Warning',desc:'Warning callout',type:'callout',data:{variant:'warning'}},
        {icon:'🖼️',label:'Image',desc:'Add an image',type:'image'},
      ]},
      {cat:'AI Powered',entries:[
        {icon:'✨',label:'AI Animation',desc:'Generate animation',type:'animation_prompt',ai:true},
        {icon:'📊',label:'AI Diagram',desc:'Generate diagram',type:'diagram_prompt',ai:true},
        {icon:'❓',label:'AI Quiz',desc:'Generate quiz question',type:'quiz',ai:true},
        {icon:'🤖',label:'AI Write',desc:'AI writes content',type:'_ai_write',ai:true},
        {icon:'💻',label:'AI Code',desc:'AI generates code',type:'_ai_code',ai:true},
      ]}
    ];

    let selIdx = 0;
    let allEntries = [];
    let html = '';
    items.forEach(cat => {
      html += `<div class="sp-title">${cat.cat}</div>`;
      cat.entries.forEach(e => {
        const i = allEntries.length;
        html += `<div class="slash-item ${i===0?'sel':''}" data-idx="${i}"><span class="si-icon">${e.icon}</span><span class="si-label">${e.label}</span><span class="si-desc">${e.desc}</span></div>`;
        allEntries.push(e);
      });
    });
    pal.innerHTML = html;

    // Click handler
    pal.querySelectorAll('.slash-item').forEach(item => {
      item.addEventListener('click', () => {
        const idx = +item.dataset.idx;
        this.beSlashPick(allEntries[idx], block);
        this.beCloseSlash();
      });
    });

    // Keyboard nav
    const keyHandler = e => {
      if (e.key==='Escape') { this.beCloseSlash(); e.preventDefault(); return; }
      if (e.key==='ArrowDown') { e.preventDefault(); selIdx=Math.min(selIdx+1,allEntries.length-1); pal.querySelectorAll('.slash-item').forEach((it,i)=>it.classList.toggle('sel',i===selIdx)); pal.querySelectorAll('.slash-item')[selIdx]?.scrollIntoView({block:'nearest'}); return; }
      if (e.key==='ArrowUp') { e.preventDefault(); selIdx=Math.max(selIdx-1,0); pal.querySelectorAll('.slash-item').forEach((it,i)=>it.classList.toggle('sel',i===selIdx)); return; }
      if (e.key==='Enter') { e.preventDefault(); this.beSlashPick(allEntries[selIdx],block); this.beCloseSlash(); return; }
    };
    document.addEventListener('keydown', keyHandler);
    pal._keyHandler = keyHandler;

    // Close on click outside
    setTimeout(()=>{
      const closeHandler = e => { if (!pal.contains(e.target)) { this.beCloseSlash(); } };
      document.addEventListener('click', closeHandler, {once:true});
    },10);

    $('slash-root').appendChild(pal);
  },

  beCloseSlash() {
    const pal = $('slash-pal');
    if (pal) {
      if (pal._keyHandler) document.removeEventListener('keydown', pal._keyHandler);
      pal.remove();
    }
  },

  async beSlashPick(entry, currentBlock) {
    // AI types need a prompt
    if (entry.type==='_ai_write') {
      const r = await this.prompt('AI Write',[{id:'prompt',label:'What to write?',type:'textarea',placeholder:'e.g. Explain how hash tables work…'}]);
      if (!r||!r.prompt) return;
      const text = await this.aiAssist('tutorial',r.prompt);
      if (text) { currentBlock.type='paragraph'; currentBlock.html=text; this.beRender(); this.beDirty(); }
      return;
    }
    if (entry.type==='_ai_code') {
      const r = await this.prompt('AI Code',[{id:'prompt',label:'What code to generate?',type:'textarea',placeholder:'e.g. Binary search in Python with comments…'}]);
      if (!r||!r.prompt) return;
      const text = await this.aiAssist('code',r.prompt);
      if (text) {
        try {
          const d = JSON.parse(text);
          this.beReplaceBlock(currentBlock.id,{id:bid(),type:'code',language:d.language||'python',code:d.code||text,caption:d.explanation||''});
        } catch { this.beReplaceBlock(currentBlock.id,{id:bid(),type:'code',language:'python',code:text}); }
        this.beRender(); this.beDirty();
      }
      return;
    }
    if (entry.ai && (entry.type==='animation_prompt'||entry.type==='diagram_prompt'||entry.type==='quiz')) {
      const labels = {animation_prompt:'Describe the animation',diagram_prompt:'Describe the diagram',quiz:'What topic for the quiz?'};
      const r = await this.prompt('AI Prompt',[{id:'prompt',label:labels[entry.type]||'Describe…',type:'textarea',placeholder:'e.g. Visualize how quicksort partitions an array'}]);
      if (!r||!r.prompt) return;
      const newBlock = {id:bid(),type:entry.type,prompt:r.prompt,...(entry.data||{})};
      this.beReplaceBlock(currentBlock.id,newBlock);
      this.beRender(); this.beDirty();
      // Auto-generate
      if (entry.type==='animation_prompt') this.beGenAnim(newBlock.id);
      else if (entry.type==='diagram_prompt') this.beGenDiagram(newBlock.id);
      else if (entry.type==='quiz') this.beGenQuiz(newBlock.id, r.prompt);
      return;
    }

    // Replace current empty block or insert after
    const newBlock = {id:bid(),type:entry.type,...(entry.data||{})};
    if (currentBlock.type==='paragraph' && !(currentBlock.html||'').trim()) {
      this.beReplaceBlock(currentBlock.id, newBlock);
    } else {
      this.beInsertAfter(currentBlock.id, newBlock);
    }
    this.beRender();
    this.beDirty();
    // Focus new block
    setTimeout(()=>{
      const el = document.querySelector(`[data-id="${newBlock.id}"] [contenteditable]`);
      if (el) el.focus();
    },50);
  },

  // ── Block CRUD ──
  beAddBlock(afterId, type, data={}) {
    const newBlock = {id:bid(),type,...data};
    if (afterId) {
      this.beInsertAfter(afterId,newBlock);
    } else {
      this.blocks.push(newBlock);
    }
    this.beRender();
    this.beDirty();
    setTimeout(()=>{
      const el = document.querySelector(`[data-id="${newBlock.id}"] [contenteditable]`);
      if (el) el.focus();
    },50);
  },

  beInsertAfter(afterId, block) {
    const idx = this.blocks.findIndex(b=>b.id===afterId);
    if (idx===-1) this.blocks.push(block);
    else this.blocks.splice(idx+1,0,block);
  },

  beReplaceBlock(id, newBlock) {
    const idx = this.blocks.findIndex(b=>b.id===id);
    if (idx!==-1) this.blocks[idx] = newBlock;
  },

  beDelBlock(id) {
    this.blocks = this.blocks.filter(b=>b.id!==id);
    if (!this.blocks.length) this.blocks.push({id:bid(),type:'paragraph',html:''});
    this.beRender();
    this.beDirty();
  },

  beUpdBlock(id, key, val) {
    const b = this.blocks.find(x=>x.id===id);
    if (b) { b[key]=val; this.beDirty(); }
  },

  beMoveDrop(fromId, toId) {
    if (fromId===toId) return;
    const fi = this.blocks.findIndex(b=>b.id===fromId);
    if (fi===-1) return;
    const [block] = this.blocks.splice(fi,1);
    const ti = this.blocks.findIndex(b=>b.id===toId);
    this.blocks.splice(ti,0,block);
    this.beRender();
    this.beDirty();
  },

  beImgPick(blockId) {
    const url = window.prompt('Image URL (use Media Library):');
    if (url) { this.beUpdBlock(blockId,'url',url); this.beRender(); }
  },

  // ── AI Generation for blocks ──
  async beGenAnim(blockId) {
    const b = this.blocks.find(x=>x.id===blockId);
    if (!b) return;
    const prompt = b.prompt || b.title || 'Create an educational animation';
    this.toast('Generating animation…','info');
    const text = await this.aiAssist('animation', prompt);
    if (!text) return;
    try {
      const d = JSON.parse(text);
      b.type = 'animation';
      b.html = d.html||'';
      b.css = d.css||'';
      b.title = d.title||b.prompt||'';
      this.beRender(); this.beDirty();
    } catch(e) { this.toast('Failed to parse animation: '+e.message,'err'); }
  },

  async beGenDiagram(blockId) {
    const b = this.blocks.find(x=>x.id===blockId);
    if (!b) return;
    const prompt = b.prompt || 'Create a technical diagram';
    this.toast('Generating diagram…','info');
    const text = await this.aiAssist('diagram', prompt);
    if (!text) return;
    b.type = 'diagram';
    b.mermaid = text.replace(/```mermaid\n?/g,'').replace(/```/g,'').trim();
    this.beRender(); this.beDirty();
  },

  async beGenQuiz(blockId, prompt) {
    this.toast('Generating quiz…','info');
    const text = await this.aiAssist('quiz', prompt||'Generate a quiz question');
    if (!text) return;
    try {
      const arr = JSON.parse(text);
      const q = Array.isArray(arr) ? arr[0] : arr;
      const b = this.blocks.find(x=>x.id===blockId);
      if (b) {
        b.type = 'quiz';
        b.question = q.question;
        b.options = q.options;
        b.answer = q.answer;
        b.explanation = q.explanation;
        this.beRender(); this.beDirty();
      }
    } catch(e) { this.toast('Failed to parse quiz','err'); }
  },

  // ── Auto-save ──
  beDirty() {
    this._tutDirty = true;
    $('save-status').textContent = '● Unsaved';
    $('save-status').style.color = 'var(--warn)';
    clearTimeout(this._autoTimer);
    this._autoTimer = setTimeout(()=>this.tutAutoSave(), 2000);
  },

  async tutAutoSave() {
    if (!this._tutDirty || !this.cur.tutId) return;
    $('save-status').textContent = '⟳ Saving…';
    $('save-status').style.color = 'var(--txt3)';
    const content = JSON.stringify(this.blocks);
    const d = await this.api(`/api/studio/tutorials/${this.cur.tutId}`,{method:'PUT',body:{content}});
    if (d.ok) {
      this._tutDirty = false;
      $('save-status').textContent = '✓ Saved';
      $('save-status').style.color = 'var(--ok)';
      setTimeout(()=>{ if($('save-status').textContent==='✓ Saved') $('save-status').textContent=''; },2000);
    } else {
      $('save-status').textContent = '✕ Save failed';
      $('save-status').style.color = 'var(--err)';
    }
  },

  // ── Blocks → HTML (for preview and for saving as display) ──
  beToHTML() {
    return this.blocks.map(b => {
      switch(b.type) {
        case 'heading': return `<h${b.level||2}>${h(b.text||'')}</h${b.level||2}>`;
        case 'paragraph': return b.html||'';
        case 'code': return `<pre><code class="language-${b.language||'python'}">${h(b.code||'')}</code></pre>`;
        case 'callout': return `<blockquote style="border-left:3px solid ${b.variant==='danger'?'#ef4444':b.variant==='warning'?'#f59e0b':b.variant==='info'?'#3b82f6':'#10b981'};padding-left:14px">${b.variant==='tip'?'💡':b.variant==='warning'?'⚠️':b.variant==='danger'?'🚨':'ℹ️'} ${h(b.text||'')}</blockquote>`;
        case 'list': return `<${b.ordered?'ol':'ul'}>${(b.items||[]).map(i=>'<li>'+h(i)+'</li>').join('')}</${b.ordered?'ol':'ul'}>`;
        case 'divider': return '<hr/>';
        case 'image': return `<figure><img src="${h(b.url||'')}" alt="${h(b.alt||'')}"/>${b.caption?'<figcaption>'+h(b.caption)+'</figcaption>':''}</figure>`;
        case 'animation': return b.html && b.css ? `<div><style>${b.css}</style>${b.html}</div>` : '';
        case 'diagram': return b.mermaid ? `<pre class="mermaid">${h(b.mermaid)}</pre>` : '';
        case 'quiz': return `<div class="quiz-block"><p><strong>${h(b.question||'')}</strong></p><ol type="A">${(b.options||[]).map((o,i)=>`<li${i===b.answer?' style="font-weight:bold;color:#10b981"':''}>${h(o)}</li>`).join('')}</ol><p><em>${h(b.explanation||'')}</em></p></div>`;
        default: return '';
      }
    }).join('\n');
  },

  // ── Tutorial Save / AI / Delete ──
  async tutSave() {
    if (!this.cur.tutId) return;
    const content = JSON.stringify(this.blocks);
    const title = $('tt-t')?.value || this._tutData?.title;
    const d = await this.api(`/api/studio/tutorials/${this.cur.tutId}`,{method:'PUT',body:{content,title}});
    if (d.ok) { this._tutDirty=false; this.toast('Tutorial saved!','ok'); $('save-status').textContent='✓ Saved'; $('save-status').style.color='var(--ok)'; if(this._tutData)this._tutData.content=content; await this.tutLoad(); }
  },

  async tutSaveSettings() {
    if (!this.cur.tutId) return;
    const body = {title:$('tt-t')?.value,category:$('tt-c')?.value,topic:$('tt-tp')?.value,difficulty:$('tt-d')?.value,estimated_time:$('tt-tm')?.value,order_index:+($('tt-o')?.value||0),description:$('tt-ds')?.value};
    const d = await this.api(`/api/studio/tutorials/${this.cur.tutId}`,{method:'PUT',body});
    if (d.ok) { this.toast('Settings saved!','ok'); Object.assign(this._tutData,body); await this.tutLoad(); }
  },

  async tutNew() {
    const r = await this.prompt('New Tutorial',[{id:'title',label:'Title',placeholder:'Tutorial title'},{id:'category',label:'Category',placeholder:'e.g. arrays'},{id:'topic',label:'Topic slug',placeholder:'e.g. arrays-basics'}]);
    if (!r||!r.title?.trim()) return;
    const d = await this.api('/api/studio/tutorials',{method:'POST',body:{title:r.title.trim(),category:r.category||'general',topic:r.topic||r.title.trim().toLowerCase().replace(/\s+/g,'-'),difficulty:'Beginner',order_index:0,estimated_time:'20 min',content:'[]'}});
    if (d.ok) { this.toast('Created!','ok'); await this.tutLoad(); this.tutSelect(d.id); }
  },

  async tutDel() {
    const r = await this.modal('Delete Tutorial?','<p style="color:var(--txt2)">Cannot be undone.</p>',[{label:'Cancel',value:false},{label:'Delete',cls:'d',value:true}]);
    if (!r) return;
    const d = await this.api(`/api/studio/tutorials/${this.cur.tutId}`,{method:'DELETE'});
    if (d.ok) { this.toast('Deleted','ok'); this.cur.tutId=null; await this.tutLoad(); this._show('welcome'); this.topbar('Select an item',[]); }
  },

  async tutAIGenerate() {
    const inputEl = $('be-gen-input');
    let topic = inputEl?.value?.trim() || '';
    if (!topic) {
      const r = await this.prompt('AI Generate Full Tutorial',[{id:'topic',label:'Topic',type:'textarea',placeholder:'e.g. Binary Search Trees - concepts, implementation, and applications'}]);
      if (!r||!r.topic) return;
      topic = r.topic;
    }
    this.toast('AI generating full tutorial… This may take a moment.','info');
    const text = await this.aiAssist('blocks', topic);
    if (!text) return;
    try {
      let parsed = JSON.parse(text);
      if (!Array.isArray(parsed)) throw new Error('not array');
      this.blocks = parsed.map(b=>({...b,id:bid()}));
      this.beRender();
      this.beDirty();
      this.toast('Tutorial generated with '+this.blocks.length+' blocks!','ok');
    } catch(e) {
      this.toast('Failed to parse AI response: '+e.message,'err');
      console.error('AI blocks parse error:',e,text);
    }
  },

  // ═══ AI LAB ═══
  async aiLoad() {
    const list = $('slist');
    list.innerHTML = '<div class="ldg"><div class="spin"></div> Loading…</div>';
    const d = await this.api('/api/studio/ai-problems-list');
    if (!d.ok) { list.innerHTML='<div style="color:var(--err);padding:12px">Failed</div>'; return; }
    const g = d.grouped||{};
    let html = '';
    for (const [cat,items] of Object.entries(g)) {
      html += `<div class="th" onclick="this.classList.toggle('open');this.nextElementSibling.classList.toggle('open')"><span class="ta">▶</span><span class="tl" style="font-weight:700">${h(cat)}</span><span class="tg">${items.length}</span></div><div class="tc">`;
      items.forEach(p=>{ html += `<div class="tleaf ${this.cur.aiId===p.id?'sel':''}" onclick="S.aiSelect(${p.id})">${h(p.title)}</div>`; });
      html += '</div>';
    }
    list.innerHTML = html||'<div style="color:var(--txt3);padding:16px;font-size:12px;text-align:center">No AI problems yet.</div>';
  },

  async aiSelect(id) {
    this.cur.aiId = id;
    const d = await this.api(`/api/studio/ai-problems/${id}`);
    if (!d.ok) return;
    const p = d.problem;
    this._show('ailab');
    this.topbar('🤖 '+p.title,[{label:'💾 Save',cls:'p',fn:()=>S.aiSave()},{label:'🤖 AI Generate',cls:'ai',fn:()=>S.aiGenerate()},{label:'Delete',cls:'d',fn:()=>S.aiDel()}]);
    $('ai-body').innerHTML = `
      <div class="frow"><div class="fd"><label>Title</label><input id="ai-t" value="${h(p.title||'')}"/></div><div class="fd"><label>Category</label><input id="ai-c" value="${h(p.category||'')}"/></div></div>
      <div class="frow"><div class="fd"><label>Difficulty</label><select id="ai-d"><option ${p.difficulty==='Easy'?'selected':''}>Easy</option><option ${p.difficulty==='Medium'||p.difficulty==='beginner'?'selected':''}>Medium</option><option ${p.difficulty==='Hard'?'selected':''}>Hard</option><option ${p.difficulty==='Expert'?'selected':''}>Expert</option></select></div><div class="fd"><label>Tags</label><input id="ai-tg" value="${h(p.tags||'')}"/></div></div>
      <div class="fd"><label>Description</label><div class="ql-wrap"><div id="ai-ql"></div></div></div>
      <div class="frow2"><div class="fd"><label>Input Format</label><textarea id="ai-if">${h(p.input_format||'')}</textarea></div><div class="fd"><label>Output Format</label><textarea id="ai-of">${h(p.output_format||'')}</textarea></div></div>
      <div class="fd"><label>Constraints</label><textarea id="ai-cn">${h(p.constraints||'')}</textarea></div>
      <div class="fd"><label>Starter Code</label><div class="mwrap"><div class="mbar"><label>Language</label><select id="ai-lang" onchange="S.aiLang(this.value)"><option value="python">Python</option><option value="javascript">JavaScript</option><option value="cpp">C++</option><option value="java">Java</option></select><span style="flex:1"></span></div><div class="mbody" id="ai-mce" style="height:200px"></div></div></div>
      <div class="frow2"><div class="fd"><label>Solution Approach</label><textarea id="ai-sa">${h(p.solution_approach||'')}</textarea></div><div class="fd"><label>Hints (one per line)</label><textarea id="ai-hn">${h(p.hints||'')}</textarea></div></div>
      <div class="fd"><label>Samples JSON</label><textarea id="ai-smp" style="font-family:var(--mono);font-size:12px">${h(p.samples||'[]')}</textarea></div>
      <div class="fd"><label>Resources JSON</label><textarea id="ai-res" style="font-family:var(--mono);font-size:12px">${h(p.resources||'[]')}</textarea></div>`;
    const q = this.mkQuill('ai-ql','Describe the problem…');
    if (q) { q.root.innerHTML = p.description||''; this.quills._ai = q; }
    if (this.monacoReady) { setTimeout(()=>{ if(this.monacos._ai)this.monacos._ai.dispose(); this.monacos._ai = this.mkMonaco('ai-mce',{value:p.starter_code||'# starter code\n',lang:'python'}); },100); }
  },

  aiLang(lang) { if(this.monacos._ai&&this.monacoReady){monaco.editor.setModelLanguage(this.monacos._ai.getModel(),lang);} },

  async aiSave() {
    if (!this.cur.aiId) return;
    const body = {title:$('ai-t')?.value,category:$('ai-c')?.value,difficulty:$('ai-d')?.value,tags:$('ai-tg')?.value,description:this.quills._ai?.root.innerHTML||'',input_format:$('ai-if')?.value,output_format:$('ai-of')?.value,constraints:$('ai-cn')?.value,starter_code:this.monacos._ai?.getValue()||'',solution_approach:$('ai-sa')?.value,hints:$('ai-hn')?.value,samples:$('ai-smp')?.value,resources:$('ai-res')?.value};
    const d = await this.api(`/api/studio/ai-problems/${this.cur.aiId}`,{method:'PUT',body});
    if (d.ok) { this.toast('AI problem saved!','ok'); await this.aiLoad(); }
  },

  async aiNew() {
    const r = await this.prompt('New AI Problem',[{id:'title',label:'Problem Title',placeholder:'e.g. Fibonacci Solver'},{id:'category',label:'Category',placeholder:'e.g. dp'}]);
    if (!r||!r.title?.trim()) return;
    const d = await this.api('/api/studio/ai-problems-new',{method:'POST',body:{title:r.title.trim(),category:r.category||'general',difficulty:'Medium'}});
    if (d.ok) { this.toast('Created!','ok'); await this.aiLoad(); this.aiSelect(d.id); }
  },

  async aiDel() {
    const r = await this.modal('Delete AI Problem?','<p style="color:var(--txt2)">Cannot be undone.</p>',[{label:'Cancel',value:false},{label:'Delete',cls:'d',value:true}]);
    if (!r) return;
    const d = await this.api(`/api/studio/ai-problems/${this.cur.aiId}`,{method:'DELETE'});
    if (d.ok) { this.toast('Deleted','ok'); this.cur.aiId=null; await this.aiLoad(); this._show('welcome'); this.topbar('Select an item',[]); }
  },

  async aiGenerate() {
    const title = $('ai-t')?.value||'';
    const r = await this.prompt('AI Generate Problem',[{id:'prompt',label:'Describe the problem',type:'textarea',placeholder:`Generate a problem about: ${title}`}]);
    if (!r||!r.prompt) return;
    const text = await this.aiAssist('problem',r.prompt);
    if (text&&this.quills._ai) { this.quills._ai.root.innerHTML = text; this.toast('Generated!','ok'); }
  },

  // ═══ FORGE ═══
  async forgeLoad() {
    const list = $('slist');
    list.innerHTML = '<div class="ldg"><div class="spin"></div> Loading…</div>';
    const d = await this.api('/api/studio/forge');
    if (!d.ok) { list.innerHTML='<div style="color:var(--err);padding:12px">Failed</div>'; return; }
    this._forgePaths = d.paths||[];
    let html = '';
    (d.paths||[]).forEach(p=>{
      html += `<div class="th" onclick="this.classList.toggle('open');this.nextElementSibling.classList.toggle('open')"><span class="ta">▶</span><span class="ti">${p.icon||'🔨'}</span><span class="tl" style="font-weight:700">${h(p.title)}</span></div><div class="tc">`;
      (p.milestones||[]).forEach(m=>{
        html += `<div class="th" onclick="this.classList.toggle('open');this.nextElementSibling.classList.toggle('open')"><span class="ta">▶</span><span class="tl" style="color:var(--txt2);font-size:12px">${h(m.title)}</span><span class="tg">${m.topics.length}</span></div><div class="tc">`;
        m.topics.forEach(t=>{ html += `<div class="tleaf" onclick="S.forgeSelect('${t.id}','${p.id}')"><span style="font-size:7px;opacity:.5">${t.has_override?'●':'○'}</span><span style="flex:1">${h(t.title)}</span></div>`; });
        html += '</div>';
      });
      html += '</div>';
    });
    list.innerHTML = html;
  },

  async forgeSelect(topicId, pathId) {
    const d = await this.api(`/api/studio/forge/${topicId}`);
    if (!d.ok) return;
    this.cur.fgTopic = {id:topicId,pathId};
    const ov = d.override||{}, st = d.static||{};
    this._show('forge');
    this.topbar('🔨 '+(ov.title||st.title||topicId),[{label:'💾 Save',cls:'p',fn:()=>S.forgeSave()}]);
    $('fg-body').innerHTML = `
      <div class="frow"><div class="fd"><label>Topic ID</label><input value="${h(topicId)}" readonly style="opacity:.45"/></div><div class="fd"><label>Title Override</label><input id="fg-t" value="${h(ov.title||'')}"/></div></div>
      <div class="frow"><div class="fd"><label>Difficulty Override</label><select id="fg-d"><option value="">— default —</option><option ${ov.difficulty==='Beginner'?'selected':''}>Beginner</option><option ${ov.difficulty==='Intermediate'?'selected':''}>Intermediate</option><option ${ov.difficulty==='Advanced'?'selected':''}>Advanced</option></select></div><div class="fd"><label>Time Estimate</label><input id="fg-tm" value="${h(ov.time_estimate||'')}"/></div></div>
      <div class="fd"><label>Description Override</label><textarea id="fg-ds">${h(ov.description||'')}</textarea></div>
      <div class="fd"><label>Rich Content</label><div class="ql-wrap"><div id="fg-ql"></div></div></div>`;
    const q = this.mkQuill('fg-ql','Write content…');
    if (q) { q.root.innerHTML = ov.content_html||''; this.quills._forge = q; }
  },

  async forgeSave() {
    if (!this.cur.fgTopic) return;
    const body = {path_id:this.cur.fgTopic.pathId,title:$('fg-t')?.value||null,description:$('fg-ds')?.value||null,content_html:this.quills._forge?.root.innerHTML||null,difficulty:$('fg-d')?.value||null,time_estimate:$('fg-tm')?.value||null};
    const d = await this.api(`/api/studio/forge/${this.cur.fgTopic.id}`,{method:'PUT',body});
    if (d.ok) { this.toast('Saved!','ok'); await this.forgeLoad(); }
  },

  // ═══ PLATFORM ═══
  async platLoad(offset) {
    offset = offset ?? this.plat.off;
    const q = $('plat-q')?.value||'';
    const list = $('plat-list');
    list.innerHTML = '<div class="ldg"><div class="spin"></div></div>';
    const d = await this.api(`/api/studio/all-problems?q=${encodeURIComponent(q)}&limit=${this.plat.lim}&offset=${offset}`);
    if (!d.ok) { list.innerHTML='<div style="color:var(--err);padding:12px">Failed</div>'; return; }
    this.plat.list=d.problems; this.plat.total=d.total; this.plat.off=offset;
    list.innerHTML = d.problems.map(p=>{
      const dc=p.rating>=2200?'dx':p.rating>=1600?'dh':p.rating>=1200?'dm':'de';
      return `<div class="pr ${this.cur.platId===p.id?'sel':''}" onclick="S.platSelect(${p.id})" style="margin-bottom:4px"><div style="flex:1"><div class="pt">${h(p.title)}</div><div class="pm">${p.platform} · ${p.tags||'—'}</div></div><span class="pd ${dc}">${p.rating||'—'}</span></div>`;
    }).join('')||'<div style="color:var(--txt3);padding:16px;font-size:12px">No results</div>';
    $('plat-info').textContent=`${offset+1}–${Math.min(offset+this.plat.lim,d.total)} of ${d.total}`;
  },
  platPage(dir) { this.platLoad(Math.max(0,this.plat.off+dir*this.plat.lim)); },

  platSelect(id) {
    const p = this.plat.list.find(x=>x.id===id); if (!p) return;
    this.cur.platId = id;
    $$('#plat-list .pr').forEach(r=>r.classList.toggle('sel',r.onclick.toString().includes(id)));
    this.topbar('🌐 '+p.title,[{label:'💾 Save',cls:'p',fn:()=>S.platSave(id)}]);
    $('plat-ed').innerHTML = `<div class="stt">Edit Platform Problem</div><div class="frow"><div class="fd"><label>Title</label><input id="pp-t" value="${h(p.title||'')}"/></div><div class="fd"><label>Rating</label><input type="number" id="pp-r" value="${p.rating||0}"/></div></div><div class="frow"><div class="fd"><label>Platform</label><input value="${h(p.platform||'')}" readonly style="opacity:.45"/></div><div class="fd"><label>Category</label><input id="pp-c" value="${h(p.category||'')}"/></div><div class="fd"><label>Tags</label><input id="pp-tg" value="${h(p.tags||'')}"/></div></div><div class="fd"><label>Statement</label><textarea id="pp-st" style="min-height:150px;font-family:var(--mono);font-size:12px">${h(p.statement||'')}</textarea></div><div class="frow2"><div class="fd"><label>Input Spec</label><textarea id="pp-in">${h(p.input_spec||'')}</textarea></div><div class="fd"><label>Output Spec</label><textarea id="pp-out">${h(p.output_spec||'')}</textarea></div></div>`;
  },

  async platSave(id) {
    const body = {title:$('pp-t')?.value,rating:+($('pp-r')?.value),category:$('pp-c')?.value,tags:$('pp-tg')?.value,statement:$('pp-st')?.value,input_spec:$('pp-in')?.value,output_spec:$('pp-out')?.value};
    const d = await this.api(`/api/studio/platform-problems/${id}`,{method:'PUT',body});
    if (d.ok) { this.toast('Updated!','ok'); await this.platLoad(); }
  },

  // ═══ CUSTOM PROBLEMS ═══
  async cpLoad() {
    const list = $('slist');
    list.innerHTML = '<div class="ldg"><div class="spin"></div> Loading…</div>';
    const d = await this.api('/api/studio/custom-problems-list');
    if (!d.ok) { list.innerHTML='<div style="color:var(--err);padding:12px">Failed</div>'; return; }
    list.innerHTML = (d.problems||[]).map(p=>{
      const dc=p.difficulty>=2200?'dx':p.difficulty>=1600?'dh':p.difficulty>=1200?'dm':'de';
      return `<div class="pr ${this.cur.cpId===p.id?'sel':''}" style="margin-bottom:4px" onclick="S.cpSelect(${p.id})"><div style="flex:1"><div class="pt" style="font-size:12px">${h(p.title)}</div><div class="pm">${p.tags||'—'}</div></div><span class="pd ${dc}" style="font-size:11px">${p.difficulty}</span></div>`;
    }).join('')||'<div style="color:var(--txt3);padding:16px;font-size:12px;text-align:center">No custom problems yet.</div>';
  },

  async cpSelect(id) {
    this.cur.cpId = id;
    const d = await this.api(`/api/studio/custom-problems/${id}`);
    if (!d.ok) return;
    const p = d.problem;
    this._show('custom');
    this.topbar('✏️ '+p.title,[{label:'💾 Save',cls:'p',fn:()=>S.cpSave()},{label:'🤖 AI Generate',cls:'ai',fn:()=>S.cpAI()},{label:'Delete',cls:'d',fn:()=>S.cpDel()}]);
    const samples = (()=>{try{return JSON.parse(p.samples||'[]')}catch{return[]}})();
    $('cp-body').innerHTML = `
      <div class="frow"><div class="fd"><label>Title</label><input id="cp-t" value="${h(p.title||'')}"/></div><div class="fd"><label>Difficulty Rating</label><input type="number" id="cp-d" value="${p.difficulty||1200}"/></div></div>
      <div class="fd"><label>Tags</label><input id="cp-tg" value="${h(p.tags||'')}"/></div>
      <div class="frow2"><div class="fd"><label>Time Limit</label><input id="cp-tl" value="${h(p.time_limit||'2 seconds')}"/></div><div class="fd"><label>Memory Limit</label><input id="cp-ml" value="${h(p.memory_limit||'256 MB')}"/></div></div>
      <div class="fd"><label>Statement</label><div class="ql-wrap"><div id="cp-ql"></div></div></div>
      <div class="frow2"><div class="fd"><label>Input Spec</label><textarea id="cp-is">${h(p.input_spec||'')}</textarea></div><div class="fd"><label>Output Spec</label><textarea id="cp-os">${h(p.output_spec||'')}</textarea></div></div>
      <div class="fd"><label>Sample Test Cases</label><div class="sbox" id="cp-smp"></div><button class="btn sm" onclick="S.cpAddSample()" style="margin-top:6px;align-self:flex-start">+ Add Sample</button></div>
      <div class="fd"><label>Testcases JSON</label><div class="mwrap"><div class="mbar"><span style="font-size:10px;color:var(--txt3)">[{"input":"...","output":"..."}, ...]</span></div><div class="mbody" id="cp-mce" style="height:160px"></div></div></div>`;
    const q = this.mkQuill('cp-ql','Write the problem statement…');
    if (q) { q.root.innerHTML = p.statement||''; this.quills._cp = q; }
    samples.forEach(s=>this.cpAddSample(s.input,s.output));
    if (this.monacoReady) { setTimeout(()=>{ if(this.monacos._cp)this.monacos._cp.dispose(); this.monacos._cp = this.mkMonaco('cp-mce',{value:p.testcases||'[]',lang:'json',fontSize:12}); },100); }
  },

  cpAddSample(iv='',ov='') {
    const box = $('cp-smp'); if (!box) return;
    const card = document.createElement('div');
    card.className = 'sc';
    card.innerHTML = `<div><label>Input</label><textarea>${h(iv)}</textarea></div><div><label>Expected Output</label><textarea>${h(ov)}</textarea></div><button class="sdel" onclick="this.closest('.sc').remove()">✕</button>`;
    box.appendChild(card);
  },

  _cpGetSamples() {
    return JSON.stringify([...$$('#cp-smp .sc')].map(c=>{
      const txts = c.querySelectorAll('textarea');
      return {input:txts[0]?.value||'',output:txts[1]?.value||''};
    }));
  },

  async cpSave() {
    const title = $('cp-t')?.value?.trim();
    if (!title) { this.toast('Title required','err'); return; }
    const body = {title,statement:this.quills._cp?.root.innerHTML||'',input_spec:$('cp-is')?.value,output_spec:$('cp-os')?.value,difficulty:+($('cp-d')?.value||1200),tags:$('cp-tg')?.value,time_limit:$('cp-tl')?.value,memory_limit:$('cp-ml')?.value,samples:this._cpGetSamples(),testcases:this.monacos._cp?.getValue()||'[]'};
    if (this.cur.cpId) {
      const d = await this.api(`/api/studio/custom-problems/${this.cur.cpId}`,{method:'PUT',body});
      if (d.ok) { this.toast('Saved!','ok'); await this.cpLoad(); }
    } else {
      const d = await this.api('/api/studio/create-problem',{method:'POST',body});
      if (d.ok) { this.toast('Created! ID: '+d.id,'ok'); this.cur.cpId=d.id; await this.cpLoad(); }
    }
  },

  async cpNew() {
    this.cur.cpId = null;
    this._show('custom');
    this.topbar('✏️ New Custom Problem',[{label:'Create',cls:'p',fn:()=>S.cpSave()}]);
    $('cp-body').innerHTML = `
      <div class="frow"><div class="fd"><label>Title</label><input id="cp-t" placeholder="Problem title"/></div><div class="fd"><label>Difficulty Rating</label><input type="number" id="cp-d" value="1200"/></div></div>
      <div class="fd"><label>Tags</label><input id="cp-tg" placeholder="arrays, dp, greedy"/></div>
      <div class="frow2"><div class="fd"><label>Time Limit</label><input id="cp-tl" value="2 seconds"/></div><div class="fd"><label>Memory Limit</label><input id="cp-ml" value="256 MB"/></div></div>
      <div class="fd"><label>Statement</label><div class="ql-wrap"><div id="cp-ql"></div></div></div>
      <div class="frow2"><div class="fd"><label>Input Spec</label><textarea id="cp-is"></textarea></div><div class="fd"><label>Output Spec</label><textarea id="cp-os"></textarea></div></div>
      <div class="fd"><label>Sample Test Cases</label><div class="sbox" id="cp-smp"></div><button class="btn sm" onclick="S.cpAddSample()" style="margin-top:6px;align-self:flex-start">+ Add Sample</button></div>
      <div class="fd"><label>Testcases JSON</label><textarea id="cp-tc" style="font-family:var(--mono);font-size:12px;min-height:100px">[{"input":"1 2 3","output":"6"}]</textarea></div>`;
    const q = this.mkQuill('cp-ql','Write the problem statement…');
    if (q) this.quills._cp = q;
  },

  async cpDel() {
    const r = await this.modal('Delete Problem?','<p style="color:var(--txt2)">Cannot be undone.</p>',[{label:'Cancel',value:false},{label:'Delete',cls:'d',value:true}]);
    if (!r) return;
    const d = await this.api(`/api/studio/custom-problems/${this.cur.cpId}`,{method:'DELETE'});
    if (d.ok) { this.toast('Deleted','ok'); this.cur.cpId=null; await this.cpLoad(); this._show('welcome'); this.topbar('Select an item',[]); }
  },

  async cpAI() {
    const title = $('cp-t')?.value||'';
    const r = await this.prompt('AI Generate Problem',[{id:'prompt',label:'Describe the problem',type:'textarea',placeholder:`Generate a problem about: ${title}`}]);
    if (!r||!r.prompt) return;
    const text = await this.aiAssist('problem',r.prompt);
    if (text&&this.quills._cp) { this.quills._cp.root.innerHTML = text; this.toast('Generated!','ok'); }
  },

  // ═══ MEDIA ═══
  async mediaLoad() {
    $('media-body').innerHTML = `
      <div class="upz" id="upz" onclick="$('fi').click()"><div style="font-size:36px;margin-bottom:10px">📁</div><div style="font-size:13px;font-weight:600"><strong>Click to upload</strong> or drag & drop</div><div style="font-size:11px;margin-top:5px">Images · Videos · PDFs · SVG — up to 50 MB</div></div>
      <input type="file" id="fi" multiple accept="image/*,video/*,.pdf,.svg,.gif,.webp" style="display:none" onchange="S.mediaUpload(this.files)"/>
      <div class="mgrid" id="mgrid"><div class="ldg" style="grid-column:1/-1"><div class="spin"></div> Loading…</div></div>`;
    const uz = $('upz');
    uz.addEventListener('dragover', e=>{e.preventDefault();uz.classList.add('drag')});
    uz.addEventListener('dragleave', ()=>uz.classList.remove('drag'));
    uz.addEventListener('drop', e=>{e.preventDefault();uz.classList.remove('drag');this.mediaUpload(e.dataTransfer.files)});
    const d = await this.api('/api/studio/media-list');
    const grid = $('mgrid');
    if (!d.ok||!d.files?.length) { grid.innerHTML='<div style="color:var(--txt3);font-size:12px;grid-column:1/-1">No files yet.</div>'; return; }
    grid.innerHTML = d.files.map(f=>{
      const isImg=/\.(jpg|jpeg|png|gif|webp|svg)$/i.test(f.name);
      const isVid=/\.(mp4|webm|mov)$/i.test(f.name);
      return `<div class="mi">${isImg?`<img src="${f.url}" loading="lazy"/>`:isVid?`<video src="${f.url}" muted preload="metadata"></video>`:`<div class="mficon">📄</div>`}<div class="mhov"><button class="btn sm p" onclick="S.mediaCopy('${f.url}')">📋 Copy URL</button></div><div class="mfn">${h(f.name)}</div></div>`;
    }).join('');
  },

  async mediaUpload(files) {
    for (const file of files) {
      this.toast('Uploading '+file.name+'…','info');
      const fd = new FormData(); fd.append('file',file);
      const d = await this.api('/api/studio/upload',{method:'POST',body:fd});
      if (d.ok) this.toast('✓ '+d.name,'ok');
    }
    $('fi').value=''; this.mediaLoad();
  },

  mediaCopy(url) {
    const full = location.origin+url;
    navigator.clipboard.writeText(full).then(()=>this.toast('URL copied!','ok')).catch(()=>window.prompt('Copy:',full));
  },
};

// Keyboard shortcuts
document.addEventListener('keydown', e=>{
  if ((e.ctrlKey||e.metaKey)&&e.key==='s') {
    e.preventDefault();
    const s=S.cur.sec;
    if (s==='cms'&&S.cur.lessonId) S.lessonSave();
    else if (s==='cms'&&S.cur.courseId) S.cmsSave();
    else if (s==='tutorials') S.tutSave();
    else if (s==='ailab') S.aiSave();
    else if (s==='forge') S.forgeSave();
    else if (s==='custom') S.cpSave();
  }
});

$('gp').addEventListener('keydown', e=>{if(e.key==='Enter')S.login()});

if (S.token) { $('gp').value = S.token; S.login(true); }
</script>
</body>
</html>
