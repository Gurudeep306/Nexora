    { "say": "search for 9 instead", "expect": { "verb": "whatif", "input": { "target": 9 } } },
    { "say": "why did i become 4", "expect": { "verb": "why", "about": "i" } },
    { "say": "i chaar kyun ho gaya", "expect": { "verb": "why", "about": "i" } },
    { "say": "yeh swap kyun hua", "expect": { "verb": "why", "about": "event" } },
