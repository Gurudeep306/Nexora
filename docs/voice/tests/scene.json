    { "say": "step 5 pe jao", "expect": { "verb": "jump", "to": { "step": 5 } } },
    { "say": "swap pe ruko", "expect": { "verb": "jump", "to": { "event": "swap" } } },
    { "say": "pause at the next swap", "expect": { "verb": "jump", "to": { "event": "swap", "which": "next" } } },
