@import "tailwindcss";

/* Raw palette in OKLCH - Indigo */
:root {
  --oklch-indigo-50: oklch(0.92 0.04 260);
  --oklch-indigo-100: oklch(0.88 0.06 258);
  --oklch-indigo-200: oklch(0.80 0.09 255);
  --oklch-indigo-300: oklch(0.69 0.12 252);
  --oklch-indigo-400: oklch(0.55 0.13 250);
  --oklch-indigo-500: oklch(0.40 0.14 248);
  --oklch-indigo-600: oklch(0.30 0.13 246);
  --oklch-indigo-700: oklch(0.23 0.11 245);
  --oklch-indigo-800: oklch(0.18 0.09 244);
  --oklch-indigo-900: oklch(0.14 0.06 243);
  --oklch-indigo-950: oklch(0.10 0.04 242);
}

/* Raw palette in OKLCH - Violet */
:root {
  --oklch-violet-50: oklch(0.92 0.04 300);
  --oklch-violet-100: oklch(0.88 0.06 298);
  --oklch-violet-200: oklch(0.80 0.09 295);
  --oklch-violet-300: oklch(0.69 0.12 292);
  --oklch-violet-400: oklch(0.55 0.13 290);
  --oklch-violet-500: oklch(0.40 0.14 288);
  --oklch-violet-600: oklch(0.30 0.13 286);
  --oklch-violet-700: oklch(0.23 0.11 285);
  --oklch-violet-800: oklch(0.18 0.09 284);
  --oklch-violet-900: oklch(0.14 0.06 283);
  --oklch-violet-950: oklch(0.10 0.04 282);
}

/* Raw palette in OKLCH - Gray */
:root {
  --oklch-gray-50: oklch(0.97 0.00 0);
  --oklch-gray-100: oklch(0.94 0.00 0);
  --oklch-gray-200: oklch(0.88 0.00 0);
  --oklch-gray-300: oklch(0.78 0.00 0);
  --oklch-gray-400: oklch(0.64 0.00 0);
  --oklch-gray-500: oklch(0.49 0.00 0);
  --oklch-gray-600: oklch(0.35 0.00 0);
  --oklch-gray-700: oklch(0.24 0.00 0);
  --oklch-gray-800: oklch(0.16 0.00 0);
  --oklch-gray-900: oklch(0.09 0.00 0);
  --oklch-gray-950: oklch(0.05 0.00 0);
}

/* Semantic roles */
:root {
  /* Primary and Secondary */
  --color-primary: var(--oklch-indigo-500);
  --color-primary-foreground: var(--oklch-gray-50);
  --color-secondary: var(--oklch-violet-500);
  --color-secondary-foreground: var(--oklch-gray-50);

  /* Background and Foreground */
  --color-background: var(--oklch-gray-950); /* darkest */
  --color-foreground: var(--oklch-gray-50); /* lightest */

  /* Muted */
  --color-muted: var(--oklch-gray-600);
  --color-muted-foreground: var(--oklch-gray-300);

  /* Popover */
  --color-popover: var(--color-background);
  --color-popover-foreground: var(--color-foreground);

  /* Card */
  --color-card: var(--oklch-gray-900);
  --color-card-foreground: var(--color-foreground);

  /* Border */
  --color-border: var(--oklch-gray-700);

  /* Input */
  --color-input: var(--oklch-gray-700);
  --color-input-background: var(--oklch-gray-800);
  --color-input-foreground: var(--color-foreground);

  /* Success, Warning, Error */
  --color-success: oklch(0.60 0.15 140);
  --color-success-foreground: var(--oklch-gray-950);
  --color-warning: oklch(0.60 0.20 40);
  --color-warning-foreground: var(--oklch-gray-950);
  --color-error: oklch(0.60 0.20 20);
  --color-error-foreground: var(--oklch-gray-50);
}

/* Component tokens (example) */
:root {
  --color-button-primary: var(--color-primary);
  --color-button-primary-foreground: var(--color-foreground);
  --color-button-secondary: var(--color-secondary);
  --color-button-secondary-foreground: var(--color-foreground);
  --color-button-destructive: var(--color-error);
  --color-button-destructive-foreground: var(--color-foreground);

  --color-popover: var(--color-popover);
  --color-popover-foreground: var(--color-popover-foreground);

  --color-card: var(--color-card);
  --color-card-foreground: var(--color-card-foreground);
}

/* Tailwind theme */
@theme inline {
  --color-primary: var(--color-primary);
  --color-primary-foreground: var(--color-primary-foreground);
  --color-secondary: var(--color-secondary);
  --color-secondary-foreground: var(--color-secondary-foreground);
  --color-background: var(--color-background);
  --color-foreground: var(--color-foreground);
  --color-muted: var(--color-muted);
  --color-muted-foreground: var(--color-muted-foreground);
  --color-popover: var(--color-popover);
  --color-popover-foreground: var(--color-popover-foreground);
  --color-card: var(--color-card);
  --color-card-foreground: var(--color-card-foreground);
  --color-border: var(--color-border);
  --color-input: var(--color-input);
  --color-input-background: var(--color-input-background);
  --color-input-foreground: var(--color-input-foreground);
  --color-success: var(--color-success);
  --color-success-foreground: var(--color-success-foreground);
  --color-warning: var(--color-warning);
  --color-warning-foreground: var(--color-warning-foreground);
  --color-error: var(--color-error);
  --color-error-foreground: var(--color-error-foreground);
  --color-button-primary: var(--color-button-primary);
  --color-button-primary-foreground: var(--color-button-primary-foreground);
  --color-button-secondary: var(--color-button-secondary);
  --color-button-secondary-foreground: var(--color-button-secondary-foreground);
  --color-button-destructive: var(--color-button-destructive);
  --color-button-destructive-foreground: var(--color-button-destructive-foreground);

  /* Fonts */
  --font-sans: var(--font-geist-sans);
  --font-mono: var(--font-geist-mono);
}

/* Media queries for accessibility */
@media (prefers-reduced-motion: reduce) {
  :root {
    --animation-duration: 0ms;
    --animation-easing: linear;
  }
}

@media (prefers-contrast: more) {
  :root {
    --color-background: var(--oklch-gray-900);
    --color-foreground: var(--oklch-gray-20);
    --color-primary: var(--oklch-indigo-700);
    --color-secondary: var(--oklch-violet-700);
    /* Adjust other colors for higher contrast */
  }
}

/* Base styles */
body {
  background: var(--color-background);
  color: var(--color-foreground);
  font-family: var(--font-sans);
  /* Add texture: noise/grain overlay */
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%' height='100%' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
  background-size: cover;
}

/* Ensure text on glass has opaque reading zone */
.reading-zone {
  background: var(--color-background);
}

/* Glass surface example */
.glass-surface {
  @apply bg-background/50 backdrop-blur-lg border border-border/20;
  /* 1px top-edge highlight */
  position: relative;
}
.glass-surface::before {
  content: "";
  position: absolute;
  inset-x-0;
  top-0;
  height: 0.5px;
  background: linear-gradient(
    to right,
    transparent,
    var(--color-foreground) 10%,
    transparent 90%
  );
  opacity: 0.2;
}

/* Ensure AA+ contrast - we rely on the token definitions and testing */