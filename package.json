{
  "name": "nexora",
  "version": "2.0.0",
  "description": "Nexora – Multi-Domain CS Learning Platform",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:prod": "NODE_ENV=production node src/server.js",
    "dev": "NODE_ENV=development node --watch src/server.js",
    "client:dev": "cd client && npm run dev",
    "client:build": "cd client && npm install && npm run build",
    "build": "npm ci --prefix client --include=dev --no-audit --no-fund && npm run build --prefix client",
    "test": "node --test tests/*.test.js",
    "notes:build": "node scripts/build-gate-notes.js",
    "notes:check": "node scripts/build-gate-notes.js --check",
    "notes:checks": "python3 scripts/gate-notes/run_checks.py",
    "nexus:check": "node scripts/validate-nexus.js",
    "scrape": "node src/scraper.js",
    "scrape:100": "node src/scraper.js --limit 100",
    "scrape:500": "node src/scraper.js --limit 500",
    "scrape:easy": "node src/scraper.js --rating 800 1200 --limit 200",
    "scrape:medium": "node src/scraper.js --rating 1200 1800 --limit 200",
    "scrape:hard": "node src/scraper.js --rating 1800 3500 --limit 200",
    "db:push-to-cloud": "node scripts/migrate-to-turso.js",
    "db:backup": "node scripts/backup-turso.js",
    "user:set-password": "node scripts/set-password.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@libsql/client": "^0.18.0",
    "@sentry/node": "^11.12.0",
    "cheerio": "^1.0.0-rc.12",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^17.4.1",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.4",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "hyparquet": "^1.33.0",
    "marked": "^15.0.12",
    "multer": "^2.5.0",
    "node-fetch": "^2.7.0",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "socket.io": "^4.8.4",
    "tree-sitter-wasms": "0.1.13",
    "unpdf": "1.9.1",
    "web-tree-sitter": "0.25.10",
    "yjs": "13.6.27"
  },
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "optionalDependencies": {
    "puppeteer": "^25.17.0"
  },
  "devDependencies": {
    "sqlite3": "^6.0.1"
  }
}
