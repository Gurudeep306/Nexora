 "steps": [
  {
   "caption": "while: the test comes first. With n = 0 it is false at once.",
   "patches": [
    {
     "id": "b00",
     "set": {
      "tone": "accent",
      "fill": "accent"
     }
    }
   ]
  },
  {
   "caption": "So a while loop with a false condition runs its body 0 times.",
   "patches": [
    {
     "id": "b00",
     "set": {
      "tone": "danger",
      "fill": "none"
     }
    },
    {
     "id": "b01",
     "set": {
      "tone": "muted",
      "dashed": true
     }
    },
    {
     "id": "r0",
     "set": {
      "hidden": false,
      "text": "body runs 0 times"
     }
    }
   ]
  },
  {
   "caption": "do-while: the body comes first, before any test.",
   "patches": [
    {
     "id": "b10",
     "set": {
      "tone": "accent",
      "fill": "accent"
     }
    }
   ]
  },
  {
   "caption": "The test after it is false, so the loop stops, but the body has already run once.",
   "patches": [
    {
     "id": "b10",
     "set": {
      "tone": "success",
      "fill": "success"
     }
    },
    {
     "id": "b11",
     "set": {
      "tone": "danger"
     }
    },
    {
