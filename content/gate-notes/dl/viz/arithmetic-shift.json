 "steps": [
  {
   "caption": "Arithmetic shift right: every bit moves one place right, the last bit falls off, and the sign bit is copied into the empty top place. 11111001 → 11111100 = −4.",
   "patches": [
    {
     "id": "a",
     "set": {
      "hidden": false
     }
    },
    {
     "id": "al",
     "set": {
