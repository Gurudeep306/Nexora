 "steps": [
  {
   "caption": "Σm(1, 2, 3, 4, 5, 6): every 1 except the corners of the cube 000 and 111. Each 1 has exactly two neighbouring 1s, so it can be looped in two different pairs.",
   "patches": [
    {
     "id": "n0",
     "set": {
      "text": "6 ones, each with 2 neighbouring 1s"
     }
    }
   ]
  },
  {
   "caption": "The six pairs form a ring: 1–3, 3–2, 2–6, 6–4, 4–5, 5–1. All six are prime implicants and every 1 is in two of them, so no prime implicant is essential.",
   "patches": [
    {
     "id": "n1",
     "set": {
      "text": "6 PIs, 0 EPIs: cyclic",
      "tone": "warning"
     }
    }
   ]
  },
  {
   "caption": "Pick every other pair around the ring: B′C + A′B + AC′. Three pairs, 6 literals, every 1 covered once.",
   "patches": [
