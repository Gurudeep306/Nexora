 "steps": [
  {
   "caption": "HA1 adds A and B: its XOR gives the partial sum p = A ⊕ B, its AND gives g = A·B (a carry made here).",
   "patches": []
  },
  {
   "caption": "HA2 adds p and Cin: S = p ⊕ Cin is the full sum, t = p·Cin is a carry made by passing Cin along.",
   "patches": []
  },
  {
   "caption": "The OR merges the two possible carries: Cout = g + t = A·B + Cin·(A ⊕ B).",
   "patches": [
    {
     "id": "o1",
     "set": {
      "tone": "accent"
     }
    },
    {
     "id": "note",
     "set": {
      "text": "Cout = AB + Cin(A ⊕ B)",
      "tone": "accent"
     }
    }
   ]
  },
