 "steps": [
  {
   "caption": "The 2001 machine: A, B copy the input, C, D complement it. B remembers 'last bit 0', D 'last bit 1'. Arcs are next/output.",
   "patches": [
    {
     "id": "st",
     "set": {
      "text": "4 states → 2 flip-flops Q1Q0"
     }
    }
   ]
  },
  {
   "caption": "Assign A = 00, B = 01, C = 10, D = 11: Q1 is the mode (0 copy, 1 complement), Q0 the 'one more of the same bit ends the mode' flag.",
   "patches": [
    {
     "id": "symt",
     "set": {
      "text": "A=00 B=01 C=10 D=11"
     }
    },
    {
     "id": "bt",
     "set": {
      "hidden": false
     }
    },
    {
     "id": "st",
     "set": {
      "text": "Q1 = mode, Q0 = flag",
      "tone": "accent"
     }
    }
   ]
  },
