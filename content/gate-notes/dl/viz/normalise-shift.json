    "size": 15
   },
   "label": "not normalised: three 0s after the point"
  }
 ],
 "steps": [
  {
   "caption": "Find the first 1. It sits in the 4th place after the point, so the significand starts with three wasted zeros.",
   "patches": [
    {
     "id": "sig",
     "set": {
      "highlight": [
       5
      ]
     }
    }
   ]
  },
  {
   "caption": "Fraction form (0.1…): shift the significand 3 places left, so the first 1 sits just after the point. A left shift by 3 multiplies by 2³, so the exponent drops by 3: 0.1011 × 2³.",
   "patches": [
    {
     "id": "sig",
     "set": {
      "bits": "0.1011000",
      "highlight": [
       2
      ]
     }
    },
    {
     "id": "exp",
     "set": {
      "text": "× 2³"
     }
    },
    {
     "id": "val",
     "set": {
      "text": "value = 11/16 × 8 = 5.5"
     }
    },
    {
     "id": "form",
     "set": {
      "label": "fraction form: ½ ≤ M < 1",
      "tone": "info",
      "fill": "info"
     }
    }
   ]
  },
  {
   "caption": "Hidden-bit form (1.f): shift one more place, so the first 1 sits before the point. The exponent drops once more: 1.011 × 2².",
   "patches": [
    {
     "id": "sig",
     "set": {
      "bits": "1.0110000",
      "highlight": [
       0
      ]
     }
    },
    {
     "id": "exp",
     "set": {
      "text": "× 2²"
     }
    },
    {
     "id": "val",
     "set": {
      "text": "value = 11/8 × 4 = 5.5"
     }
    },
    {
     "id": "form",
     "set": {
      "label": "hidden-bit form: 1 ≤ M < 2",
      "tone": "subject",
      "fill": "subject"
     }
    }
   ]
  },
  {
   "caption": "In the hidden-bit form the bit before the point is always 1, so it is not stored. The fraction field keeps only 011 (then zeros), and every shift kept the value at 5.5.",
   "patches": [
    {
     "id": "sig",
     "set": {
      "highlight": [
       2,
       3,
       4
      ]
     }
    },
    {
     "id": "form",
     "set": {
      "label": "stored fraction field: 011 000…",
      "tone": "success",
      "fill": "success"
     }
    }
   ]
  }
 ]
}
