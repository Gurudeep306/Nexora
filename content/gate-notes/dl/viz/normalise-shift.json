   "text": "Normalising 0.0001011 × 2⁶",
   "anchor": "middle",
   "size": 15,
   "weight": "bold",
   "only": "narrow"
  },
  {
   "id": "sig",
   "type": "bits",
   "x": 112,
   "y": 84,
