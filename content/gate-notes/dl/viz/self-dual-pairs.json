 "steps": [
  {
   "caption": "Pair every row with its bitwise complement: (0, 7), (1, 6), (2, 5), (3, 4). The two indices always add up to 2ⁿ − 1 = 7.",
   "patches": [
    {
     "id": "f",
     "set": {
      "text": "pairs (i, 7 − i)"
     }
    }
   ]
  },
  {
   "caption": "f = Σ(0, 1, 2, 4) takes exactly one row from each pair (0 from the first, 1, 2 and 4 from the others). So f(x′) = f(x)′ on every row: f is self-dual.",
   "patches": [
    {
     "id": "p0a",
     "set": {
      "fill": "success"
     }
    },
