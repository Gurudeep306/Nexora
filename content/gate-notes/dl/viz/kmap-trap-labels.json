 "steps": [
  {
   "caption": "The columns are labelled 00, 01, 10, 11: plain counting order, not Gray order. Between the 2nd and 3rd columns two bits change (01 → 10), and the two end columns (00 and 11) are not neighbours either.",
   "patches": [
    {
     "id": "n1",
     "set": {
      "text": "labels: 00 01 10 11 (binary!)",
      "tone": "danger"
     }
    }
   ]
  },
  {
   "caption": "The tempting mistake: treat the end columns as a wrap-around group of four 1s and write C′. On this map the ends differ in two bits, so that loop is illegal.",
   "patches": [
    {
     "id": "w0",
     "set": {
      "hidden": false
     }
    },
    {
     "id": "w1",
     "set": {
      "hidden": false
     }
    },
    {
     "id": "n2",
     "set": {
      "text": "wrap loop of the ends: illegal",
      "tone": "danger"
     }
    },
    {
     "id": "ex",
     "set": {
      "text": "not C′",
      "tone": "danger"
     }
    }
   ]
  },
