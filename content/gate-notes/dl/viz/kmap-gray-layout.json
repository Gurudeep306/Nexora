 "steps": [
  {
   "caption": "Columns are labelled by C D and rows by A B, each in Gray order 00, 01, 11, 10: the third label is 11, not 10, so that every step along an axis flips exactly one bit.",
   "patches": [
    {
     "id": "n1",
     "set": {
      "text": "Gray order: 00 → 01 → 11 → 10",
      "tone": "accent"
     }
    },
    {
     "id": "n2",
     "set": {
      "text": "one bit changes per step",
      "tone": "ink"
     }
    },
    {
     "id": "n3",
     "set": {
      "text": "and 10 → 00 wraps round",
      "tone": "ink"
