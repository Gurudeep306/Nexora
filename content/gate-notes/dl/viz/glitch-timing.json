 "steps": [
  {
   "caption": "X rises at t = 2 and falls at t = 6. Logically Y = X·X′ is always 0.",
   "patches": []
  },
  {
   "caption": "The inverter takes one time unit, so X′ falls only at t = 3 and rises only at t = 7.",
   "patches": [
    {
     "id": "l1",
     "set": {
      "hidden": false
     }
    },
    {
     "id": "w1",
     "set": {
      "hidden": false
     }
    }
   ]
  },
  {
   "caption": "Between t = 2 and t = 3 both AND inputs are 1, so Y pulses to 1 for exactly the inverter delay: a static-0 hazard (a glitch).",
   "patches": [
    {
     "id": "l2",
     "set": {
      "hidden": false
     }
    },
    {
     "id": "w2",
     "set": {
