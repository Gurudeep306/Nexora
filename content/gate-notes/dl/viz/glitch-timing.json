     }
    },
    {
     "id": "note",
     "set": {
      "text": "1-pulse of width = inverter delay on the rising edge"
     }
    }
   ]
  },
  {
   "caption": "On the falling edge (t = 6 to 7) X is already 0 while X′ is still 0, so the AND sees 0, 0 and Y stays 0. The glitch appears only after X rises.",
   "patches": [
    {
     "id": "note",
     "set": {
      "text": "no glitch on the falling edge",
      "tone": "ink"
     }
    }
   ]
  }
