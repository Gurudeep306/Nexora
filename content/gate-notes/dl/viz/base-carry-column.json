 "steps": [
  {
   "caption": "Units column: 7 + 5 = 12. In base 8, twelve is one eight and four units, so write 4 and carry 1 into the eights column.",
   "patches": [
    {
     "id": "s2",
     "set": {
      "text": "4"
     }
    },
    {
     "id": "cy1",
     "set": {
      "text": "1"
     }
    },
    {
     "id": "work",
     "set": {
      "text": "7 + 5 = 12 = 1·8 + 4"
     }
    }
   ]
  },
  {
   "caption": "Eights column: 3 + 4 + the carry 1 = 8. That is exactly one 64 and no eights, so write 0 and carry 1 again.",
   "patches": [
    {
     "id": "s1",
     "set": {
      "text": "0"
     }
    },
    {
     "id": "cy0",
     "set": {
      "text": "1"
     }
    },
    {
     "id": "work",
     "set": {
      "text": "3 + 4 + 1 = 8 = 1·8 + 0"
     }
    }
   ]
  },
  {
   "caption": "Nothing is left to add except the carry, so it becomes the leading digit: (37)₈ + (45)₈ = (104)₈.",
   "patches": [
    {
     "id": "s0",
     "set": {
      "text": "1"
     }
    },
