   ]
  },
  {
   "caption": "Recount each circle. Circle 1 is still even (it does not contain position 6). Circles 2 and 4 are now odd: they fail.",
   "patches": [
    {
     "id": "p2",
     "set": {
      "tone": "danger",
      "fill": "danger"
     }
    },
    {
     "id": "p4",
