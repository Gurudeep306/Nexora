  },
  {
   "caption": "Noise flips position 6 (1 → 0). The received word is 0110001.",
   "patches": [
    {
     "id": "p4",
     "set": {
      "fill": "none"
     }
    },
    {
     "id": "b6",
     "set": {
      "label": "0",
      "tone": "danger",
      "fill": "danger"
     }
    },
