 "steps": [
  {
   "caption": "Each parity bit makes its circle hold an even number of 1s. Circle 1 holds positions 3, 5, 7 = 1, 0, 1: two 1s already, so p1 = 0.",
   "patches": [
    {
     "id": "b1",
     "set": {
      "label": "0",
      "tone": "success"
     }
    },
    {
     "id": "p1",
     "set": {
      "fill": "info"
     }
    }
   ]
  },
  {
   "caption": "Circle 2 holds positions 3, 6, 7 = 1, 1, 1: three 1s, so p2 = 1 to make four.",
   "patches": [
    {
     "id": "p1",
     "set": {
      "fill": "none"
     }
    },
    {
     "id": "b2",
     "set": {
      "label": "1",
      "tone": "success"
     }
    },
    {
     "id": "p2",
     "set": {
      "fill": "info"
     }
    }
   ]
  },
  {
   "caption": "Circle 4 holds positions 5, 6, 7 = 0, 1, 1: two 1s, so p4 = 0. The codeword (positions 1–7) is 0110011.",
   "patches": [
    {
     "id": "p2",
     "set": {
      "fill": "none"
     }
    },
    {
     "id": "b4",
     "set": {
