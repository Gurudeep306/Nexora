 "steps": [
  {
   "caption": "Every switch is at ground. Both switch positions are at 0 V (OUT is a virtual ground), so the ladder's currents never depend on the code.",
   "patches": [
    {
     "id": "rr",
     "set": {
      "text": ""
     }
    }
   ]
  },
  {
   "caption": "Looking right from A0: the 2R leg in parallel with the 2R terminator is R.",
   "patches": [
    {
     "id": "rl2",
     "set": {
      "fill": "accent"
     }
    },
    {
     "id": "rt",
     "set": {
      "fill": "accent"
     }
    },
    {
     "id": "rr",
     "set": {
      "text": "right of A0: 2R || 2R = R"
     }
    }
   ]
  },
  {
   "caption": "Looking right from A1: R in series with that R is 2R, in parallel with A1's 2R leg: R again.",
   "patches": [
    {
     "id": "rl2",
     "set": {
      "fill": "none"
     }
    },
    {
     "id": "rt",
     "set": {
      "fill": "none"
     }
    },
    {
     "id": "rs1",
     "set": {
      "fill": "accent"
     }
    },
    {
     "id": "rl1",
     "set": {
      "fill": "accent"
     }
    },
    {
     "id": "rr",
     "set": {
      "text": "right of A1: 2R || (R + R) = R"
     }
    }
   ]
  },
  {
   "caption": "The same holds at A2, so V_ref sees R: I = V_ref / R = 5 V / 2 kΩ = 2.5 mA, for every code.",
   "patches": [
    {
