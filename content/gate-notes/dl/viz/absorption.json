 "steps": [
  {
   "caption": "Align y to x's exponent 5: shift its significand right 5 places. The 1 lands just past the 4 kept bits: 0.0000 with guard bit 1 and round bit 0.",
   "patches": [
    {
     "id": "y",
     "set": {
      "bits": "0.0000"
     }
    },
    {
     "id": "yg",
     "set": {
      "bits": "10",
      "hidden": false
     }
    },
    {
     "id": "ye",
     "set": {
      "text": "× 2⁵"
     }
    }
   ]
  },
  {
   "caption": "The extra bits are exactly half an ulp (G = 1, R = S = 0): a tie. Ties go to the even neighbour, and 1.0000 is even, so x + y rounds to 32. y has been absorbed.",
   "patches": [
    {
     "id": "res",
     "set": {
      "label": "32 + 1 = 32 (tie, rounds to even)",
      "tone": "danger",
      "fill": "danger"
     }
    }
   ]
  },
  {
   "caption": "Add 1 again: the same thing happens, so (32 + 1) + 1 = 32.",
   "patches": [
    {
     "id": "res",
     "set": {
      "label": "(32 + 1) + 1 = 32",
      "tone": "danger",
      "fill": "danger"
     }
    }
   ]
  },
  {
   "caption": "Now add the small numbers first: 1 + 1 = 2 exactly. Aligning 2 = 1.0000 × 2¹ to exponent 5 shifts it 4 places: 0.0001, with nothing left over. 32 + 2 = 1.0001 × 2⁵ = 34 exactly.",
   "patches": [
    {
     "id": "yl",
     "set": {
      "text": "y = 2"
     }
    },
    {
     "id": "y",
     "set": {
      "bits": "0.0001"
     }
    },
    {
     "id": "yg",
     "set": {
      "bits": "00"
     }
    },
    {
     "id": "res",
     "set": {
      "label": "32 + (1 + 1) = 34",
      "tone": "success",
      "fill": "success"
     }
    }
   ]
  },
  {
   "caption": "So (32 + 1) + 1 ≠ 32 + (1 + 1): floating-point addition is not associative. Adding the small terms first keeps them from being absorbed.",
   "patches": [
    {
     "id": "note",
     "set": {
      "text": "order matters: add small numbers first",
      "tone": "subject"
     }
    }
   ]
  }
 ]
}
