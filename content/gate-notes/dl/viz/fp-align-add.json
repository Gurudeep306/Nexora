 "steps": [
  {
   "caption": "Write both significands with their hidden 1 and two extra guard positions. A = 1.1100 × 2², B = 1.1010 × 2⁰. The exponents differ by 2.",
   "patches": [
    {
     "id": "a",
     "set": {
      "highlight": [
       3,
       4
      ]
     }
    },
    {
     "id": "b",
     "set": {
      "highlight": [
       3,
       4
      ]
     }
    }
   ]
  },
  {
   "caption": "Align: shift the smaller number right by 2 and raise its exponent to 2. B becomes 0.0110 × 2², and the bits shifted out (1 0) land in the guard and round positions instead of being lost.",
   "patches": [
    {
     "id": "b",
     "set": {
      "bits": "00.0110",
      "highlight": []
     }
    },
    {
     "id": "bg",
     "set": {
      "bits": "10"
     }
    },
    {
     "id": "be",
     "set": {
      "text": "× 2²"
     }
    },
    {
     "id": "a",
     "set": {
      "highlight": []
     }
    }
   ]
  },
  {
   "caption": "Add the aligned significands: 1.1100 00 + 0.0110 10 = 10.0010 10. The sum overflowed into a second integer bit.",
   "patches": [
    {
     "id": "bar",
     "set": {
      "hidden": false
     }
    },
    {
     "id": "s",
     "set": {
      "hidden": false
     }
    },
    {
     "id": "sg",
     "set": {
      "hidden": false
     }
    },
    {
     "id": "sl",
     "set": {
      "hidden": false
     }
    },
    {
     "id": "se",
     "set": {
      "hidden": false
     }
    }
   ]
  },
  {
   "caption": "Normalise: 10.0010 10 has two bits before the point, so shift right by 1 and add 1 to the exponent: 1.0001 010 × 2³. The bit shifted out joins the extra bits: G = 0, R = 1.",
   "patches": [
    {
     "id": "n",
     "set": {
      "hidden": false
     }
    },
    {
     "id": "ng",
     "set": {
      "hidden": false
     }
    },
    {
     "id": "nl",
     "set": {
      "hidden": false
     }
    },
    {
     "id": "ne",
     "set": {
      "hidden": false
     }
    }
   ]
  },
  {
   "caption": "Round to nearest even: the guard bit is 0, so the extra bits are less than half an ulp and are dropped. Result 1.0001 × 2³ = 8.5.",
   "patches": [
    {
     "id": "r",
     "set": {
      "hidden": false
     }
    },
    {
     "id": "rl",
     "set": {
      "hidden": false
     }
    },
    {
     "id": "re",
     "set": {
      "hidden": false
     }
    },
    {
     "id": "res",
     "set": {
      "text": "stored 8.5; exact sum 8.625 (error 0.125, under half an ulp = 0.25)"
     }
    }
   ]
  }
 ]
