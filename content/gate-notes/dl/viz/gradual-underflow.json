 "steps": [
  {
   "caption": "With normal numbers only, the smallest positive value is 1/4 (1.00 × 2⁻²) and the next one down is 0. Just above 1/4 the values are 1/16 apart, but below it there is a hole four times wider.",
   "patches": [
    {
     "id": "hole",
     "set": {
      "hidden": false
     }
    }
   ]
  },
  {
   "caption": "Take x = 5/16 and y = 4/16, two different normal numbers. Their difference 1/16 falls in the hole, so a flush-to-zero machine returns x − y = 0 even though x ≠ y.",
   "patches": [
    {
     "id": "xl",
     "set": {
      "hidden": false
     }
    },
    {
     "id": "yl",
     "set": {
      "hidden": false
     }
    },
    {
     "id": "note",
     "set": {
      "label": "flush to zero: x − y = 0",
      "tone": "danger",
      "fill": "danger"
     }
    }
   ]
  },
  {
   "caption": "Denormals use the exponent field 0 with no hidden 1: 0.f × 2⁻², giving 1/16, 2/16 and 3/16. They fill the hole with the same 1/16 spacing as the first normal binade.",
   "patches": [
    {
     "id": "hole",
     "set": {
      "hidden": true
     }
    },
    {
     "id": "t1",
     "set": {
      "hidden": false
     }
    },
    {
     "id": "t2",
     "set": {
      "hidden": false
     }
    },
    {
     "id": "t3",
     "set": {
      "hidden": false
     }
    },
    {
     "id": "note",
     "set": {
      "label": "with denormals: evenly spaced down to 0",
      "tone": "success",
      "fill": "success"
     }
    }
   ]
  },
  {
   "caption": "Now x − y = 1/16 is the denormal 0.01 × 2⁻², stored exactly. With denormals, x ≠ y always gives x − y ≠ 0.",
   "patches": [
    {
     "id": "t1",
     "set": {
      "tone": "success"
     }
    },
    {
     "id": "note",
     "set": {
      "label": "x − y = 1/16, exact",
      "tone": "success",
      "fill": "success"
     }
    }
   ]
  },
  {
   "caption": "The largest denormal, 3/16, is exactly one step below the smallest normal, 1/4. In IEEE single precision the same picture holds with 2⁻¹⁴⁹ steps up to 2⁻¹²⁶.",
   "patches": [
    {
     "id": "note",
     "set": {
      "label": "largest denormal 3/16, smallest normal 1/4",
      "tone": "info",
      "fill": "info"
     }
    }
   ]
  }
 ]
