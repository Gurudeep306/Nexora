 "steps": [
  {
   "caption": "Start at 0101 = +5. Adding a positive number means stepping clockwise.",
   "patches": [
    {
     "id": "ptr",
     "set": {
      "to": "n5"
     }
    },
    {
     "id": "n5",
     "set": {
      "fill": "subject",
      "tone": "subject"
     }
    }
   ]
  },
  {
   "caption": "Add +4: four steps clockwise pass 0111 (+7) and cross the seam into 1001. The pattern reads −7, but 5 + 4 = 9 does not fit in 4 bits. Overflow.",
   "patches": [
    {
     "id": "path",
     "set": {
      "hidden": false,
      "start": 112.5,
      "end": 202.5
     }
    },
    {
