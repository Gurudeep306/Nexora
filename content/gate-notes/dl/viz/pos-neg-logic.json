 "steps": [
  {
   "caption": "The datasheet lists only voltages. The output is H only when both inputs are H.",
   "patches": [
    {
     "id": "phys",
     "set": {
      "highlight": [
       [
        4,
        0
       ],
       [
        4,
        1
       ],
       [
        4,
        2
       ]
      ]
     }
    }
   ]
  },
  {
   "caption": "Read H as 1 and L as 0 (positive logic). F is 1 only on row 11: this gate is an AND.",
   "patches": [
    {
     "id": "t2",
     "set": {
      "hidden": false
     }
    },
    {
     "id": "pos",
     "set": {
