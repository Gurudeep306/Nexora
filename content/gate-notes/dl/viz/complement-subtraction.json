 "steps": [
  {
   "caption": "Write N = 1000011 (67) and flip every bit: N̄ = 0111100. This is the 1's complement, 2⁷ − 1 − 67 = 60.",
   "patches": [
    {
     "id": "nb",
     "set": {
      "hidden": false
     }
    },
    {
     "id": "nbl",
     "set": {
      "hidden": false
     }
    }
   ]
  },
  {
   "caption": "Add M + N̄ = 1010100 + 0111100 = 1 0010000. The sum is 144 = 2⁷ + 16: a carry comes out of the top bit because M > N.",
   "patches": [
    {
     "id": "bar",
     "set": {
      "hidden": false
     }
    },
    {
     "id": "s",
     "set": {
      "hidden": false,
