       0
      ]
     }
    },
    {
     "id": "sl",
     "set": {
      "hidden": false
     }
    }
   ]
  },
  {
   "caption": "End-around carry: remove the carry (worth 2⁷) and add it back as 1 at the bottom. Removing 2⁷ leaves M − N − 1 = 16; adding 1 corrects the 'one short' of the 1's complement.",
   "patches": [
    {
     "id": "e",
     "set": {
      "hidden": false
     }
    },
    {
