 "steps": [
  {
   "caption": "The 1s are the four corners: m0 = 0000, m2 = 0010, m8 = 1000, m10 = 1010. They look as far apart as cells can be.",
   "patches": [
    {
     "id": "n1",
     "set": {
      "text": "1s at m0, m2, m8, m10"
     }
    }
   ]
  },
  {
   "caption": "Across the left/right edge: m0 and m2 differ only in C (0000, 0010), and so do m8 and m10. Across the top/bottom edge: m0 and m8 differ only in A, m2 and m10 too.",
   "patches": [
    {
     "id": "n2",
     "set": {
      "text": "0 ~ 2 and 8 ~ 10 (C changes)"
     }
    },
    {
     "id": "n3",
     "set": {
      "text": "0 ~ 8 and 2 ~ 10 (A changes)"
     }
    }
   ]
  },
  {
   "caption": "So the four corners are a 2 × 2 block on the torus: one group of 4, drawn as four corner pieces that reach outward through the edges.",
