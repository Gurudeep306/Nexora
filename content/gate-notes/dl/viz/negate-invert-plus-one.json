 "steps": [
  {
   "caption": "Flip every bit of 01011000. The result 10100111 is x̄, and x + x̄ = 11111111 = 2⁸ − 1.",
   "patches": [
    {
     "id": "xb",
     "set": {
      "hidden": false
     }
    },
    {
     "id": "xbl",
     "set": {
      "hidden": false
     }
    },
    {
     "id": "note",
     "set": {
      "text": "x + x̄ = 2⁸ − 1"
     }
    }
   ]
  },
  {
   "caption": "Add 1 to x̄. The three trailing 1s of x̄ turn into 0s as the carry ripples left, and the first 0 it meets becomes 1.",
   "patches": [
