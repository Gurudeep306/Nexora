  },
  {
   "caption": "Glue the halves back, each with the literal that selects it: f = A′·C + A·B, which is f again.",
   "patches": [
    {
     "id": "res",
     "set": {
      "text": "f = A′·f(0,B,C) + A·f(1,B,C) = A′C + AB"
     }
    }
   ]
  },
