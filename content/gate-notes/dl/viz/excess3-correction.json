 "steps": [
  {
   "caption": "Units: 1010 + 1011 = 1 0101. A carry came out, so the digit sum was 10 or more: add 3. 0101 + 0011 = 1000 (excess-3 of 5), decimal carry 1.",
   "patches": [
    {
     "id": "raw",
     "set": {
      "bits": "     0101"
     }
    },
    {
     "id": "res",
     "set": {
      "bits": "     1000"
     }
    },
    {
     "id": "note",
     "set": {
      "text": "carry → +3"
     }
    }
   ]
  },
  {
   "caption": "Tens: 0111 + 0110 + carry 1 = 1110, with no carry out: the digit sum was at most 9, so subtract 3: 1110 − 0011 = 1011 (excess-3 of 8).",
   "patches": [
    {
     "id": "raw",
     "set": {
      "bits": "1110 0101"
     }
    },
    {
     "id": "res",
     "set": {
      "bits": "1011 1000"
     }
    },
    {
     "id": "note",
     "set": {
      "text": "no carry → −3"
     }
    }
   ]
  },
  {
   "caption": "Why: each code carries an excess of 3, so a sum carries an excess of 6. Without a carry, remove 3 to leave a single excess of 3. With a carry, the 16 taken away already over-removed, so put 3 back.",
   "patches": [
    {
     "id": "note",
     "set": {
      "text": "XS3(a) + XS3(b) = a + b + 6"
     }
    }
   ]
  },
  {
   "caption": "Result 1011 1000 is excess-3 of 85 = 47 + 38.",
   "patches": [
    {
     "id": "note",
     "set": {
      "text": "47 + 38 = 85 ✓",
      "tone": "success"
     }
    }
   ]
  }
 ]
