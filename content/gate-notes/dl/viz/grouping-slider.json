 "steps": [
  {
   "caption": "Start at the radix point (here, just right of the last bit) and cut off three bits: 010. Three bits make one octal digit, and 010 is 2.",
   "patches": [
    {
     "id": "o0",
     "set": {
      "hidden": false
     }
    },
    {
     "id": "o0t",
     "set": {
      "hidden": false
     }
    }
   ]
  },
  {
   "caption": "The next three bits to the left, 011, are the octal digit 3.",
   "patches": [
    {
     "id": "o1",
     "set": {
      "hidden": false
     }
    },
    {
     "id": "o1t",
     "set": {
      "hidden": false
     }
    }
   ]
  },
  {
   "caption": "Only one bit, 1, is left. Pad it on the left with two zeros (that adds nothing to the value) to make 001 = 1.",
   "patches": [
    {
     "id": "b0",
     "set": {
      "hidden": false
     }
    },
    {
     "id": "b1",
     "set": {
      "hidden": false
     }
    },
    {
     "id": "o2",
     "set": {
      "hidden": false
     }
    },
    {
     "id": "o2t",
     "set": {
      "hidden": false
     }
    }
   ]
  },
  {
   "caption": "Read the groups left to right: (1011010)₂ = (132)₈. Check: 64 + 24 + 2 = 90.",
   "patches": [
    {
     "id": "ans",
     "set": {
      "hidden": false,
      "label": "(1011010)₂ = (132)₈"
     }
    }
   ]
  },
  {
   "caption": "Now regroup in fours for hexadecimal, again starting at the point: 1010 is A.",
   "patches": [
    {
