 "steps": [
  {
   "caption": "Write each octal digit as exactly three bits: 5 → 101, 4 → 100, 6 → 110. Each digit is replaced on its own; nothing carries between digits.",
   "patches": [
    {
     "id": "c3",
     "set": {
      "hidden": false
     }
    },
    {
     "id": "c4",
     "set": {
      "hidden": false
     }
    },
    {
     "id": "c5",
     "set": {
      "hidden": false
     }
    },
    {
     "id": "c6",
     "set": {
      "hidden": false
     }
    },
    {
     "id": "c7",
     "set": {
      "hidden": false
     }
    },
    {
     "id": "c8",
     "set": {
      "hidden": false
     }
    },
    {
     "id": "c9",
     "set": {
      "hidden": false
     }
    },
    {
     "id": "c10",
     "set": {
      "hidden": false
     }
    },
    {
     "id": "c11",
     "set": {
      "hidden": false
     }
    }
   ]
  },
  {
   "caption": "Now forget the old boundaries. Cut the bit string into fours, starting from the right end (the radix point).",
   "patches": [
    {
     "id": "hb0",
     "set": {
      "hidden": false
     }
    },
    {
     "id": "hb1",
     "set": {
      "hidden": false
     }
    },
    {
     "id": "hb2",
     "set": {
      "hidden": false
     }
    }
   ]
  },
  {
   "caption": "The leftmost group has only one bit, so pad it with three zeros on the left: 0001.",
   "patches": [
    {
     "id": "c0",
     "set": {
      "hidden": false
     }
    },
    {
     "id": "c1",
     "set": {
      "hidden": false
     }
    },
    {
     "id": "c2",
     "set": {
      "hidden": false
     }
    }
   ]
  },
  {
   "caption": "Read each four-bit group as one hex digit: 0001 → 1, 0110 → 6, 0110 → 6.",
   "patches": [
    {
     "id": "hx0",
     "set": {
      "hidden": false
     }
    },
    {
     "id": "hx1",
     "set": {
      "hidden": false
     }
    },
    {
     "id": "hx2",
     "set": {
      "hidden": false
     }
    }
   ]
  },
  {
   "caption": "So (546)₈ = (166)₁₆. Both equal 358: 5·64 + 4·8 + 6 = 358 and 1·256 + 6·16 + 6 = 358.",
   "patches": [
    {
     "id": "note",
     "set": {
      "text": "(546)₈ = (166)₁₆ = 358"
     }
    }
   ]
  }
