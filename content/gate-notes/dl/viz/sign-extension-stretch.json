 "steps": [
  {
   "caption": "−3 in 4 bits is 1101: the sign bit (weight −8) is 1.",
   "patches": [
    {
     "id": "val",
     "set": {
      "text": "1101 = −8 + 4 + 1 = −3"
     }
    }
   ]
  },
  {
   "caption": "To widen to 8 bits, copy the sign bit 1 into the four new places: 1111 1101. The value is still −3 (−128 + 64 + 32 + 16 + 8 + 4 + 1 = −3).",
   "patches": [
    {
     "id": "w8",
     "set": {
      "hidden": false
     }
    },
