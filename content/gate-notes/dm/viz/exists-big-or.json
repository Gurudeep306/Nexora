 "steps": [
  {
   "caption": "An existential claim is the OR of one term per element: ∃x Q(x) = Q(a) ∨ Q(b) ∨ Q(c) ∨ Q(d).",
   "patches": [
    {
     "id": "e0",
     "set": {
      "tone": "accent"
     }
    },
    {
     "id": "e1",
     "set": {
      "tone": "accent"
     }
    },
    {
     "id": "e2",
     "set": {
      "tone": "accent"
     }
    },
    {
     "id": "e3",
     "set": {
      "tone": "accent"
     }
    }
   ]
  },
  {
   "caption": "Check a: Q(a) is false. A false term does not hurt an OR; keep looking.",
   "patches": [
    {
     "id": "e0",
     "set": {
      "tone": "muted"
     }
    },
    {
     "id": "v0",
     "set": {
      "label": "Q(a) = F",
      "tone": "muted"
     }
    }
   ]
  },
  {
   "caption": "Check b: Q(b) is false too. Still no witness.",
   "patches": [
    {
     "id": "e1",
     "set": {
      "tone": "muted"
     }
    },
    {
     "id": "v1",
     "set": {
      "label": "Q(b) = F",
      "tone": "muted"
     }
    }
   ]
  },
  {
   "caption": "Check c: Q(c) is true. c is a witness, and one true term makes the whole OR true.",
   "patches": [
    {
     "id": "e2",
     "set": {
      "tone": "success"
     }
    },
    {
     "id": "v2",
     "set": {
      "label": "Q(c) = T",
      "tone": "success",
      "fill": "success"
     }
    }
   ]
  },
  {
   "caption": "We can stop here: d is never needed. ∃x Q(x) = F ∨ F ∨ T ∨ … = T. To prove an ∃, show one witness.",
   "patches": [
    {
     "id": "disj",
     "set": {
      "text": "F ∨ F ∨ T ∨ … = T",
      "tone": "success"
     }
    },
    {
     "id": "verdict",
     "set": {
      "text": "∃x Q(x) is true (witness c)",
      "tone": "success"
     }
    }
   ]
  },
  {
   "caption": "The two quantifiers are mirror images: ∀ needs no counterexample, ∃ needs one witness.",
   "patches": [
    {
     "id": "verdict",
     "set": {
      "text": "∀: no counterexample. ∃: one witness.",
      "tone": "accent"
     }
    }
   ]
  }
 ]
