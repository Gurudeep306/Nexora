 "steps": [
  {
   "caption": "Start anywhere: d0. The first condition says it has a successor, d0 R d1.",
   "patches": [
    {
     "id": "n0",
     "set": {
      "tone": "accent"
     }
    },
    {
     "id": "n1",
     "set": {
