 "steps": [
  {
   "caption": "Fill the strip: P(x) is 'x² > 5'. It is false for 1 and 2 (1 and 4 are not above 5) and true for 3, 4, 5.",
   "patches": [
    {
     "id": "v0",
     "set": {
      "label": "P = F",
      "tone": "danger"
     }
    },
    {
     "id": "v1",
     "set": {
      "label": "P = F",
      "tone": "danger"
     }
    },
    {
     "id": "v2",
     "set": {
      "label": "P = T",
      "tone": "success"
     }
    },
    {
     "id": "v3",
     "set": {
      "label": "P = T",
      "tone": "success"
     }
    },
    {
     "id": "v4",
     "set": {
      "label": "P = T",
      "tone": "success"
     }
    }
   ]
  },
  {
   "caption": "∀x P(x) is the AND of all five cells. One F cell is enough to sink an AND.",
   "patches": [
    {
     "id": "all",
     "set": {
      "hidden": false,
      "tone": "accent"
     }
    }
   ]
  },
  {
   "caption": "The very first cell, x = 1, is F: a counterexample. So ∀x P(x) is false; the other cells do not matter.",
   "patches": [
    {
     "id": "d0",
     "set": {
      "tone": "danger",
      "fill": "danger"
     }
    },
    {
     "id": "all",
     "set": {
      "label": "∀x P(x) = F: counterexample x = 1",
      "tone": "danger"
     }
    }
   ]
  },
  {
   "caption": "∃x P(x) is the OR of the same cells. One T cell is enough to make an OR true.",
   "patches": [
    {
     "id": "any",
     "set": {
      "hidden": false,
      "tone": "accent"
     }
    }
   ]
  },
  {
   "caption": "x = 3 is the first T cell: a witness. So ∃x P(x) is true.",
   "patches": [
    {
     "id": "d2",
     "set": {
      "tone": "success",
      "fill": "success"
     }
    },
    {
     "id": "any",
     "set": {
      "label": "∃x P(x) = T: witness x = 3",
      "tone": "success"
     }
    }
   ]
  },
  {
   "caption": "The counterexample of ∀ is a witness of ∃¬: x = 1 makes ¬P true. That is De Morgan for quantifiers, ¬∀x P ≡ ∃x ¬P.",
   "patches": [
    {
     "id": "foot",
     "set": {
      "text": "¬∀x P(x) ≡ ∃x ¬P(x): x = 1 is the witness",
      "tone": "accent"
     }
    }
   ]
  }
 ]
