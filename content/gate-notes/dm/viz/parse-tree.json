 "steps": [
  {
   "caption": "Precedence decides the shape: ¬ binds first, then ∧, then ∨, then →, and ↔ is applied last. So ↔ is the root (the main connective): the formula is a biconditional.",
   "patches": [
    {
     "id": "n0",
     "set": {
      "tone": "accent",
      "fill": "accent"
     }
    },
    {
     "id": "foot",
     "set": {
      "text": "main connective: ↔",
      "tone": "accent"
     }
    }
   ]
  },
  {
   "caption": "Evaluate at p = F, q = T, r = F. Start at the leaves: write each variable's value.",
   "patches": [
    {
     "id": "n2",
     "set": {
      "label": "q = T"
     }
    },
    {
     "id": "n4",
     "set": {
      "label": "p = F"
     }
    },
    {
     "id": "n7",
     "set": {
      "label": "q = T"
     }
    },
    {
     "id": "n8",
     "set": {
      "label": "r = F"
     }
    }
   ]
  },
  {
   "caption": "Lowest operators next: ¬p = T, and q ∧ r = T ∧ F = F.",
   "patches": [
    {
     "id": "n5",
     "set": {
      "label": "¬p = T",
      "tone": "success"
     }
    },
    {
     "id": "n6",
     "set": {
      "label": "∧ = F",
      "tone": "danger"
     }
    }
   ]
  },
  {
   "caption": "One level up: ¬p ∨ (q ∧ r) = T ∨ F = T.",
   "patches": [
    {
     "id": "n3",
     "set": {
      "label": "∨ = T",
      "tone": "success"
     }
    }
   ]
  },
  {
   "caption": "The implication has hypothesis T and conclusion p = F: T → F = F, its one false row.",
   "patches": [
    {
     "id": "n1",
     "set": {
      "label": "→ = F",
      "tone": "danger"
     }
    }
   ]
  },
  {
   "caption": "The root compares its two sides: F ↔ T = F, because they disagree. A truth table is this tree evaluated once per row.",
   "patches": [
    {
     "id": "n0",
     "set": {
      "label": "↔ = F",
      "tone": "danger",
      "fill": "danger"
     }
    },
    {
     "id": "foot",
     "set": {
      "text": "value at p = F, q = T, r = F: F",
      "tone": "danger"
     }
    }
   ]
  }
 ]
