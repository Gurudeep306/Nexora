 },
 "intro": "Over a finite domain, ∀ is an AND and ∃ an OR of one instance per element. The two-way laws are regroupings; the one-way laws are where regrouping fails.",
 "elements": [
  {
   "id": "head",
   "type": "text",
   "x": 320.0,
   "y": 24,
   "text": "∀ is a long AND, ∃ is a long OR",
   "anchor": "middle",
   "size": 17,
   "weight": "bold",
   "only": "wide"
  },
  {
   "id": "headn",
   "type": "text",
   "x": 180.0,
   "y": 24,
   "text": "∀ = big AND, ∃ = big OR",
   "anchor": "middle",
   "size": 15,
   "weight": "bold",
   "only": "narrow"
  },
