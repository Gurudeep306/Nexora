 ],
 "steps": [
  {
   "caption": "On the domain {a, b, c}, ∀x(P(x) ∧ Q(x)) is the AND of the P∧Q column: F ∧ T ∧ F.",
   "patches": [
    {
     "id": "t",
     "set": {
      "highlight": [
       [
        1,
        3
       ],
       [
        2,
        3
       ],
       [
        3,
        3
       ]
      ]
     }
    },
    {
     "id": "l1",
     "set": {
      "text": "∀x(P∧Q) = (P∧Q)(a)∧(P∧Q)(b)∧(P∧Q)(c) = F"
     }
    }
   ]
  },
  {
   "caption": "An AND of ANDs regroups: the same six atoms, sorted into the P column and the Q column. So ∀x(P ∧ Q) ≡ ∀x P ∧ ∀x Q.",
   "patches": [
    {
     "id": "t",
     "set": {
      "highlight": [
       [
        1,
        1
       ],
       [
        2,
        1
       ],
       [
        3,
        1
       ],
       [
        1,
        2
       ],
       [
        2,
        2
       ],
       [
        3,
        2
       ]
      ]
     }
    },
    {
     "id": "l2",
     "set": {
      "text": "∀xP ∧ ∀xQ = F ∧ F = F"
     }
    },
    {
     "id": "l3",
     "set": {
      "text": "∀ distributes over ∧ (both ways)",
      "tone": "success"
     }
    }
   ]
  },
  {
   "caption": "Likewise ∃x(P ∨ Q) is the OR of the P∨Q column, and an OR of ORs regroups into ∃x P ∨ ∃x Q.",
   "patches": [
    {
     "id": "t",
     "set": {
      "highlight": [
       [
        1,
        4
       ],
       [
        2,
        4
       ],
       [
        3,
        4
       ]
      ]
     }
    },
    {
     "id": "l1",
     "set": {
      "text": "∃x(P∨Q) = T"
     }
    },
    {
     "id": "l2",
     "set": {
      "text": "∃xP ∨ ∃xQ = T ∨ T = T"
     }
    },
    {
     "id": "l3",
     "set": {
      "text": "∃ distributes over ∨ (both ways)",
      "tone": "success"
     }
    }
   ]
  },
  {
   "caption": "A mixture does not regroup. ∀x(P ∨ Q) is an AND of ORs: the P∨Q column is all T. But neither the P column nor the Q column is all T.",
   "patches": [
    {
     "id": "t",
     "set": {
      "highlight": [
       [
        1,
        4
       ],
       [
        2,
        4
       ],
       [
        3,
        4
       ],
       [
        3,
        1
       ],
       [
        1,
        2
       ]
      ]
     }
    },
    {
     "id": "l1",
     "set": {
      "text": "∀x(P∨Q) = T"
     }
    },
    {
     "id": "l2",
     "set": {
      "text": "∀xP ∨ ∀xQ = F ∨ F = F"
     }
    },
    {
     "id": "l3",
     "set": {
      "text": "∀ over ∨: only ∀P ∨ ∀Q ⇒ ∀(P ∨ Q)",
      "tone": "danger"
     }
    }
   ]
  }
 ]
}
