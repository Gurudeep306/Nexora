       [
        3,
        3
       ]
      ]
     }
    }
   ]
  },
  {
   "caption": "For 'all cats are black' the filter → is right: ∀x(C → B) = F (the white cats are counterexamples) and the dog is ignored.",
   "patches": [
    {
     "id": "r3",
     "set": {
      "hidden": false,
      "label": "∀x(C → B) = F  ✓",
      "tone": "success"
     }
    },
    {
     "id": "foot",
     "set": {
      "text": "∀ goes with →,  ∃ goes with ∧",
