 "steps": [
  {
   "caption": "The world has two cats, neither black, and one black dog. 'Some cats are black' is false here.",
   "patches": [
    {
     "id": "tt",
     "set": {
      "highlight": [
       [
        1,
        1
       ],
       [
        2,
        1
       ],
       [
        3,
        2
       ]
      ]
     }
    }
   ]
  },
  {
   "caption": "Fill the two columns. C ∧ B is T only on a black cat: there is none. C → B is F on each white cat and vacuously T on the dog.",
   "patches": [
    {
     "id": "tt",
     "set": {
      "rows": [
       [
        "x",
        "C",
        "B",
        "C→B",
        "C∧B"
       ],
       [
        "cat 1",
        "T",
        "F",
        "F",
        "F"
       ],
       [
        "cat 2",
        "T",
        "F",
        "F",
        "F"
       ],
       [
        "dog",
        "F",
        "T",
        "T",
        "F"
       ]
      ],
      "highlight": [
       [
        3,
        3
       ]
      ]
     }
    }
   ]
  },
  {
   "caption": "∃x(C ∧ B) is the OR of the C ∧ B column: F. It agrees with the English.",
   "patches": [
    {
     "id": "r1",
     "set": {
      "hidden": false,
      "label": "∃x(C ∧ B) = F  ✓",
      "tone": "success",
      "fill": "success"
     }
    }
   ]
  },
  {
   "caption": "∃x(C → B) is the OR of the C → B column: T, witnessed by the dog, which is not even a cat. It claims something false.",
   "patches": [
    {
     "id": "r2",
     "set": {
      "hidden": false,
      "label": "∃x(C → B) = T  ✗",
      "tone": "danger",
      "fill": "danger"
     }
    },
    {
     "id": "tt",
     "set": {
      "highlight": [
       [
        3,
