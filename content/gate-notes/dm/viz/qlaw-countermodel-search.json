        4
       ]
      ]
     }
    },
    {
     "id": "note",
     "set": {
      "text": "size 1: no counter-model (4 of 4 pass)",
      "tone": "muted"
     }
    }
   ]
  },
  {
   "caption": "Size 2: 16 interpretations of P and Q on {0, 1}. The search tries them in order and the 7th is the first that makes the formula false.",
