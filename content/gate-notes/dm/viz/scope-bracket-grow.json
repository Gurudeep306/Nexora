 "steps": [
  {
   "caption": "The quantifier ∀x stands in front of a bracketed formula. Its scope is everything inside those brackets.",
   "patches": [
    {
     "id": "t0",
     "set": {
      "tone": "accent",
      "fill": "accent"
     }
    }
   ]
  },
  {
   "caption": "The bracket covers P(x) ∧ Q(x,y): every x inside it is bound by ∀x.",
   "patches": [
    {
     "id": "br",
     "set": {
      "hidden": false
     }
    },
    {
     "id": "t1",
     "set": {
      "tone": "success"
     }
    },
    {
     "id": "t2",
     "set": {
      "tone": "success"
     }
    },
    {
     "id": "t3",
     "set": {
      "tone": "success"
     }
    },
    {
     "id": "note",
     "set": {
      "text": "x occurs only inside the scope → bound",
      "tone": "success"
     }
    }
   ]
  },
  {
   "caption": "Outside the brackets we have ∨ R(y). The y in Q(x,y) and in R(y) is not in any quantifier's scope: it is free.",
   "patches": [
    {
     "id": "t4",
     "set": {
      "tone": "warning",
      "fill": "warning"
     }
    },
    {
     "id": "note",
     "set": {
      "text": "y occurs outside every scope → free",
      "tone": "warning"
     }
    }
   ]
  },
  {
   "caption": "So this formula has one bound variable (x) and one free variable (y); it is not yet a sentence. Quantify the y (or fix it) and it becomes a proposition.",
   "patches": [
    {
     "id": "verdict",
     "set": {
      "text": "free variables: {y} — not a sentence yet"
     }
    }
   ]
  }
 ]
