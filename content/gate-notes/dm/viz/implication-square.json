 "steps": [
  {
   "caption": "Start from p → q. Swapping the sides gives the converse q → p; negating both sides gives the inverse ¬p → ¬q.",
   "patches": [
    {
     "id": "orig",
     "set": {
      "tone": "accent",
      "fill": "accent"
     }
    }
   ]
  },
  {
   "caption": "Doing both (swap and negate) gives the contrapositive ¬q → ¬p.",
   "patches": [
    {
     "id": "a3",
     "set": {
      "hidden": false,
      "tone": "accent"
     }
    }
   ]
  },
  {
   "caption": "Test the row p = T, q = F. Original: T → F = F. Contrapositive: ¬q → ¬p = T → F = F. They fail together.",
   "patches": [
    {
     "id": "origt",
     "set": {
      "text": "p=T,q=F: F",
      "tone": "danger"
     }
    },
    {
     "id": "contrat",
     "set": {
      "text": "p=T,q=F: F",
      "tone": "danger"
     }
    },
    {
     "id": "contra",
     "set": {
      "tone": "success",
      "fill": "success"
     }
    },
    {
     "id": "orig",
     "set": {
      "tone": "success",
      "fill": "success"
     }
    }
   ]
  },
  {
   "caption": "On the same row the converse is F → T = T and the inverse is F → T = T: they differ from the original, so they are not equivalent to it.",
   "patches": [
    {
     "id": "convt",
     "set": {
      "text": "p=T,q=F: T",
      "tone": "warning"
     }
    },
    {
     "id": "invt",
     "set": {
      "text": "p=T,q=F: T",
      "tone": "warning"
     }
    },
    {
     "id": "conv",
     "set": {
      "tone": "warning",
      "fill": "warning"
     }
    },
    {
     "id": "inv",
     "set": {
      "tone": "warning",
      "fill": "warning"
     }
    }
   ]
  },
  {
   "caption": "The diagonals pair up: original ≡ contrapositive, and converse ≡ inverse (each is the other's contrapositive).",
   "patches": [
    {
     "id": "foot",
     "set": {
      "text": "p → q ≡ ¬q → ¬p    and    q → p ≡ ¬p → ¬q",
      "tone": "accent"
     }
    }
   ]
  }
 ]
