 "steps": [
  {
   "caption": "Find the false rows of the new operator. There is only one: A = F, B = T.",
   "patches": [
    {
     "id": "tt",
     "set": {
      "highlight": [
       [
        3,
        0
       ],
       [
        3,
        1
